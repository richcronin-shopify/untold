{% doc %}
  Outputs the URL of the placeholder image used for parks with no photos,
  or when a park photo fails to load.
  Order: the theme setting "Skatepark placeholder image", then an image
  passed in from a section, then park-placeholder.jpg from Shopify Files,
  then park-coming-soon.jpg, then the fallback URL text setting, then a
  built-in Files URL.

  @param {image} [image] - Placeholder image picked in a section setting
  @param {string} [url] - Fallback placeholder URL
  @param {number} [width] - Width to request when the image comes from Shopify (default 1600)

  @example
  {%- capture placeholder_url -%}{% render 'skatepark-placeholder-url', image: section.settings.placeholder_image, url: section.settings.placeholder_url, width: 1280 %}{%- endcapture -%}
{% enddoc %}
{%- liquid
  assign sp_ph_width = width | default: 1600
  assign sp_ph = settings.skatepark_placeholder_image
  if sp_ph == blank
    assign sp_ph = image
  endif
  if sp_ph == blank
    assign sp_ph = images['park-placeholder.jpg']
  endif
  if sp_ph == blank
    assign sp_ph = images['park-coming-soon.jpg']
  endif

  if sp_ph != blank
    assign sp_ph_url = sp_ph | image_url: width: sp_ph_width
  else
    assign sp_ph_url = url | strip | default: 'https://cdn.shopify.com/s/files/1/0052/6873/4040/files/park-placeholder.jpg?v=1793898245'
  endif

  assign sp_ph_start = sp_ph_url | slice: 0, 2
  if sp_ph_start == '//'
    assign sp_ph_url = 'https:' | append: sp_ph_url
  endif

  echo sp_ph_url
-%}
