<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

{%- liquid
  comment
    Skatepark metaobject pages: build the SEO title and description from the park's data.
    The description falls back to a generated summary if the park description is empty or
    contains words that must not appear in SEO text.
  endcomment
  assign seo_title = page_title
  assign seo_description = page_description
  assign sp_image = blank

  if request.page_type == 'metaobject' and metaobject.system.type == 'skatepark'
    assign sp_name = metaobject.name.value
    assign sp_town = metaobject.town_city.value
    assign sp_county = metaobject.county_district.value
    assign sp_name_down = sp_name | downcase
    assign sp_town_down = sp_town | downcase

    assign seo_title = sp_name
    if sp_town != blank
      unless sp_name_down contains sp_town_down
        assign seo_title = seo_title | append: ', ' | append: sp_town
      endunless
    endif
    assign sp_kind = 'Skatepark guide'
    if metaobject.park_type.value == 'Pump Track'
      assign sp_kind = 'Pump track guide'
    elsif metaobject.park_type.value == 'BMX Track / Dirt Jumps'
      assign sp_kind = 'BMX track guide'
    endif
    assign seo_title = seo_title | append: ' – ' | append: sp_kind

    assign sp_desc = metaobject.description.value | strip_newlines | strip
    assign sp_check = sp_desc | downcase
    assign sp_desc_ok = true
    if sp_desc == blank
      assign sp_desc_ok = false
    endif
    assign sp_banned = 'deliver|price|£|in stock|out of stock| best |best.|cheapest|shipping|postage' | split: '|'
    for sp_word in sp_banned
      if sp_check contains sp_word
        assign sp_desc_ok = false
      endif
    endfor

    if sp_desc_ok
      assign seo_description = sp_desc | truncate: 158
    else
      assign sp_type = metaobject.park_type.value | default: 'Skatepark' | downcase | replace: 'bmx', 'BMX'
      assign sp_setting = metaobject.setting.value | downcase
      assign seo_description = sp_name | append: ' is '
      if sp_setting contains 'covered'
        assign sp_setting = 'covered'
      endif
      if sp_setting != blank
        assign sp_phrase = sp_setting | append: ' ' | append: sp_type
      else
        assign sp_phrase = sp_type
      endif
      assign sp_first = sp_phrase | slice: 0
      if 'aeiou' contains sp_first
        assign seo_description = seo_description | append: 'an ' | append: sp_phrase
      else
        assign seo_description = seo_description | append: 'a ' | append: sp_phrase
      endif
      if sp_town != blank
        assign seo_description = seo_description | append: ' in ' | append: sp_town
        if sp_county != blank and sp_county != sp_town
          assign seo_description = seo_description | append: ', ' | append: sp_county
        endif
      endif
      assign seo_description = seo_description | append: '. Features, facilities, map, directions and key facts for BMX riders.'
    endif

    assign og_title = seo_title
    assign og_description = seo_description
    comment
      Social image: first real park photo; satellite tiles are not used, so parks without a
      photo get the "photo coming soon" placeholder.
    endcomment
    assign sp_image = metaobject.thumbnail_image_url.value | first
    if sp_image contains 'google.com/vt/'
      assign sp_image = blank
    endif
    if sp_image == blank
      capture sp_image
        render 'skatepark-placeholder-url', width: 1200
      endcapture
      assign sp_image = sp_image | strip
    endif
  endif

  comment
    Park event metaobject pages: "Event title – Park, Sat 14 Nov 2026". Events that are not
    Approved or Cancelled (e.g. Pending) are marked noindex. The description never uses the
    price note.
  endcomment
  assign pe_noindex = false
  if request.page_type == 'metaobject' and metaobject.system.type == 'park_event'
    assign pe_park = metaobject.park.value
    assign pe_status = metaobject.status.value
    if pe_status != 'Approved' and pe_status != 'Cancelled'
      assign pe_noindex = true
      assign seo_title = 'Event not available'
      assign seo_description = 'This event is not listed at the moment.'
    else
      assign pe_date = metaobject.start.value | date: '%a %-d %b %Y'
      assign seo_title = metaobject.title.value
      if pe_park != blank
        assign seo_title = seo_title | append: ' – ' | append: pe_park.name.value
      endif
      assign seo_title = seo_title | append: ', ' | append: pe_date
      if pe_status == 'Cancelled'
        assign seo_title = seo_title | append: ' (cancelled)'
      endif

      assign pe_desc = metaobject.description.value | strip_newlines | strip
      assign pe_check = pe_desc | downcase
      assign pe_desc_ok = true
      if pe_desc == blank
        assign pe_desc_ok = false
      endif
      assign pe_banned = 'deliver|price|£|in stock|out of stock| best |best.|cheapest|shipping|postage' | split: '|'
      for pe_word in pe_banned
        if pe_check contains pe_word
          assign pe_desc_ok = false
        endif
      endfor
      if pe_desc_ok
        assign seo_description = pe_desc | truncate: 158
      else
        assign pe_type = metaobject.event_type.value | default: 'Event' | downcase
        assign seo_description = metaobject.title.value | append: ': a BMX ' | append: pe_type | append: ' on ' | append: pe_date
        if pe_park != blank
          assign seo_description = seo_description | append: ' at ' | append: pe_park.name.value
          if pe_park.town_city.value != blank
            assign seo_description = seo_description | append: ', ' | append: pe_park.town_city.value
          endif
        endif
        assign seo_description = seo_description | append: '. Times, location and how to add it to your calendar.'
      endif
    endif
    assign og_title = seo_title
    assign og_description = seo_description
    if pe_park != blank
      assign sp_image = pe_park.thumbnail_image_url.value | first
      if sp_image contains 'google.com/vt/'
        assign sp_image = blank
      endif
    endif
    if sp_image == blank
      capture sp_image
        render 'skatepark-placeholder-url', width: 1200
      endcapture
      assign sp_image = sp_image | strip
    endif
  endif
-%}
{%- if pe_noindex -%}
  <meta name="robots" content="noindex, nofollow">
{%- endif -%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if sp_image != blank -%}
  <meta
    property="og:image"
    content="{{ sp_image | escape }}"
  >
{%- elsif page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ seo_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless seo_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if seo_description %}
  <meta
    name="description"
    content="{{ seo_description | escape }}"
  >
{% endif %}
