<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

{%- liquid
  comment
    Skatepark metaobject pages: build the SEO title and description from the park's data.
    The description falls back to a generated summary if the park description is empty or
    contains words that must not appear in SEO text.
  endcomment
  assign seo_title = page_title
  assign seo_description = page_description
  assign sp_image = blank
  assign sp_skip_brand = false

  if request.page_type == 'metaobject' and metaobject.system.type == 'skatepark'
    comment
      Park titles: {Name}, {Town} | {Type}, photos & map, with shorter
      fallbacks so the title stays at or under 60 characters. The brand
      is not added. Parks without a real photo say "map & features"
      rather than "Photos". Meta descriptions stay at or under 155
      characters and never mention opening hours or fees.
    endcomment
    assign sp_skip_brand = true
    assign sp_name = metaobject.name.value | strip
    assign sp_town = metaobject.town_city.value
    assign sp_county = metaobject.county_district.value
    if sp_town contains '('
      assign sp_town = sp_town | split: '(' | first | strip
    endif
    assign sp_name_down = sp_name | downcase
    assign sp_town_down = sp_town | downcase

    assign sp_place = sp_name
    if sp_town != blank
      unless sp_name_down contains sp_town_down
        assign sp_place = sp_name | append: ', ' | append: sp_town
      endunless
    endif

    assign sp_kind = 'Skatepark'
    case metaobject.park_type.value
      when 'Pump Track'
        assign sp_kind = 'Pump track'
      when 'BMX Track / Dirt Jumps'
        assign sp_kind = 'BMX track'
      when 'Mini Ramp'
        assign sp_kind = 'Mini ramp'
      when 'Skatepark & Pump / BMX Track'
        assign sp_kind = 'Skatepark & pump track'
      when 'Bowl / Pool'
        assign sp_kind = 'Skate bowl'
      when 'Multi-Sport Action Park'
        assign sp_kind = 'Action sports park'
      when 'Street Plaza'
        assign sp_kind = 'Street plaza'
    endcase
    if metaobject.setting.value == 'Indoor'
      if sp_kind == 'Action sports park' or sp_kind == 'Skatepark' or sp_kind == 'Street plaza' or sp_kind == 'Skate bowl'
        assign sp_kind = 'Indoor skatepark'
      else
        assign sp_kind_l = sp_kind | downcase
        assign sp_kind = 'Indoor ' | append: sp_kind_l
      endif
    endif

    assign sp_kind_l = sp_kind | downcase
    assign sp_kl = sp_kind_l
    if sp_kind_l contains 'indoor '
      assign sp_kl = 'indoor'
    endif
    assign sp_dup = false
    if sp_name_down contains sp_kl
      assign sp_dup = true
    endif
    if sp_kl == 'skatepark'
      if sp_name_down contains 'skate park'
        assign sp_dup = true
      endif
    endif

    assign sp_has_photo = false
    assign uploaded_first = metaobject.gallery_images.value | first
    if uploaded_first != blank
      assign sp_has_photo = true
    endif
    assign sp_thumb0 = metaobject.thumbnail_image_url.value | first
    if sp_has_photo == false and sp_thumb0 != blank
      unless sp_thumb0 contains 'google.com/vt/'
        assign sp_has_photo = true
      endunless
    endif
    if sp_has_photo
      assign sp_tail = 'photos & map'
      assign sp_tail_cap = 'Photos & map'
    else
      assign sp_tail = 'map & features'
      assign sp_tail_cap = 'Map & features'
    endif

    if metaobject.setting.value == 'Indoor'
      assign sp_short = 'Indoor park'
    else
      assign sp_short = sp_kind
    endif

    assign seo_title = sp_name
    if sp_dup
      assign sp_c1 = sp_place | append: ' | ' | append: sp_tail_cap
      assign sp_c2 = sp_place | append: ' | Map'
      assign sp_c3 = sp_name | append: ' | Map'
      assign sp_c4 = sp_name | append: ' | ' | append: sp_short
      if sp_c1.size <= 60
        assign seo_title = sp_c1
      elsif sp_c2.size <= 60
        assign seo_title = sp_c2
      elsif sp_c3.size <= 60
        assign seo_title = sp_c3
      elsif sp_c4.size <= 60
        assign seo_title = sp_c4
      endif
    else
      assign sp_c1 = sp_place | append: ' | ' | append: sp_kind | append: ', ' | append: sp_tail
      assign sp_c2 = sp_place | append: ' | ' | append: sp_kind | append: ' & map'
      assign sp_c3 = sp_place | append: ' | ' | append: sp_kind
      assign sp_c4 = sp_name | append: ' | ' | append: sp_kind
      assign sp_c5 = sp_name | append: ' | ' | append: sp_short
      if sp_c1.size <= 60
        assign seo_title = sp_c1
      elsif sp_c2.size <= 60
        assign seo_title = sp_c2
      elsif sp_c3.size <= 60
        assign seo_title = sp_c3
      elsif sp_c4.size <= 60
        assign seo_title = sp_c4
      elsif sp_c5.size <= 60
        assign seo_title = sp_c5
      endif
    endif

    assign sp_kind_meta = sp_kind | downcase | replace: 'bmx', 'BMX'
    assign sp_adj = ''
    unless sp_kind_meta contains 'indoor'
      if metaobject.setting.value contains 'Covered'
        assign sp_adj = 'Covered '
      else
        assign sp_adj = 'Outdoor '
      endif
    endunless
    if sp_adj != blank
      assign sp_head = sp_adj | append: sp_kind_meta
    else
      assign sp_k0 = sp_kind_meta | slice: 0 | upcase
      assign sp_krest = sp_kind_meta | slice: 1, 80
      assign sp_head = sp_k0 | append: sp_krest
    endif
    assign sp_loc = ''
    if sp_town != blank
      assign sp_loc = sp_town
      if sp_county != blank and sp_county != sp_town
        assign sp_loc = sp_loc | append: ', ' | append: sp_county
      endif
    elsif sp_county != blank
      assign sp_loc = sp_county
    endif
    if sp_loc != blank
      assign sp_head = sp_head | append: ' in ' | append: sp_loc
    endif

    assign sp_lit = ''
    if metaobject.floodlit.value == 'Yes'
      assign sp_lit = ' Floodlit.'
    endif
    if sp_has_photo
      assign sp_end = ' Photos, map, directions and park details for BMX riders.'
    else
      assign sp_end = ' Map, directions and park details for BMX riders.'
    endif

    assign sp_kind_cmp = sp_kind | downcase | replace: 'indoor ', ''
    assign sp_feat_csv = ''
    assign sp_feat_n = 0
    if metaobject.features.value != blank
      assign sp_raw_feats = metaobject.features.value | split: ','
      for sp_raw in sp_raw_feats
        assign sp_f = sp_raw | strip
        if sp_f == blank
          continue
        endif
        case sp_f
          when 'Volcano / Pyramid'
            assign sp_f = 'pyramid'
          when 'Cradle / Oververt'
            assign sp_f = 'cradle'
          when 'BMX Race / Jump Track'
            assign sp_f = 'jump track'
          when 'Start Gate / Hill'
            assign sp_f = 'start hill'
          when 'Street Section'
            assign sp_f = 'street section'
          when 'Foam Pit'
            assign sp_f = 'foam pit'
          when 'Resi Ramp'
            assign sp_f = 'resi ramp'
          when 'Pool Coping'
            assign sp_f = 'pool coping'
          when 'Pump Track'
            assign sp_f = 'pump track'
          else
            assign sp_f = sp_f | downcase | replace: 'bmx', 'BMX'
        endcase
        if sp_f == sp_kind_cmp
          continue
        endif
        if sp_feat_csv == blank
          assign sp_feat_csv = sp_f
        else
          assign sp_feat_csv = sp_feat_csv | append: '||' | append: sp_f
        endif
        assign sp_feat_n = sp_feat_n | plus: 1
      endfor
    endif

    assign seo_description = sp_head | append: '.' | append: sp_lit | append: sp_end
    assign sp_ns = '4,3,2,1,0' | split: ','
    for sp_n_s in sp_ns
      assign sp_n = sp_n_s | times: 1
      assign sp_use = ''
      assign sp_use_n = 0
      if sp_feat_n > 0 and sp_n > 0
        assign sp_feats = sp_feat_csv | split: '||'
        for sp_f in sp_feats
          if sp_use_n < sp_n
            if sp_use == blank
              assign sp_use = sp_f
            else
              assign sp_use = sp_use | append: '||' | append: sp_f
            endif
            assign sp_use_n = sp_use_n | plus: 1
          endif
        endfor
      endif
      assign sp_feat_str = ''
      if sp_use_n > 0
        assign sp_use_arr = sp_use | split: '||'
        assign sp_f0 = sp_use_arr | first
        assign sp_f0_last = sp_f0 | slice: -1
        unless sp_f0_last == 's'
          assign sp_f0_ch = sp_f0 | downcase | slice: 0
          if 'aeiou' contains sp_f0_ch
            assign sp_f0 = 'an ' | append: sp_f0
          else
            assign sp_f0 = 'a ' | append: sp_f0
          endif
        endunless
        if sp_use_n == 1
          assign sp_feat_str = sp_f0
        elsif sp_use_n == 2
          assign sp_f1 = sp_use_arr | last
          assign sp_feat_str = sp_f0 | append: ' and ' | append: sp_f1
        else
          assign sp_feat_str = sp_f0
          assign sp_last_i = sp_use_n | minus: 1
          assign sp_j = 0
          for sp_fj in sp_use_arr
            if sp_j > 0
              if sp_j == sp_last_i
                assign sp_feat_str = sp_feat_str | append: ' and ' | append: sp_fj
              else
                assign sp_feat_str = sp_feat_str | append: ', ' | append: sp_fj
              endif
            endif
            assign sp_j = sp_j | plus: 1
          endfor
        endif
      endif
      if sp_feat_str != blank
        assign sp_try = sp_head | append: ' with ' | append: sp_feat_str | append: '.' | append: sp_lit | append: sp_end
      else
        assign sp_try = sp_head | append: '.' | append: sp_lit | append: sp_end
      endif
      if sp_try.size <= 155
        assign seo_description = sp_try
        break
      endif
    endfor

    assign og_title = seo_title
    assign og_description = seo_description
    comment
      Social image: first real park photo; satellite tiles are not used, so parks without a
      photo get the "photo coming soon" placeholder.
    endcomment
    if uploaded_first != blank
      assign sp_image = uploaded_first | image_url: width: 1200
      if sp_image != blank
        unless sp_image contains '://'
          assign sp_image = sp_image | prepend: 'https:'
        endunless
      endif
    else
      assign sp_image = metaobject.thumbnail_image_url.value | first
      if sp_image contains 'google.com/vt/'
        assign sp_image = blank
      endif
    endif
    if sp_image == blank
      capture sp_image
        render 'skatepark-placeholder-url', width: 1200
      endcapture
      assign sp_image = sp_image | strip
    endif
  endif

  comment
    Park event metaobject pages: "Event title – Park, Sat 14 Nov 2026". Events that are not
    Approved or Cancelled (e.g. Pending) are marked noindex. The description never uses the
    price note.
  endcomment
  assign pe_noindex = false
  if request.page_type == 'metaobject' and metaobject.system.type == 'park_event'
    assign pe_park = metaobject.park.value
    assign pe_status = metaobject.status.value
    if pe_status != 'Approved' and pe_status != 'Cancelled'
      assign pe_noindex = true
      assign seo_title = 'Event not available'
      assign seo_description = 'This event is not listed at the moment.'
    else
      assign pe_date = metaobject.start.value | date: '%a %-d %b %Y'
      assign seo_title = metaobject.title.value
      if pe_park != blank
        assign seo_title = seo_title | append: ' – ' | append: pe_park.name.value
      endif
      assign seo_title = seo_title | append: ', ' | append: pe_date
      if pe_status == 'Cancelled'
        assign seo_title = seo_title | append: ' (cancelled)'
      endif

      assign pe_desc = metaobject.description.value | strip_newlines | strip
      assign pe_check = pe_desc | downcase
      assign pe_desc_ok = true
      if pe_desc == blank
        assign pe_desc_ok = false
      endif
      assign pe_banned = 'deliver|price|£|in stock|out of stock| best |best.|cheapest|shipping|postage' | split: '|'
      for pe_word in pe_banned
        if pe_check contains pe_word
          assign pe_desc_ok = false
        endif
      endfor
      if pe_desc_ok
        assign seo_description = pe_desc | truncate: 158
      else
        assign pe_type = metaobject.event_type.value | default: 'Event' | downcase
        assign seo_description = metaobject.title.value | append: ': a BMX ' | append: pe_type | append: ' on ' | append: pe_date
        if pe_park != blank
          assign seo_description = seo_description | append: ' at ' | append: pe_park.name.value
          if pe_park.town_city.value != blank
            assign seo_description = seo_description | append: ', ' | append: pe_park.town_city.value
          endif
        endif
        assign seo_description = seo_description | append: '. Times, location and how to add it to your calendar.'
      endif
    endif
    assign og_title = seo_title
    assign og_description = seo_description
    if pe_park != blank
      assign pe_uploaded = pe_park.gallery_images.value | first
      if pe_uploaded != blank
        assign sp_image = pe_uploaded | image_url: width: 1200
        if sp_image != blank
          unless sp_image contains '://'
            assign sp_image = sp_image | prepend: 'https:'
          endunless
        endif
      else
        assign sp_image = pe_park.thumbnail_image_url.value | first
        if sp_image contains 'google.com/vt/'
          assign sp_image = blank
        endif
      endif
    endif
    if sp_image == blank
      capture sp_image
        render 'skatepark-placeholder-url', width: 1200
      endcapture
      assign sp_image = sp_image | strip
    endif
  endif

  comment
    Finder page: set a tighter title, and a self-canonical plus rel=prev when a
    pagination param is present. Page 1 stays on the clean URL. The page param
    name is read from the request URL in content_for_header because Shopify's
    canonical_url strips the custom paginate parameter (page_xxxx).
  endcomment
  assign finder_page_param = blank
  assign finder_page_num = 1
  assign seo_canonical = canonical_url
  if request.page_type == 'page' and page.handle == 'skateparks-finder-uk'
    if shopify_pageurl != blank and shopify_pageurl contains '?'
      assign query_string = shopify_pageurl | split: '?' | last
      assign query_parts = query_string | split: '&'
      for part in query_parts
        assign q_key = part | split: '=' | first
        assign q_val = part | split: '=' | last
        if q_key == 'page' or q_key contains 'page_'
          if q_val != blank
            assign finder_page_param = q_key
            assign finder_page_num = q_val | times: 1
          endif
        endif
      endfor
    endif
    if finder_page_num <= 1 and request.params.page_1567ba11 != blank
      assign finder_page_param = 'page_1567ba11'
      assign finder_page_num = request.params.page_1567ba11 | times: 1
    endif
    if finder_page_num <= 1 and request.params.page != blank
      assign finder_page_param = 'page'
      assign finder_page_num = request.params.page | times: 1
    endif
    if finder_page_num < 1
      assign finder_page_num = 1
    endif
    if finder_page_num > 1
      assign seo_title = 'UK Skatepark Finder – Page ' | append: finder_page_num | append: ' | ' | append: shop.name
    else
      assign seo_title = 'UK Skatepark Finder – 2,000+ Parks & Tracks | ' | append: shop.name
    endif
    assign og_title = seo_title
    if finder_page_num > 1 and finder_page_param != blank
      assign seo_canonical = canonical_url | append: '?' | append: finder_page_param | append: '=' | append: finder_page_num
    endif
    assign og_url = seo_canonical
  endif
-%}
{%- if pe_noindex -%}
  <meta name="robots" content="noindex, nofollow">
{%- endif -%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if sp_image != blank -%}
  <meta
    property="og:image"
    content="{{ sp_image | escape }}"
  >
{%- elsif page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {%- render 'product-structured-data', product: product -%}

  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ seo_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless sp_skip_brand -%}
    {%- unless seo_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  {%- endunless -%}
</title>

<link
  rel="canonical"
  href="{{ seo_canonical }}"
>
{%- if request.page_type == 'page' and page.handle == 'skateparks-finder-uk' and finder_page_num > 1 and finder_page_param != blank -%}
  {%- if finder_page_num == 2 -%}
    <link rel="prev" href="{{ canonical_url }}">
  {%- else -%}
    {%- assign finder_prev_num = finder_page_num | minus: 1 -%}
    <link rel="prev" href="{{ canonical_url }}?{{ finder_page_param }}={{ finder_prev_num }}">
  {%- endif -%}
{%- endif -%}

{% if seo_description %}
  <meta
    name="description"
    content="{{ seo_description | escape }}"
  >
{% endif %}
