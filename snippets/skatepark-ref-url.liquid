{%- comment -%} Adds ref=untoldbmx to an external URL, keeping any #fragment. {%- endcomment -%}
{%- liquid
  assign parts = url | split: '#'
  assign base = parts | first
  assign frag = ''
  if parts.size > 1
    assign frag = url | remove_first: base
  endif
  if base contains 'ref=untoldbmx'
    assign out = url
  else
    if base contains '?'
      assign out = base | append: '&ref=untoldbmx' | append: frag
    else
      assign out = base | append: '?ref=untoldbmx' | append: frag
    endif
  endif
-%}{{ out | escape }}