{%- comment -%}
	--------------------------------------------------------
	Structured Data
	--------------------------------------------------------
{%- endcomment -%}


{%- comment -%}
	Global organisation schema
{%- endcomment -%}

<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "Organization",
	"name": {{ shop.name | json }},
	"url": {{ shop.url | json }}
}
</script>


{%- comment -%}
	Global website schema
{%- endcomment -%}

<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": {{ shop.name | json }},
	"url": {{ shop.url | json }}
}
</script>


{%- comment -%}
	Page-specific schema
{%- endcomment -%}

{%- case request.page_type -%}


	{%- when 'product' -%}

		{%- assign current_variant = product.selected_or_first_available_variant -%}

		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "Product",
			"name": {{ product.title | json }},
			"url": {{ canonical_url | json }},
			"description": {{ product.description | strip_html | strip | json }},
			"sku": {{ current_variant.sku | json }},
			"brand": {
				"@type": "Brand",
				"name": {{ product.vendor | json }}
			}
			{%- if product.featured_image -%},
			"image": [
				{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}
			]
			{%- endif -%},
			"offers": {
				"@type": "Offer",
				"url": {{ canonical_url | json }},
				"priceCurrency": {{ cart.currency.iso_code | json }},
				"price": {{ current_variant.price | divided_by: 100.0 | json }},
				"availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
				"itemCondition": "https://schema.org/NewCondition"
			}
		}
		</script>


	{%- when 'collection' -%}

		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "CollectionPage",
			"name": {{ collection.title | json }},
			"url": {{ canonical_url | json }}
			{%- if collection.description != blank -%},
			"description": {{ collection.description | strip_html | strip | json }}
			{%- endif -%}
		}
		</script>


	{%- when 'article' -%}

		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			"headline": {{ article.title | json }},
			"url": {{ canonical_url | json }},
			"datePublished": {{ article.published_at | date: "%Y-%m-%dT%H:%M:%S%z" | json }},
			"dateModified": {{ article.updated_at | date: "%Y-%m-%dT%H:%M:%S%z" | json }},
			"author": {
				"@type": "Person",
				"name": {{ article.author | json }}
			},
			"publisher": {
				"@type": "Organization",
				"name": {{ shop.name | json }}
			}
			{%- if article.image -%},
			"image": [
				{{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}
			]
			{%- endif -%}
		}
		</script>


{%- endcase -%}