{%- liquid
	assign card_product = product
	assign card_index = card_index | default: 0

	assign primary_image = card_product.featured_image
	assign secondary_image = card_product.images[1]

	assign show_secondary_image = false

	if settings.product_card_second_image and secondary_image != blank
		assign show_secondary_image = true
	endif

	comment
		Use the same automatic-sale calculation as the PDP.
		Shopify rounds the discount amount down to whole pennies.
		The metafield is a display setting; the cart still applies the real discount.
	endcomment
	assign automatic_sale_percent = card_product.metafields.custom.automatic_sale_percent.value | default: 0 | plus: 0
	assign card_original_price = card_product.price_min
	assign card_display_price = card_original_price
	assign card_compare_price = 0
	assign has_automatic_sale = false
	assign on_sale = false

	if automatic_sale_percent > 0 and automatic_sale_percent <= 100
		assign sale_discount = card_original_price | times: automatic_sale_percent | divided_by: 100.0 | floor
		assign card_display_price = card_original_price | minus: sale_discount

		if card_display_price < card_original_price
			assign has_automatic_sale = true
			assign on_sale = true
			assign card_compare_price = card_original_price
		endif
	endif

	if has_automatic_sale == false and card_product.compare_at_price_max > card_original_price
		assign on_sale = true
		assign card_compare_price = card_product.compare_at_price_max
	endif

	assign card_saving = 0
	if on_sale and card_compare_price > card_display_price
		assign card_saving = card_compare_price | minus: card_display_price
	endif

	assign primary_image_loading = 'lazy'
	assign primary_image_fetchpriority = 'auto'

	if card_index == 1
		assign primary_image_loading = 'eager'
		assign primary_image_fetchpriority = 'high'
	endif

	assign vendor = card_product.vendor
	for tag in card_product.tags
		if tag contains 'vendor:'
			assign vendor = tag | remove: 'vendor:'
		endif
	endfor
-%}

<a
	href="{{ card_product.url }}"
	class="product-card {% unless card_product.available %}product-card--sold-out{% endunless %} {% if on_sale %}product-card--sale{% endif %}"
	aria-label="{{ card_product.title | escape }}"
>

	<div class="product-card__media">

		{%- if primary_image != blank -%}

			<div class="product-card__images">

				{{-
					primary_image
						| image_url: width: 800
						| image_tag:
							class: 'product-card__image product-card__image--primary',
							loading: primary_image_loading,
							fetchpriority: primary_image_fetchpriority,
							width: 800,
							height: 800,
							widths: '300, 400, 500, 600, 800',
							sizes: '(min-width: 990px) 25vw, 50vw',
							alt: primary_image.alt | default: product.title | escape
				-}}

				{%- if show_secondary_image -%}

					{{-
						secondary_image
							| image_url: width: 800
							| image_tag:
								class: 'product-card__image product-card__image--secondary',
								loading: 'lazy',
								fetchpriority: 'low',
								width: 800,
								height: 800,
								widths: '300, 400, 500, 600, 800',
								sizes: '(min-width: 990px) 25vw, 50vw',
								alt: secondary_image.alt | default: product.title | escape
					-}}

				{%- endif -%}

			</div>

		{%- else -%}

			<div class="product-card__placeholder">
				{{-
					settings.fallback_img_sub_collection_image
						| image_url: width: 800
						| image_tag:
							class: 'product-card__image product-card__image--primary',
							loading: primary_image_loading,
							fetchpriority: primary_image_fetchpriority,
							width: 800,
							height: 800,
							widths: '300, 400, 500, 600, 800',
							sizes: '(min-width: 990px) 25vw, 50vw',
							alt: settings.fallback_img_sub_collection_image.alt
				-}}
			</div>

		{%- endif -%}

	</div>

	<div class="product-card__content">

		{%- if settings.product_card_show_vendor and vendor != blank -%}

			<div class="product-card__vendor">
				{{- vendor -}}
			</div>

		{%- endif -%}

		<h3 class="product-card__title">
			{{- card_product.title -}}
		</h3>

		<div class="product-card__price">

			<span class="product-card__price-current">
				{%- if card_product.price_varies -%}From {% endif -%}
				{{ card_display_price | money }}
			</span>

			{%- if on_sale -%}

				<span class="product-card__price-compare">
					<span class="visually-hidden">
						Regular price
					</span>

					Was <span class="product-card__price-compare-sale">{{ card_compare_price | money }}</span>
				</span>

			{%- endif -%}

			{%- if card_saving > 0 -%}
				<span class="product-card__saving">
					Save {{ card_saving | money_without_trailing_zeros }}
				</span>
			{%- endif -%}

		</div>

		{%- if settings.product_card_show_availability -%}

			<div
				class="
					product-card__availability
					{% if card_product.available %}
						product-card__availability--available
					{% else %}
						product-card__availability--sold-out
					{% endif %}
				"
			>

				<div class="product-card__availability-inner">

					<span
						class="product-card__availability-dot"
						aria-hidden="true"
					></span>

					<span>
						{%- if card_product.available -%}
							In Stock
						{%- else -%}
							Sold Out
						{%- endif -%}
					</span>

				</div>

			</div>

		{%- endif -%}

	</div>

</a>