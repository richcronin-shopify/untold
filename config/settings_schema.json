[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https:\/\/help.shopify.com\/manual\/online-store\/themes",
    "theme_support_url": "https:\/\/support.shopify.com\/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },

  {
	  "name": "Search",
	  "settings": [
	    {
	      "type": "checkbox",
	      "id": "enable_search",
	      "default": true,
	      "label": "Enable search"
	    },
	    {
	      "type": "text",
	      "id": "search_title",
	      "default": "Search",
	      "label": "Title"
	    },
	    {
	      "type": "text",
	      "id": "search_placeholder",
	      "default": "What are you looking for?",
	      "label": "Search placeholder"
	    },
	    {
	      "type": "text",
	      "id": "search_trending",
	      "default": "Frames, S&M, Front Wheels, Grips, Tyres",
	      "label": "Trending searches",
	      "info": "Separate searches with commas."
	    },
	    {
	      "type": "collection",
	      "id": "search_popular_collection",
	      "label": "Popular products collection"
	    },
	    {
	      "type": "checkbox",
	      "id": "search_show_collections",
	      "default": true,
	      "label": "Show collection results"
	    },
	    {
	      "type": "checkbox",
	      "id": "search_show_pages",
	      "default": true,
	      "label": "Show page results"
	    }
	  ]
	},

	{
	  "name": "Product cards",
	  "settings": [
	    {
	      "type": "checkbox",
	      "id": "product_card_second_image",
	      "default": true,
	      "label": "Show second image on hover"
	    },
	    {
	      "type": "checkbox",
	      "id": "product_card_show_vendor",
	      "default": true,
	      "label": "Show vendor"
	    },
	    {
	      "type": "checkbox",
	      "id": "product_card_show_availability",
	      "default": true,
	      "label": "Show availability"
	    }
	  ]
	}

]