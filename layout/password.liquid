<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#050505">

  <title>Untold BMX — Coming Soon</title>
  <meta name="description" content="Untold BMX is launching on 30 October 2026.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --page-background: #050505;
      --text: #ffffff;
      --accent: #61c968;
      --content-width: 980px;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      width: 100%;
      min-height: 100%;
      margin: 0;
    }

    body {
      overflow-x: hidden;
      background: var(--page-background);
      color: var(--text);
      font-family: "Barlow", Arial, sans-serif;
    }

    a {
      color: inherit;
    }

    .holding-page {
      position: relative;
      isolation: isolate;
      display: grid;
      min-height: 100vh;
      min-height: 100svh;
      overflow: hidden;
      background:
        linear-gradient(rgba(0, 0, 0, 0.16), rgba(0, 0, 0, 0.18)),
        url("data:image/jpeg;base64,") center center / cover no-repeat;
    }

    .holding-page__inner {
      width: min(100%, calc(var(--content-width) + 48px));
      min-height: 100%;
      margin: 0 auto;
      padding:
        max(34px, env(safe-area-inset-top))
        24px
        max(28px, env(safe-area-inset-bottom));
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .logo {
      width: clamp(150px, 12.5vw, 200px);
      height: auto;
      flex: 0 0 auto;
    }

    .logo svg {
      display: block;
      width: 100%;
      height: auto;
    }

    .hero-copy {
      width: 100%;
      margin: auto 0;
      transform: translateY(-1.5vh);
    }

    .eyebrow {
      margin: 0 0 clamp(22px, 3vh, 34px);
      font-family: "Barlow Condensed", "Arial Narrow", sans-serif;
      font-size: clamp(15px, 1.55vw, 24px);
      font-weight: 500;
      line-height: 1;
      letter-spacing: 24px;
      text-indent: clamp(0.35em, 1.05vw, 0.78em);
      text-transform: uppercase;
      white-space: nowrap;
    }

    .launch-date {
      margin: 0;
      font-family: "Barlow Condensed", "Arial Narrow", sans-serif;
      font-size: clamp(104px, 13.7vw, 218px);
      font-weight: 500;
      line-height: 0.72;
      letter-spacing: 0;
      white-space: nowrap;
    }

    .countdown {
      display: grid;
      grid-template-columns: repeat(4, minmax(82px, 1fr));
      gap: clamp(12px, 2.25vw, 38px);
      width: min(100%, 590px);
      margin: clamp(42px, 6.2vh, 58px) auto 0;
    }

    .countdown__unit {
      min-width: 0;
    }

    .countdown__value {
      display: block;
      color: var(--accent);
      font-family: "Barlow Condensed", "Arial Narrow", sans-serif;
      font-size: clamp(48px, 4.2vw, 68px);
      font-weight: 600;
      line-height: 0.9;
      letter-spacing: -0.02em;
      font-variant-numeric: tabular-nums;
    }

    .countdown__label {
      display: block;
      margin-top: 11px;
      font-family: "Barlow Condensed", "Arial Narrow", sans-serif;
      font-size: clamp(16px, 1.55vw, 24px);
      font-weight: 500;
      line-height: 1;
      text-transform: uppercase;
    }

    .socials {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 31px;
      min-height: 34px;
      flex: 0 0 auto;
    }

    .social-link {
      display: inline-grid;
      place-items: center;
      width: 28px;
      height: 28px;
      text-decoration: none;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    .social-link:hover {
      opacity: 0.72;
      transform: translateY(-2px);
    }

    .social-link:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 5px;
      border-radius: 2px;
    }

    .social-link svg {
      display: block;
      width: 100%;
      height: 100%;
      fill: currentColor;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .newsletter {

    	margin: 60px 0 0 0;

    	.newsletter__title {
    		font-family: "Barlow Condensed", "Arial Narrow", sans-serif;
			font-size: clamp(15px, 1.55vw, 24px);
			font-weight: 500;
			line-height: 1;
			letter-spacing: 2px;
			text-transform: uppercase;
    	}

    	#contact_form {
    		margin: 0 auto;
    		max-width: 600px;
    		.newsletter__fields {

    			position: relative;

    			.newsletter__input {



    			}

    			.newsletter__submit {

    				display: none;

    			}

    		}
    	}

    }

    @media (max-width: 720px) {
      .holding-page {
        background-position: 51% center;
      }

      .holding-page__inner {
        padding-inline: 18px;
      }

      .hero-copy {
        transform: translateY(-2vh);
      }

      .eyebrow {
        margin-bottom: 27px;
        font-size: clamp(14px, 4vw, 19px);
        letter-spacing: clamp(0.28em, 1.8vw, 0.48em);
        text-indent: clamp(0.28em, 1.8vw, 0.48em);
      }

      .launch-date {
        font-size: clamp(82px, 26vw, 138px);
        line-height: 0.78;
      }

      .countdown {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 9px;
        margin-top: 39px;
      }

      .countdown__value {
        font-size: clamp(40px, 13vw, 58px);
      }

      .countdown__label {
        margin-top: 8px;
        font-size: clamp(13px, 4.3vw, 18px);
      }
    }

    @media (max-width: 380px) {
      .holding-page__inner {
        padding-inline: 13px;
      }

      .eyebrow {
        font-size: 13px;
      }

      .launch-date {
        font-size: 78px;
      }

      .countdown__value {
        font-size: 38px;
      }

      .countdown__label {
        font-size: 12px;
      }
    }

    @media (max-height: 690px) and (min-width: 721px) {
      .holding-page__inner {
        padding-top: 22px;
        padding-bottom: 20px;
      }

      .logo {
        width: 145px;
      }

      .hero-copy {
        transform: translateY(-1vh);
      }

      .eyebrow {
        margin-bottom: 23px;
      }

      .launch-date {
        font-size: min(22vh, 176px);
      }

      .countdown {
        margin-top: 34px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .social-link {
        transition: none;
      }
    }
  </style>
  {{ content_for_header }}
</head>

<body>
  {{ content_for_layout }}
</body>
</html>
