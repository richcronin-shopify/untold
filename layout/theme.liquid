<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	{%- comment -%} Speed 24 Nov 2026: only the weights the theme uses, loaded without blocking first paint {%- endcomment -%}
	<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@200;300;400;500;600;700&family=Barlow:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,200;1,400;1,700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
	<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@200;300;400;500;600;700&family=Barlow:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,200;1,400;1,700&display=swap"></noscript>

	<link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}

    {%- capture shopify_header_scripts -%}{{ content_for_header }}{%- endcapture -%}
    {%- assign shopify_pageurl = shopify_header_scripts | split: '"pageurl":"' | last | split: '"' | first | replace: '\/', '/' | replace: '\u0026', '&' -%}
    {% render 'meta-tags', shopify_pageurl: shopify_pageurl %}

    {% render 'structured-data' %}

    {{ shopify_header_scripts }}

  </head>

  	{%- assign is_policy_page = false -%}
    {%- if request.path contains '/policies/' -%}
    	{%- assign is_policy_page = true -%}
    {%- endif -%}

   <body class="template-{{ template.name | handleize }} template-{% if is_policy_page %}policy{% endif %} {% if page.metafields.custom.no_body_padding %}no-top-padding{% endif %}">
    {% sections 'header-group' %}

    {%- if is_policy_page -%}

      <div class="policy-page">

        {%- if settings.policy_navigation != blank and settings.policy_navigation.links.size > 0 -%}
          <nav class="policy-page__navigation" aria-label="Policy navigation">
            <div class="container">

              <ul class="policy-page__navigation-list" role="list">
                {%- for link in settings.policy_navigation.links -%}
                  <li class="policy-page__navigation-item">
                    <a
                      href="{{ link.url }}"
                      class="policy-page__navigation-link{% if link.current %} is-active{% endif %}"
                      {% if link.current %}aria-current="page"{% endif %}
                    >
                      {{ link.title }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>

            </div>
          </nav>
        {%- endif -%}

        {{ content_for_layout }}

        {%- if settings.policy_button_intro != blank or settings.policy_button_label != blank -%}
          <div class="container">
            <div class="policy-page__cta">

              {%- if settings.policy_button_intro != blank -%}
                <div class="policy-page__cta-intro">
                  {{ settings.policy_button_intro }}
                </div>
              {%- endif -%}

              {%- if settings.policy_button_label != blank and settings.policy_button_link != blank -%}
                <a href="{{ settings.policy_button_link }}" class="button button--outline policy-page__cta-button">
                  {{ settings.policy_button_label }}
                </a>
              {%- endif -%}

            </div>
          </div>
        {%- endif -%}

      </div>

    {%- else -%}

      {{ content_for_layout }}

    {%- endif -%}

    {% sections 'footer-group' %}

	<script
		src="{{ 'base.min.js' | asset_url }}"
		defer
	></script>
	<script
		src="{{ 'swiper-bundle.min.js' | asset_url }}"
		defer
	></script>
  </body>
</html>
