          "settings": {
            "question": "Do you offer free delivery?",
            "answer": "<p>Yes. UNTOLD BMX offers free UK delivery on orders over £200. Orders under £200 are £8 with Royal Mail Tracked 48, or £12 with DPD for bulkier items.</p>"
          }
        },
        "faq_AmaF3C": {
          "type": "faq",
          "settings": {
            "question": "Do you ship to Europe, or only the UK?",
            "answer": "<p>No. UNTOLD BMX does not ship to Europe. Delivery is to UK addresses only.</p>"
          }
        },
        "faq_qJEWHX": {
          "type": "faq",
          "settings": {
            "question": "How quickly does UNTOLD BMX dispatch and deliver, and how much does it cost?",
            "answer": "<p>UNTOLD BMX dispatches items stocked at its UNTOLD Warehouse the next working day. All other items are dispatched in 1–2 days and then sent by Royal Mail Tracked 48.</p><p>Delivery is £8 with Royal Mail Tracked 48, or £12 with DPD for bulkier items, and it is free on UK orders over £200. Delivery is to UK addresses only.</p>"
          }
        },
        "faq_4R7hzM": {
          "type": "faq",
          "settings": {
            "question": "Can I change or cancel my order after I've paid?",
            "answer": "<p>If you change your mind after you have placed an order please reach out to us ASAP.</p>"
          }
        },
