        "faq_qdMEKh": {
          "type": "faq",
          "settings": {
            "question": "What's your returns policy?",
            "answer": "<p>UNTOLD BMX offers a 30-day returns policy. To be eligible, your item must be unused, in the same condition that you received it, and in its original packaging, and any free gifts included with the order must also be returned.</p><p>See the full <a href=\"/policies/refund-policy\" title=\"Refund policy\">refund policy</a> for details.</p>"
          }
        },
        "faq_QBcBqb": {
          "type": "faq",
          "settings": {
            "question": "Who pays for return postage, and how long do refunds take?",
            "answer": "<p>If you return an item to UNTOLD BMX, you are responsible for the return postage, and the original shipping costs are non-refundable. Once a refund is approved, a credit is applied to your original payment method and can take up to 14 working days, depending on the bank.</p>"
          }
        },
        "faq_xPcqMM": {
          "type": "faq",
          "settings": {
            "question": "Can I swap something for a different size or colour?",
            "answer": "<p>UNTOLD BMX replaces items that are defective or damaged. For any other replacement reason, please get in touch at <a href=\"mailto:support@untoldbmx.co.uk\">support@untoldbmx.co.uk</a>.</p>"
          }
        },
