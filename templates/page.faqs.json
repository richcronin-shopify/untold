        "faq_Y6RtCz": {
          "type": "faq",
          "settings": {
            "question": "What brands do you stock?",
            "answer": "<p>We stock genuine bikes and parts from brands including Cult, Kink, FIT, Colony, S&M, Federal, United, Tall Order, Primo, Fiend, Stranger, ODI and Pro-Tec.</p><p>See all the <a href=\"/pages/brands-we-stock\" title=\"Brands we stock\">brands we stock</a>.</p>"
