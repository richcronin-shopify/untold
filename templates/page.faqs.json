        "faq_JnTFaw": {
          "type": "faq",
          "settings": {
            "question": "Cassette or freecoaster, what's the difference?",
            "answer": "<p>With a <strong>cassette hub</strong>, your cranks turn backwards when you roll fakie. They feel direct and responsive and are a popular all-round choice.</p><p>A <strong>freecoaster hub</strong> lets you roll backwards without the cranks moving, making fakies and technical street tricks easier. The trade-off is a little more slack before the hub engages when you pedal forward.</p>"
          }
        },
        "faq_Cei8Kf": {
          "type": "faq",
          "settings": {
            "question": "Do complete bikes arrive ready to ride?",
            "answer": "<p>Each BMX differs slightly with how it's packaged so please reach out to us before purchasing if you need full assembly.</p>"
          }
        },
