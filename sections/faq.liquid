{{- 'main-page.css' | asset_url | stylesheet_tag -}}
{%- assign ss = section.settings -%}

<section class="page page--faqs faq-section{% if ss.text_align != blank %} faq-section--{{ ss.text_align }}{% endif %}" id="{{ section.id }}">
	<div class="container">
		<div class="page__inner">

			{%- if ss.heading != blank or ss.intro != blank -%}
				<header class="page__header">
					{%- if ss.heading != blank -%}
						<h{{ ss.heading_tag }} class="page__title h{{ ss.font_size }}">
							{{ ss.heading | escape }}
						</h{{ ss.heading_tag }}>
					{%- endif -%}

					{%- if ss.intro != blank -%}
						<div class="page__intro rte">
							{{ ss.intro }}
						</div>
					{%- endif -%}
				</header>
			{%- endif -%}

			{%- if section.blocks.size > 0 -%}
				<div class="page__faqs">
					{%- assign first_opened = false -%}

					{%- for block in section.blocks -%}
						{%- if block.type == 'faq' and block.settings.question != blank -%}
							<details
								class="page__faq"
								{%- if ss.open_first and first_opened == false %} open{% endif %}
								{{ block.shopify_attributes }}
							>
								<summary class="page__faq-trigger">
									<span class="page__faq-question">
										{{ block.settings.question | escape }}
									</span>
									<span class="page__faq-icon" aria-hidden="true"></span>
								</summary>

								{%- if block.settings.answer != blank -%}
									<div class="page__faq-content rte">
										{{ block.settings.answer }}
									</div>
								{%- endif -%}
							</details>

							{%- assign first_opened = true -%}
						{%- endif -%}
					{%- endfor -%}
				</div>
			{%- endif -%}

			{%- if ss.link_label != blank and ss.link_url != blank -%}
				<div class="page__cta">
					<a href="{{ ss.link_url }}" class="button button--outline page__cta-button">
						{{ ss.link_label | escape }}
					</a>
				</div>
			{%- endif -%}

		</div>
	</div>
</section>

{%- style -%}
	#{{ section.id }} {
		padding-top: {{ ss.padding-top }}px;
		padding-bottom: {{ ss.padding-bottom }}px;
	}

	#{{ section.id }} .page__inner {
		padding-top: 0;
		padding-bottom: 0;
	}

	#{{ section.id }}.faq-section--text-align-left .page__header {
		text-align: left;
	}

	@media screen and (max-width: 750px) {
		#{{ section.id }} {
			padding-top: {{ ss.padding-top-m }}px;
			padding-bottom: {{ ss.padding-bottom-m }}px;
		}
	}
{%- endstyle -%}

{%- if ss.output_schema -%}
	{%- assign faq_schema_count = 0 -%}
	{%- for block in section.blocks -%}
		{%- if block.type == 'faq' and block.settings.question != blank and block.settings.answer != blank -%}
			{%- assign faq_schema_count = faq_schema_count | plus: 1 -%}
		{%- endif -%}
	{%- endfor -%}

	{%- if faq_schema_count > 0 -%}
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "FAQPage",
				"mainEntity": [
					{%- assign faq_emitted = 0 -%}
					{%- for block in section.blocks -%}
						{%- if block.type == 'faq' and block.settings.question != blank and block.settings.answer != blank -%}
							{%- if faq_emitted > 0 -%},{%- endif -%}
							{
								"@type": "Question",
								"name": {{ block.settings.question | json }},
								"acceptedAnswer": {
									"@type": "Answer",
									"text": {{ block.settings.answer | strip_html | strip | json }}
								}
							}
							{%- assign faq_emitted = faq_emitted | plus: 1 -%}
						{%- endif -%}
					{%- endfor -%}
				]
			}
		</script>
	{%- endif -%}
{%- endif -%}

{% schema %}
{
	"name": "FAQ",
	"tag": "section",
	"class": "faq-section",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "header",
			"content": "Content"
		},
		{
			"type": "text",
			"id": "heading",
			"label": "Heading",
			"default": "Common questions"
		},
		{
			"type": "richtext",
			"id": "intro",
			"label": "Intro"
		},
		{
			"type": "range",
			"id": "heading_tag",
			"min": 1,
			"max": 6,
			"step": 1,
			"label": "Heading tag",
			"info": "Heading tags rank in order of importance, from H1 to H6. Use H2 on most pages, and avoid adding another H1.",
			"default": 2
		},
		{
			"type": "range",
			"id": "font_size",
			"min": 1,
			"max": 6,
			"step": 1,
			"label": "Font size",
			"info": "1 being the largest. 6 being the smallest.",
			"default": 2
		},
		{
			"type": "select",
			"id": "text_align",
			"label": "Heading alignment",
			"options": [
				{ "value": "text-align-left", "label": "Left" },
				{ "value": "text-align-center", "label": "Centre" }
			],
			"default": "text-align-center"
		},
		{
			"type": "header",
			"content": "Behaviour"
		},
		{
			"type": "checkbox",
			"id": "open_first",
			"label": "Open first item",
			"default": false
		},
		{
			"type": "checkbox",
			"id": "output_schema",
			"label": "Output FAQ schema",
			"info": "Adds FAQPage structured data from the questions in this section. If you add this section twice on one page, the schema will be output twice.",
			"default": true
		},
		{
			"type": "header",
			"content": "Link"
		},
		{
			"type": "text",
			"id": "link_label",
			"label": "Link label",
			"default": "More questions? See our FAQs"
		},
		{
			"type": "url",
			"id": "link_url",
			"label": "Link"
		},
		{
			"type": "header",
			"content": "Padding (desktop)"
		},
		{
			"type": "range",
			"id": "padding-top",
			"min": 0,
			"max": 300,
			"step": 5,
			"label": "Padding top",
			"default": 50
		},
		{
			"type": "range",
			"id": "padding-bottom",
			"min": 0,
			"max": 300,
			"step": 5,
			"label": "Padding bottom",
			"default": 50
		},
		{
			"type": "header",
			"content": "Padding (mobile)"
		},
		{
			"type": "range",
			"id": "padding-top-m",
			"min": 0,
			"max": 300,
			"step": 5,
			"label": "Padding top",
			"default": 30
		},
		{
			"type": "range",
			"id": "padding-bottom-m",
			"min": 0,
			"max": 300,
			"step": 5,
			"label": "Padding bottom",
			"default": 30
		}
	],
	"blocks": [
		{
			"type": "faq",
			"name": "FAQ",
			"settings": [
				{
					"type": "text",
					"id": "question",
					"label": "Question",
					"default": "Who is UNTOLD?"
				},
				{
					"type": "richtext",
					"id": "answer",
					"label": "Answer",
					"default": "<p>Add your answer here.</p>"
				}
			]
		}
	],
	"max_blocks": 30,
	"presets": [
		{
			"name": "FAQ",
			"blocks": [
				{
					"type": "faq",
					"settings": {
						"question": "Who is UNTOLD?",
						"answer": "<p>Add your answer here.</p>"
					}
				}
			]
		}
	]
}
{% endschema %}
