{{ 'brand-gravity.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ss = section.settings
  assign brands = shop.metaobjects.brands.values
  assign last_logo_index = ss.max_logos | minus: 1
  assign longest_stagger = last_logo_index | times: ss.stagger
  assign finish_time = ss.duration | plus: 0.5 | plus: longest_stagger | plus: 0.5
-%}

{%- comment -%}
  One-shot decorative overlay. The brand-slider remains unchanged.
  No library, observer, animation script, links, or blocking loading state.
  This section is best placed first in the homepage section list.
{%- endcomment -%}
<section
  id="BrandGravity-{{ section.id }}"
  class="brand-gravity"
  aria-hidden="true"
  style="
    --gravity-logo-width: {{ ss.logo_width_desktop }}px;
    --gravity-logo-width-mobile: {{ ss.logo_width_mobile }}px;
    --gravity-hide-after: {{ finish_time }}s;
  "
>
  <div class="brand-gravity__stage">
    {%- for brand in brands limit: ss.max_logos -%}
      {%- assign logo = brand.logo.value -%}
      {%- if logo != blank -%}
        {%- liquid
          assign n = forloop.index0
          assign x = n | times: 71 | plus: 13 | modulo: 87 | plus: 4
          assign sway = n | times: 37 | plus: 17 | modulo: 111 | minus: 55
          assign exit_sway = sway | times: 2
          assign start_angle = n | times: 41 | plus: 18 | modulo: 61 | minus: 30
          assign hit_angle = n | times: 29 | plus: 10 | modulo: 53 | minus: 26
          assign end_angle = n | times: 51 | plus: 80 | modulo: 173 | minus: 86
          assign bounce = n | times: 19 | plus: 32 | modulo: 37 | plus: 28
          assign entry = n | times: 27 | plus: 27 | modulo: 81 | minus: 40
          assign duration_extra = n | times: 23 | modulo: 6 | divided_by: 10.0
          assign fall_duration = ss.duration | plus: duration_extra
          assign stagger = n | times: ss.stagger
        -%}
        <div
          class="brand-gravity__item"
          style="
            --gravity-x: {{ x }}%;
            --gravity-entry-x: {{ entry }}px;
            --gravity-sway: {{ sway }}px;
            --gravity-exit-sway: {{ exit_sway }}px;
            --gravity-start-angle: {{ start_angle }}deg;
            --gravity-hit-angle: {{ hit_angle }}deg;
            --gravity-end-angle: {{ end_angle }}deg;
            --gravity-bounce: {{ bounce }}px;
            --gravity-duration: {{ fall_duration }}s;
            --gravity-delay: {{ stagger }}s;
          "
        >
          {{-
            logo
            | image_url: width: 360
            | image_tag:
              class: 'brand-gravity__logo',
              loading: 'eager',
              fetchpriority: 'low',
              decoding: 'async',
              widths: '120, 180, 240, 360',
              sizes: '(max-width: 749px) 100px, 150px',
              alt: ''
          -}}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Falling brand logos",
  "tag": "section",
  "class": "brand-gravity-section",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "range",
      "id": "max_logos",
      "label": "Maximum logos",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "logo_width_desktop",
      "label": "Logo width — desktop",
      "min": 80,
      "max": 220,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Logo width — mobile",
      "min": 60,
      "max": 150,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Fall duration",
      "min": 2,
      "max": 5,
      "step": 0.5,
      "unit": "s",
      "default": 3
    },
    {
      "type": "range",
      "id": "stagger",
      "label": "Delay between logos",
      "min": 0.1,
      "max": 0.4,
      "step": 0.1,
      "unit": "s",
      "default": 0.1
    }
  ],
  "presets": [
    {
      "name": "Falling brand logos"
    }
  ]
}
{% endschema %}
