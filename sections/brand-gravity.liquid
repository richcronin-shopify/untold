{{ 'brand-gravity.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ss = section.settings
  assign brands = shop.metaobjects.brands.values
-%}

<section
  id="BrandGravity-{{ section.id }}"
  class="brand-gravity"
  data-brand-gravity
  style="
    --gravity-background: {{ ss.background }};
    --gravity-stage-height: {{ ss.height_desktop }}px;
    --gravity-stage-height-mobile: {{ ss.height_mobile }}px;
    --gravity-logo-width: {{ ss.logo_width_desktop }}px;
    --gravity-logo-width-mobile: {{ ss.logo_width_mobile }}px;
    --gravity-duration: {{ ss.duration }}s;
    --gravity-repeat: {% if ss.repeat %}infinite{% else %}1{% endif %};
  "
>
  {%- if ss.heading != blank -%}
    <div class="container brand-gravity__header">
      <h2 class="h5 brand-gravity__heading">{{ ss.heading | escape }}</h2>
    </div>
  {%- endif -%}

  <div class="brand-gravity__stage" aria-hidden="true">
    {%- for brand in brands limit: ss.max_logos -%}
      {%- assign logo = brand.logo.value -%}
      {%- if logo != blank -%}
        {%- liquid
          assign index = forloop.index0
          assign horizontal_position = index | times: 37 | modulo: 90 | plus: 4
          assign drift = index | times: 23 | modulo: 71 | minus: 35
          assign starting_angle = index | times: 19 | modulo: 43 | minus: 21
          assign landing_angle = starting_angle | times: -1
          assign delay = index | times: ss.stagger
        -%}
        <div
          class="brand-gravity__item"
          style="
            --gravity-x: {{ horizontal_position }}%;
            --gravity-drift: {{ drift }}px;
            --gravity-start-angle: {{ starting_angle }}deg;
            --gravity-land-angle: {{ landing_angle }}deg;
            --gravity-half-angle: {{ landing_angle | divided_by: 2.0 }}deg;
            --gravity-delay: {{ delay }}s;
          "
        >
          {{-
            logo
            | image_url: width: 360
            | image_tag:
              class: 'brand-gravity__logo',
              loading: 'lazy',
              decoding: 'async',
              widths: '100, 160, 240, 360',
              sizes: '(max-width: 749px) 100px, 160px',
              alt: ''
          -}}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<script src="{{ 'brand-gravity.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Falling brand logos",
  "tag": "section",
  "class": "brand-gravity-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Brands we ride"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background colour",
      "default": "#151515"
    },
    {
      "type": "range",
      "id": "max_logos",
      "label": "Maximum logos",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Animation height — desktop",
      "min": 200,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 380
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Animation height — mobile",
      "min": 200,
      "max": 500,
      "step": 20,
      "unit": "px",
      "default": 300
    },
    {
      "type": "range",
      "id": "logo_width_desktop",
      "label": "Logo width — desktop",
      "min": 80,
      "max": 220,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Logo width — mobile",
      "min": 60,
      "max": 150,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Fall, bounce and exit duration",
      "min": 4,
      "max": 14,
      "step": 1,
      "unit": "s",
      "default": 7
    },
    {
      "type": "range",
      "id": "stagger",
      "label": "Delay between logos",
      "min": 0.2,
      "max": 1.0,
      "step": 0.1,
      "unit": "s",
      "default": 0.5
    },
    {
      "type": "checkbox",
      "id": "repeat",
      "label": "Repeat falling sequence",
      "default": true,
      "info": "Switch off to play the effect once per page visit."
    }
  ],
  "presets": [
    {
      "name": "Falling brand logos"
    }
  ]
}
{% endschema %}
