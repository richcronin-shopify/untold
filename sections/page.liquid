{%- assign ss = section.settings -%}
{{- 'main-page.css' | asset_url | stylesheet_tag -}}
{%- assign has_faqs = false -%}

{%- if section.blocks.size > 0 -%}
	{%- assign has_faqs = true -%}
{%- endif -%}

<section class="page{% if has_faqs %} page--faqs{% endif %}" id="{{ section.id }}">

	{%- if ss.navigation != blank and ss.navigation.links.size > 0 -%}
		<nav class="page__navigation" aria-label="Page navigation">
			<div class="container">
				<ul class="page__navigation-list" role="list">
					{%- for link in ss.navigation.links -%}
						<li class="page__navigation-item">
							<a href="{{ link.url }}" class="page__navigation-link{% if link.current %} is-active{% endif %}" {% if link.current %}aria-current="page"{% endif %}>
								{{ link.title }}
							</a>
						</li>
					{%- endfor -%}
				</ul>
			</div>
		</nav>
	{%- endif -%}

	{%- unless ss.nav_only -%}
		<div class="container">
			<div class="page__inner">

				<header class="page__header">
					<h1 class="page__title h2">{{ page.title }}</h1>

					{%- if has_faqs and page.content != blank -%}
						<div class="page__intro rte">
							{{ page.content }}
						</div>
					{%- endif -%}
				</header>

				{%- if has_faqs -%}

					<div class="page__faqs">

						{%- assign faq_group_open = false -%}

						{%- for block in section.blocks -%}
							{%- assign bs = block.settings -%}

							{%- case block.type -%}

								{%- when 'faq_heading' -%}

									{%- if bs.title != blank -%}

										{%- if faq_group_open -%}
												</div>
											</div>
										{%- endif -%}

										<div class="page__faq-group" {{ block.shopify_attributes }}>
											<h2 class="page__faq-group-title h2">
												{{ bs.title }}
											</h2>

											<div class="page__faq-group-items">

										{%- assign faq_group_open = true -%}

									{%- endif -%}

								{%- when 'faq' -%}

									{%- if bs.question != blank -%}
										<details class="page__faq" {{ block.shopify_attributes }}>

											<summary class="page__faq-trigger">
												<span class="page__faq-question">
													{{ bs.question }}
												</span>

												<span class="page__faq-icon" aria-hidden="true"></span>
											</summary>

											{%- if bs.answer != blank -%}
												<div class="page__faq-content rte">
													{{ bs.answer }}
												</div>
											{%- endif -%}

										</details>
									{%- endif -%}

							{%- endcase -%}

						{%- endfor -%}

						{%- if faq_group_open -%}
								</div>
							</div>
						{%- endif -%}

					</div>

				{%- elsif page.content != blank -%}

					<div class="page__content rte">
						{{ page.content }}
					</div>

				{%- endif -%}

				{%- if ss.button_intro != blank or ss.button_label != blank -%}
					<div class="page__cta">

						{%- if ss.button_intro != blank -%}
							<div class="page__cta-intro">
								{{ ss.button_intro }}
							</div>
						{%- endif -%}

						{%- if ss.button_label != blank and ss.button_link != blank -%}
							<a href="{{ ss.button_link }}" class="button button--outline page__cta-button">
								{{ ss.button_label }}
							</a>
						{%- endif -%}

					</div>
				{%- endif -%}

			</div>
		</div>
	{%- endunless -%}

</section>

{% stylesheet %}

	.page__faq-group {
		margin-top: 45px;

		&:first-child {
			margin-top: 0;
		}

		.page__faq-group-title {
			margin: 0 0 20px;
			text-align: left;
		}
	}

{% endstylesheet %}

{% schema %}
{
	"name": "Page",
	"settings": [
		{
			"type": "checkbox",
			"id": "nav_only",
			"default": false,
			"label": "Nav only"
		},
		{
			"type": "link_list",
			"id": "navigation",
			"label": "Top navigation"
		},
		{
			"type": "header",
			"content": "Contact button"
		},
		{
			"type": "richtext",
			"id": "button_intro",
			"label": "Button intro text",
			"default": "<p>Still can’t find what you’re looking for?<br>Please contact us below</p>"
		},
		{
			"type": "text",
			"id": "button_label",
			"label": "Button label",
			"default": "Contact us"
		},
		{
			"type": "url",
			"id": "button_link",
			"label": "Button link"
		}
	],
	"blocks": [
		{
			"type": "faq_heading",
			"name": "FAQ Heading",
			"settings": [
				{
					"type": "text",
					"id": "title",
					"label": "Heading",
					"default": "General"
				}
			]
		},
		{
			"type": "faq",
			"name": "FAQ",
			"settings": [
				{
					"type": "text",
					"id": "question",
					"label": "Question",
					"default": "Who is UNTOLD?"
				},
				{
					"type": "richtext",
					"id": "answer",
					"label": "Answer",
					"default": "<p>Add your answer here.</p>"
				}
			]
		}
	],
	"presets": [
		{
			"name": "Page"
		}
	]
}
{% endschema %}