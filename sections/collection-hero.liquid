{{- 'collection-hero.css' | asset_url | stylesheet_tag -}}

{%- assign ss = section.settings -%}
{%- assign breadcrumbs = collection.metafields.custom.breadcrumbs.value -%}
{%- assign short_description = collection.metafields.short.description -%}
{%- assign hero_image = collection.metafields.hero.image.value -%}

<section
	class="collection-hero{% if hero_image == blank %} collection-hero--no-image{% endif %}"
	id="{{ section.id }}"
>
	{%- if hero_image != blank -%}
		<div class="collection-hero__media">
			{{
				hero_image | image_url: width: 2400 | image_tag:
					class: 'collection-hero__image',
					loading: 'eager',
					fetchpriority: 'high',
					widths: '1000, 1400, 1800, 2200, 2400',
					sizes: '100vw',
					alt: ''
			}}
		</div>
	{%- endif -%} 

	<div class="container">
		<div class="collection-hero__content">

			<nav class="collection-hero__breadcrumbs" aria-label="Breadcrumb">
				<ol class="collection-hero__breadcrumb-list" role="list">

					<li class="collection-hero__breadcrumb-item">
						<a href="{{ routes.root_url }}" class="collection-hero__breadcrumb-link">
							Home
						</a>
					</li>

					{%- if breadcrumbs != blank -%}
						{%- for breadcrumb_collection in breadcrumbs -%}

							{%- unless breadcrumb_collection.handle == collection.handle -%}
								<li class="collection-hero__breadcrumb-item">

									<span class="collection-hero__breadcrumb-separator" aria-hidden="true">
										/
									</span>

									<a
										href="{{ breadcrumb_collection.url }}"
										class="collection-hero__breadcrumb-link"
									>
										{{ breadcrumb_collection.title }}
									</a>

								</li>
							{%- endunless -%}

						{%- endfor -%}
					{%- endif -%}

					<li class="collection-hero__breadcrumb-item">

						<span class="collection-hero__breadcrumb-separator" aria-hidden="true">
							/
						</span>

						<span
							class="collection-hero__breadcrumb-current"
							aria-current="page"
						>
							{{ collection.title }}
						</span>

					</li>

				</ol>
			</nav>


			<h1 class="collection-hero__title">
				{{ collection.title }}
			</h1>


			{%- if short_description.value != blank -%}
				<div class="collection-hero__description">
					{{ short_description | metafield_tag }}
				</div>
			{%- endif -%}

		</div>
	</div>
</section>

{% schema %}
{
	"name": "Collection hero",
	"tag": "section",
	"class": "collection-hero-section",
	"settings": [

	],
	"presets": [
		{
			"name": "Collection hero"
		}
	]
}
{% endschema %}