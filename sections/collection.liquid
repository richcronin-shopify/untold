{{- 'main-collection.css' | asset_url | stylesheet_tag -}}
{%- assign ss = section.settings -%}

<section
	class="main-collection"
	id="{{ section.id }}"
	data-main-collection
	data-section-id="{{ section.id }}"
	data-pagination-type="{{ ss.pagination_type }}"
>
	<div class="container">

		{%- paginate collection.products by ss.products_per_page -%}

			<div class="main-collection__items" data-collection-grid>

				{%- if collection.products.size > 0 -%}

					{%- for product in collection.products -%}

						<div class="main-collection__item">
							{% render 'product-card', product: product %}
						</div>

					{%- endfor -%}

				{%- else -%}

					<div class="main-collection__empty">
						<p>No products found.</p>
					</div>

				{%- endif -%}

			</div>

			{%- if paginate.pages > 1 -%}

				{%- if ss.pagination_type == 'standard' -%}

					<nav class="main-collection__pagination" aria-label="Collection pagination">

						{%- if paginate.previous -%}
							<a
								href="{{ paginate.previous.url }}"
								class="main-collection__pagination-arrow main-collection__pagination-arrow--prev"
								aria-label="Previous page"
							>
								{{- 'icon-chev.svg' | inline_asset_content -}}
							</a>
						{%- endif -%}

						{%- for part in paginate.parts -%}

							{%- assign part_page = part.title | plus: 0 -%}

							{%- if part.is_link -%}

								<a
									href="{{ part.url }}"
									class="main-collection__pagination-page"
									aria-label="Go to page {{ part.title }}"
								>
									{{ part.title }}
								</a>

							{%- elsif part_page == paginate.current_page -%}

								<span
									class="main-collection__pagination-page is-current"
									aria-current="page"
								>
									{{ part.title }}
								</span>

							{%- else -%}

								<span class="main-collection__pagination-ellipsis">
									{{ part.title }}
								</span>

							{%- endif -%}

						{%- endfor -%}

						{%- if paginate.next -%}
							<a
								href="{{ paginate.next.url }}"
								class="main-collection__pagination-arrow main-collection__pagination-arrow--next"
								aria-label="Next page"
							>
								{{- 'icon-chev.svg' | inline_asset_content -}}
							</a>
						{%- endif -%}

					</nav>					

				{%- else -%}

					<div
						class="main-collection__infinite"
						data-infinite-pagination
						data-next-url="{{ paginate.next.url | default: '' }}"
					>
						<div
							class="main-collection__infinite-sentinel"
							data-infinite-sentinel
							aria-hidden="true"
						></div>

						<p
							class="main-collection__infinite-status visually-hidden"
							data-infinite-status
							role="status"
							aria-live="polite"
						></p>

						<noscript>
							<nav class="main-collection__pagination" aria-label="Collection pagination">
								{{ paginate | default_pagination }}
							</nav>
						</noscript>
					</div>

				{%- endif -%}

			{%- endif -%}

		{%- endpaginate -%}

	</div>
</section>

{%- style -%}

	#{{ section.id }} {
		padding-top: {{ ss.padding-top }}px;
		padding-bottom: {{ ss.padding-bottom }}px;

		--products-desktop: {{ ss.products_desktop }};
		--products-tablet: {{ ss.products_tablet }};
		--products-mobile: {{ ss.products_mobile }};
	}

	@media screen and (max-width: 767px) {

		#{{ section.id }} {
			padding-top: {{ ss.padding-top-m }}px;
			padding-bottom: {{ ss.padding-bottom-m }}px;
		}

	}

{%- endstyle -%}

{% javascript %}

	(() => {

		const initialiseMainCollections = (container = document) => {

			container
				.querySelectorAll('[data-main-collection]')
				.forEach((section) => {

					if (section.dataset.initialised === 'true') {
						return;
					}

					const grid = section.querySelector(
						'[data-collection-grid]'
					);

					if (!grid) {
						return;
					}


					if (section.dataset.paginationType !== 'infinite') {
						section.dataset.initialised = 'true';
						return;
					}


					const infinite = section.querySelector(
						'[data-infinite-pagination]'
					);

					const sentinel = section.querySelector(
						'[data-infinite-sentinel]'
					);

					const status = section.querySelector(
						'[data-infinite-status]'
					);


					if (!infinite || !sentinel) {
						section.dataset.initialised = 'true';
						return;
					}


					const getPageFromUrl = (url) => {

						const parsedUrl = new URL(
							url,
							window.location.origin
						);

						return parseInt(
							parsedUrl.searchParams.get('page') || '1',
							10
						);

					};


					const getBaseUrl = () => {

						const url = new URL(window.location.href);

						url.searchParams.delete('page');
						url.hash = '';

						return `${url.pathname}${url.search}`;

					};


					const storageKey =
						`collection-state:${getBaseUrl()}`;


					const initialPage = getPageFromUrl(
						window.location.href
					);

					let highestPageLoaded = initialPage;
					let isLoading = false;
					let observer = null;


					const updateUrl = (page) => {

						const url = new URL(window.location.href);

						if (page > 1) {
							url.searchParams.set('page', page);
						} else {
							url.searchParams.delete('page');
						}

						window.history.replaceState(
							{
								...window.history.state,
								page
							},
							'',
							`${url.pathname}${url.search}${url.hash}`
						);

					};


					const saveCollectionState = () => {

						const state = {
							scrollY: window.scrollY,
							initialPage,
							highestPageLoaded,
							nextUrl: infinite.dataset.nextUrl || ''
						};

						sessionStorage.setItem(
							storageKey,
							JSON.stringify(state)
						);

					};


					const getPageUrl = (page) => {

						const url = new URL(
							getBaseUrl(),
							window.location.origin
						);

						if (page > 1) {
							url.searchParams.set('page', page);
						}

						return `${url.pathname}${url.search}`;

					};


					const fetchPage = async (page) => {

						const response = await fetch(
							getPageUrl(page)
						);

						if (!response.ok) {
							throw new Error(
								`Unable to restore collection page ${page}: ${response.status}`
							);
						}

						const html = await response.text();

						const documentParser = new DOMParser();

						const pageDocument = documentParser.parseFromString(
							html,
							'text/html'
						);

						const pageSection = pageDocument.getElementById(
							section.dataset.sectionId
						);

						const pageGrid = pageSection?.querySelector(
							'[data-collection-grid]'
						);

						if (!pageGrid) {
							throw new Error(
								`Unable to find collection grid for page ${page}.`
							);
						}

						return Array.from(pageGrid.children);

					};


					const restoreCollectionState = async () => {

						const navigation = performance
							.getEntriesByType('navigation')[0];

						if (navigation?.type !== 'back_forward') {
							return false;
						}


						const storedState = sessionStorage.getItem(
							storageKey
						);

						if (!storedState) {
							return false;
						}


						let state;

						try {

							state = JSON.parse(storedState);

						} catch (error) {

							return false;

						}


						if (
							!state.highestPageLoaded ||
							!state.initialPage
						) {
							return false;
						}


						section.classList.add('is-restoring');


						try {

							const pages = [];

							for (
								let page = state.initialPage;
								page <= state.highestPageLoaded;
								page += 1
							) {
								pages.push(page);
							}


							const pageResults = await Promise.all(
								pages.map((page) => fetchPage(page))
							);


							const fragment =
								document.createDocumentFragment();


							pageResults.forEach((items) => {

								items.forEach((item) => {
									fragment.appendChild(item);
								});

							});


							grid.replaceChildren(fragment);


							highestPageLoaded =
								state.highestPageLoaded;


							infinite.dataset.nextUrl =
								state.nextUrl || '';


							updateUrl(
								state.highestPageLoaded
							);


							if (!infinite.dataset.nextUrl) {
								sentinel.remove();
							}


							requestAnimationFrame(() => {

								requestAnimationFrame(() => {

									window.scrollTo(
										0,
										state.scrollY || 0
									);

									section.classList.remove(
										'is-restoring'
									);

								});

							});


							return true;

						} catch (error) {

							console.error(error);

							section.classList.remove(
								'is-restoring'
							);

							return false;

						}

					};


					const loadNextPage = async () => {

						const nextUrl = infinite.dataset.nextUrl;

						if (!nextUrl || isLoading) {
							return;
						}


						isLoading = true;

						section.classList.add(
							'is-loading'
						);


						if (status) {
							status.textContent =
								'Loading more products';
						}


						try {

							const loadedPage =
								getPageFromUrl(nextUrl);


							const response = await fetch(
								nextUrl
							);


							if (!response.ok) {
								throw new Error(
									`Unable to load collection page: ${response.status}`
								);
							}


							const html = await response.text();

							const nextDocument =
								new DOMParser().parseFromString(
									html,
									'text/html'
								);


							const nextSection =
								nextDocument.getElementById(
									section.dataset.sectionId
								);


							const nextGrid =
								nextSection?.querySelector(
									'[data-collection-grid]'
								);


							const nextInfinite =
								nextSection?.querySelector(
									'[data-infinite-pagination]'
								);


							if (!nextGrid) {
								throw new Error(
									'Unable to find the next collection grid.'
								);
							}


							const newItems = Array.from(
								nextGrid.children
							);


							newItems.forEach((item) => {
								grid.appendChild(item);
							});


							highestPageLoaded = loadedPage;


							infinite.dataset.nextUrl =
								nextInfinite?.dataset.nextUrl || '';


							updateUrl(
								loadedPage
							);


							if (status) {
								status.textContent =
									`${newItems.length} more products loaded`;
							}


							if (!infinite.dataset.nextUrl) {

								observer?.disconnect();
								sentinel.remove();

							}


						} catch (error) {

							console.error(error);


							if (status) {
								status.textContent =
									'Unable to load more products';
							}


						} finally {

							isLoading = false;

							section.classList.remove(
								'is-loading'
							);

						}

					};


					const initialiseObserver = () => {

						if (
							!('IntersectionObserver' in window) ||
							!sentinel.isConnected
						) {
							return;
						}


						observer = new IntersectionObserver(
							(entries) => {

								if (
									entries.some(
										(entry) =>
											entry.isIntersecting
									)
								) {
									loadNextPage();
								}

							},
							{
								rootMargin: '150px 0px'
							}
						);


						observer.observe(sentinel);

					};


					section.addEventListener(
						'click',
						(event) => {

							const productLink =
								event.target.closest(
									'a[href*="/products/"]'
								);

							if (!productLink) {
								return;
							}

							saveCollectionState();

						}
					);


					window.addEventListener(
						'pagehide',
						saveCollectionState
					);


					restoreCollectionState()
						.finally(() => {

							initialiseObserver();

						});


					section.dataset.initialised = 'true';

				});

		};


		initialiseMainCollections();


		document.addEventListener(
			'shopify:section:load',
			(event) =>
				initialiseMainCollections(event.target)
		);

	})();

{% endjavascript %}

{% schema %}
{
	"name": "Main collection",
	"tag": "section",
	"class": "main-collection-section",
	"settings": [
		{
			"type": "header",
			"content": "Product grid"
		},
		{
			"type": "range",
			"id": "products_desktop",
			"min": 2,
			"max": 6,
			"step": 1,
			"label": "Products per row - desktop",
			"default": 5
		},
		{
			"type": "range",
			"id": "products_tablet",
			"min": 2,
			"max": 5,
			"step": 1,
			"label": "Products per row - tablet",
			"default": 3
		},
		{
			"type": "range",
			"id": "products_mobile",
			"min": 1,
			"max": 3,
			"step": 1,
			"label": "Products per row - mobile",
			"default": 2
		},
		{
			"type": "range",
			"id": "products_per_page",
			"min": 4,
			"max": 50,
			"step": 1,
			"label": "Products per page",
			"default": 20
		},
		{
			"type": "select",
			"id": "pagination_type",
			"label": "Pagination type",
			"options": [
				{
					"value": "standard",
					"label": "Standard pagination"
				},
				{
					"value": "infinite",
					"label": "Infinite pagination"
				}
			],
			"default": "standard"
		},
		{
			"type": "header",
			"content": "Padding (desktop)"
		},
		{
			"type": "range",
			"id": "padding-top",
			"min": 0,
			"max": 300,
			"step": 5,
			"label": "Padding top",
			"default": 40
		},
		{
			"type": "range",
			"id": "padding-bottom",
			"min": 0,
			"max": 300,
			"step": 5,
			"label": "Padding bottom",
			"default": 40
		},
		{
			"type": "header",
			"content": "Padding (mobile)"
		},
		{
			"type": "range",
			"id": "padding-top-m",
			"min": 0,
			"max": 300,
			"step": 5,
			"label": "Padding top",
			"default": 30
		},
		{
			"type": "range",
			"id": "padding-bottom-m",
			"min": 0,
			"max": 300,
			"step": 5,
			"label": "Padding bottom",
			"default": 30
		}
	],
	"presets": [
		{
			"name": "Main collection"
		}
	]
}
{% endschema %}