{{- 'main-collection.css' | asset_url | stylesheet_tag -}}
{%- assign ss = section.settings -%}
{%- assign products_desktop = ss.products_desktop | plus: 0 -%}
{%- assign products_tablet = ss.products_tablet | plus: 0 -%}
{%- assign products_mobile = ss.products_mobile | plus: 0 -%}

{%- liquid
	assign sort_by = collection.sort_by | default: collection.default_sort_by
	assign price_filter = blank
	assign filter_count = collection.filters.size
	assign active_filter_count = 0
	assign use_filter_drawer = false
	assign has_active_filters = false

	if filter_count > 0
		assign use_filter_drawer = true
	endif

	for filter in collection.filters
		assign active_filter_count = active_filter_count | plus: filter.active_values.size

		if filter.type == 'price_range'
			assign price_filter = filter

			if filter.min_value.value != blank or filter.max_value.value != blank
				assign active_filter_count = active_filter_count | plus: 1
			endif
		endif
	endfor

	if active_filter_count > 0
		assign has_active_filters = true
	endif

	assign price_bracket_count = 20

	if price_filter != blank and price_filter.range_max != blank
		assign price_bracket_count = price_filter.range_max | divided_by: 5000.0 | ceil
	endif

	if price_bracket_count < 1
		assign price_bracket_count = 1
	endif
-%}

<section
	class="main-collection collection-filters{% if ss.pagination_type == 'infinite' %} is-restore-pending{% endif %}"
	id="{{ section.id }}"
	data-main-collection
	data-collection-filters
	data-product-count="{{ collection.products_count }}"
	data-section-id="{{ section.id }}"
	data-pagination-type="{{ ss.pagination_type }}"
>
	<div class="container">

		<form
			class="collection-filters__form"
			action="{{ collection.url }}"
			method="get"
			data-filter-form
		>

			<div class="collection-filters__bar">

				<div class="collection-filters__count">
					{{ collection.products_count }} {% if collection.products_count == 1 %}Product{% else %}Products{% endif %}
				</div>

				{%- if use_filter_drawer -%}

					<button
						type="button"
						class="collection-filters__drawer-trigger button--reset"
						data-filter-trigger
						aria-expanded="false"
						aria-controls="CollectionFiltersDrawer-{{ section.id }}"
					>
						<span>
							Filters{% if active_filter_count > 0 %} ({{ active_filter_count }}){% endif %}
						</span>

						<span class="collection-filters__drawer-trigger-icon" aria-hidden="true">
							<span></span>
							<span></span>
							<span></span>
						</span>
					</button>

					<div
						class="collection-filters__drawer"
						id="CollectionFiltersDrawer-{{ section.id }}"
						data-filter-drawer
						aria-hidden="true"
						inert
					>
						<button
							type="button"
							class="collection-filters__drawer-overlay button--reset"
							data-filter-drawer-close
							aria-label="Close filters"
						></button>

						<div
							class="collection-filters__drawer-panel"
							data-filter-drawer-panel
							role="dialog"
							aria-modal="true"
							aria-labelledby="CollectionFiltersDrawerTitle-{{ section.id }}"
						>
							<div class="collection-filters__drawer-header">
								<p class="collection-filters__drawer-title h4" id="CollectionFiltersDrawerTitle-{{ section.id }}">
									Filters
								</p>

								<button
									type="button"
									class="collection-filters__drawer-close button--reset"
									data-filter-drawer-close
									aria-label="Close filters"
								>
									{{- 'icon-close.svg' | inline_asset_content -}}
								</button>
							</div>

				{%- else -%}

					<button
						type="button"
						class="collection-filters__mobile-trigger button--reset"
						data-filter-trigger
						aria-expanded="false"
						aria-controls="CollectionFiltersPanel-{{ section.id }}"
					>
						<span>Filter</span>

						<span class="collection-filters__mobile-trigger-icon" aria-hidden="true">
							<span></span>
							<span></span>
							<span></span>
						</span>
					</button>

				{%- endif -%}

				<div
					class="collection-filters__filters{% if use_filter_drawer %} collection-filters__filters--drawer{% endif %}"
					id="CollectionFiltersPanel-{{ section.id }}"
					data-filter-panel
				>

					{%- for filter in collection.filters -%}

						{%- unless filter.type == 'price_range' -%}

							{%- liquid
								assign filter_has_active_values = false
								assign filter_option_count = 0

								if filter.active_values.size > 0
									assign filter_has_active_values = true
								endif

								case filter.type
									when 'list'
										assign filter_option_count = filter.values.size

									when 'boolean'
										if filter.true_value != blank
											assign filter_option_count = filter_option_count | plus: 1
										endif

										if filter.false_value != blank
											assign filter_option_count = filter_option_count | plus: 1
										endif
								endcase
							-%}

							{%- if filter_option_count > 1 -%}

								<details
									class="collection-filters__dropdown"
									{% if filter_has_active_values %}open{% endif %}
								>

									<summary class="collection-filters__dropdown-trigger">
										<span>{{ filter.label }}</span>

										<span class="collection-filters__dropdown-chevron" aria-hidden="true">
											{{- 'icon-chev.svg' | inline_asset_content -}}
										</span>
									</summary>

									<div class="collection-filters__dropdown-content">

										{%- case filter.type -%}

											{%- when 'boolean' -%}

												{%- if filter.true_value != blank -%}
													{%- assign filter_value = filter.true_value -%}

													<label
														class="collection-filters__option{% if filter_value.count == 0 and filter_value.active == false %} is-disabled{% endif %}"
														for="Filter-{{ section.id }}-{{ forloop.index }}-true"
													>
														<input
															class="collection-filters__checkbox-input"
															type="checkbox"
															id="Filter-{{ section.id }}-{{ forloop.index }}-true"
															name="{{ filter_value.param_name }}"
															value="{{ filter_value.value }}"
															{% if filter_value.active %}checked{% endif %}
															{% if filter_value.count == 0 and filter_value.active == false %}disabled{% endif %}
															data-filter-input
														>

														<span class="collection-filters__checkbox" aria-hidden="true"></span>

														<span class="collection-filters__option-label">
															{{ filter_value.label }}
														</span>

														<span class="collection-filters__option-count">
															({{- filter_value.count -}})
														</span>
													</label>
												{%- endif -%}

												{%- if filter.false_value != blank -%}
													{%- assign filter_value = filter.false_value -%}

													<label
														class="collection-filters__option{% if filter_value.count == 0 and filter_value.active == false %} is-disabled{% endif %}"
														for="Filter-{{ section.id }}-{{ forloop.index }}-false"
													>
														<input
															class="collection-filters__checkbox-input"
															type="checkbox"
															id="Filter-{{ section.id }}-{{ forloop.index }}-false"
															name="{{ filter_value.param_name }}"
															value="{{ filter_value.value }}"
															{% if filter_value.active %}checked{% endif %}
															{% if filter_value.count == 0 and filter_value.active == false %}disabled{% endif %}
															data-filter-input
														>

														<span class="collection-filters__checkbox" aria-hidden="true"></span>

														<span class="collection-filters__option-label">
															{{ filter_value.label }}
														</span>

														<span class="collection-filters__option-count">
															({{- filter_value.count -}})
														</span>
													</label>
												{%- endif -%}

											{%- when 'list' -%}

												{%- for filter_value in filter.values -%}

													<label
														class="collection-filters__option{% if filter_value.count == 0 and filter_value.active == false %} is-disabled{% endif %}"
														for="Filter-{{ section.id }}-{{ filter.param_name | handle }}-{{ forloop.index }}"
													>
														<input
															class="collection-filters__checkbox-input"
															type="checkbox"
															id="Filter-{{ section.id }}-{{ filter.param_name | handle }}-{{ forloop.index }}"
															name="{{ filter_value.param_name }}"
															value="{{ filter_value.value }}"
															{% if filter_value.active %}checked{% endif %}
															{% if filter_value.count == 0 and filter_value.active == false %}disabled{% endif %}
															data-filter-input
														>

														<span class="collection-filters__checkbox" aria-hidden="true"></span>

														<span class="collection-filters__option-label">
															{{ filter_value.label }}
														</span>

														<span class="collection-filters__option-count">
															({{- filter_value.count -}})
														</span>
													</label>

												{%- endfor -%}

										{%- endcase -%}

									</div>

								</details>

							{%- endif -%}

						{%- endunless -%}

					{%- endfor -%}

					{%- if price_filter != blank -%}

						<details
							class="collection-filters__dropdown collection-filters__dropdown--price"
							data-price-dropdown
							{% if price_filter.min_value.value != blank or price_filter.max_value.value != blank %}open{% endif %}
						>

							<summary class="collection-filters__dropdown-trigger">
								<span>Price</span>

								<span class="collection-filters__dropdown-chevron" aria-hidden="true">
									{{- 'icon-chev.svg' | inline_asset_content -}}
								</span>
							</summary>

							<div class="collection-filters__dropdown-content">

								{%- for i in (1..price_bracket_count) -%}

									{%- liquid
										assign min_price = i | minus: 1 | times: 50
										assign max_price = i | times: 50
										assign min_price_cents = min_price | times: 100
										assign max_price_cents = max_price | times: 100
									-%}

									<label
										class="collection-filters__option collection-filters__option--price"
										for="Filter-{{ section.id }}-price-{{ forloop.index }}"
									>
										<input
											class="collection-filters__checkbox-input"
											type="checkbox"
											id="Filter-{{ section.id }}-price-{{ forloop.index }}"
											value="{{ min_price }}-{{ max_price }}"
											data-price-option
											data-price-min="{{ min_price }}"
											data-price-max="{{ max_price }}"
										>

										<span class="collection-filters__checkbox" aria-hidden="true"></span>

										<span class="collection-filters__option-label">
											{{ min_price_cents | money_without_trailing_zeros }}–{{ max_price_cents | money_without_trailing_zeros }}
										</span>

										<span class="collection-filters__option-count" data-price-count></span>
									</label>

								{%- endfor -%}

							</div>

						</details>

						<input
							type="hidden"
							name="{{ price_filter.min_value.param_name }}"
							value="{% if price_filter.min_value.value != blank %}{{ price_filter.min_value.value | money_without_currency | replace: ',', '' }}{% endif %}"
							data-price-min-input
						>

						<input
							type="hidden"
							name="{{ price_filter.max_value.param_name }}"
							value="{% if price_filter.max_value.value != blank %}{{ price_filter.max_value.value | money_without_currency | replace: ',', '' }}{% endif %}"
							data-price-max-input
						>

					{%- endif -%}

					{%- if has_active_filters -%}
						<a
							href="{{ collection.url }}?sort_by={{ sort_by | url_encode }}"
							class="collection-filters__clear-all"
						>
							Clear all
						</a>
					{%- endif -%}

				</div>

				{%- if use_filter_drawer -%}
						</div>
					</div>
				{%- endif -%}

				<div class="collection-filters__sort collection-filters__sort--desktop">

					<label
						class="collection-filters__sort-label"
						for="CollectionSort-{{ section.id }}"
					>
						Sort by
					</label>

					<div class="collection-filters__sort-select-wrap">
						<select
							class="collection-filters__sort-select"
							id="CollectionSort-{{ section.id }}"
							name="sort_by"
							data-sort-select
						>
							{%- for option in collection.sort_options -%}
								<option
									value="{{ option.value }}"
									{% if option.value == sort_by %}selected{% endif %}
								>
									{{ option.name }}
								</option>
							{%- endfor -%}
						</select>

						<span class="collection-filters__sort-chevron" aria-hidden="true">
							{{- 'icon-chev.svg' | inline_asset_content -}}
						</span>
					</div>

				</div>

				<div class="collection-filters__sort collection-filters__sort--mobile">

					<label
						class="visually-hidden"
						for="CollectionSortMobile-{{ section.id }}"
					>
						Sort products
					</label>

					<div class="collection-filters__sort-select-wrap">
						<select
							class="collection-filters__sort-select"
							id="CollectionSortMobile-{{ section.id }}"
							data-mobile-sort
						>
							{%- for option in collection.sort_options -%}
								<option
									value="{{ option.value }}"
									{% if option.value == sort_by %}selected{% endif %}
								>
									{{ option.name }}
								</option>
							{%- endfor -%}
						</select>

						<span class="collection-filters__sort-chevron" aria-hidden="true">
							{{- 'icon-chev.svg' | inline_asset_content -}}
						</span>
					</div>

				</div>

 
				<div
					class="collection-filters__grid-view collection-filters__grid-view--desktop"
					role="group"
					aria-label="Products per row"
				>
					{%- for columns in (3..5) -%}
						<button
							type="button"
							class="collection-filters__grid-view-button button--reset{% if ss.products_desktop == columns %} is-active{% endif %}"
							data-grid-toggle
							data-grid-target="desktop"
							data-grid-columns="{{ columns }}"
							aria-label="Show {{ columns }} products per row"
							aria-pressed="{% if ss.products_desktop == columns %}true{% else %}false{% endif %}"
						>
							<span
								class="collection-filters__grid-view-icon"
								style="--grid-columns: {{ columns }};"
								aria-hidden="true"
							>
								{%- for i in (1..columns) -%}
									<span></span>
								{%- endfor -%}
							</span>
						</button>
					{%- endfor -%}
				</div>


				<div
					class="collection-filters__grid-view collection-filters__grid-view--tablet"
					role="group"
					aria-label="Products per row"
				>
					{%- for columns in (3..4) -%}
						<button
							type="button"
							class="collection-filters__grid-view-button button--reset{% if products_tablet == columns %} is-active{% endif %}"
							data-grid-toggle
							data-grid-target="tablet"
							data-grid-columns="{{ columns }}"
							aria-label="Show {{ columns }} products per row"
							aria-pressed="{% if products_tablet == columns %}true{% else %}false{% endif %}"
						>
							<span
								class="collection-filters__grid-view-icon"
								style="--grid-columns: {{ columns }};"
								aria-hidden="true"
							>
								{%- for i in (1..columns) -%}
									<span></span>
								{%- endfor -%}
							</span>
						</button>
					{%- endfor -%}
				</div>


				<div
					class="collection-filters__grid-view collection-filters__grid-view--mobile"
					role="group"
					aria-label="Products per row"
				>
					{%- for columns in (1..2) -%}
						<button
							type="button"
							class="collection-filters__grid-view-button button--reset{% if products_mobile == columns %} is-active{% endif %}"
							data-grid-toggle
							data-grid-target="mobile"
							data-grid-columns="{{ columns }}"
							aria-label="Show {{ columns }} product{% if columns > 1 %}s{% endif %} per row"
							aria-pressed="{% if products_mobile == columns %}true{% else %}false{% endif %}"
						>
							<span
								class="collection-filters__grid-view-icon"
								style="--grid-columns: {{ columns }};"
								aria-hidden="true"
							>
								{%- for i in (1..columns) -%}
									<span></span>
								{%- endfor -%}
							</span>
						</button>
					{%- endfor -%}
				</div>

			</div>

		</form>

		{%- paginate collection.products by ss.products_per_page -%}

			<div class="main-collection__items" data-collection-grid>

				{%- if collection.products.size > 0 -%}

					{%- for product in collection.products -%}

						<div class="main-collection__item">
							{% render 'product-card', product: product %}
						</div>

					{%- endfor -%}

				{%- else -%}

					<div class="main-collection__empty">
						<p>No products found.</p>
					</div>

				{%- endif -%}

			</div>

			{%- if paginate.pages > 1 -%}

				{%- if ss.pagination_type == 'standard' -%}

					<nav class="main-collection__pagination" aria-label="Collection pagination">

						{%- if paginate.previous -%}
							<a
								href="{{ paginate.previous.url }}"
								class="main-collection__pagination-arrow main-collection__pagination-arrow--prev"
								aria-label="Previous page"
							>
								{{- 'icon-chev.svg' | inline_asset_content -}}
							</a>
						{%- endif -%}

						{%- for part in paginate.parts -%}

							{%- assign part_page = part.title | plus: 0 -%}

							{%- if part.is_link -%}

								<a
									href="{{ part.url }}"
									class="main-collection__pagination-page"
									aria-label="Go to page {{ part.title }}"
								>
									{{ part.title }}
								</a>

							{%- elsif part_page == paginate.current_page -%}

								<span
									class="main-collection__pagination-page is-current"
									aria-current="page"
								>
									{{ part.title }}
								</span>

							{%- else -%}

								<span class="main-collection__pagination-ellipsis">
									{{ part.title }}
								</span>

							{%- endif -%}

						{%- endfor -%}

						{%- if paginate.next -%}
							<a
								href="{{ paginate.next.url }}"
								class="main-collection__pagination-arrow main-collection__pagination-arrow--next"
								aria-label="Next page"
							>
								{{- 'icon-chev.svg' | inline_asset_content -}}
							</a>
						{%- endif -%}

					</nav>					

				{%- else -%}

					<div
						class="main-collection__infinite"
						data-infinite-pagination
						data-next-url="{{ paginate.next.url | default: '' }}"
					>
						<div
							class="main-collection__infinite-sentinel"
							data-infinite-sentinel
							aria-hidden="true"
						></div>

						<p
							class="main-collection__infinite-status visually-hidden"
							data-infinite-status
							role="status"
							aria-live="polite"
						></p>

						<noscript>
							<nav class="main-collection__pagination" aria-label="Collection pagination">
								{{ paginate | default_pagination }}
							</nav>
						</noscript>
					</div>

				{%- endif -%}

			{%- endif -%}

		{%- endpaginate -%}

		{% if collection.description %}
			<div class="collection--description rte">
				{{collection.description}}
			</div>
		{% endif %}

	</div>
</section>

{%- style -%}

	#{{ section.id }} {
		padding-top: {{ ss.padding-top }}px;
		padding-bottom: {{ ss.padding-bottom }}px;

		--products-desktop: {{ ss.products_desktop }};
		--products-tablet: {{ ss.products_tablet }};
		--products-mobile: {{ ss.products_mobile }};
	}

	@media screen and (max-width: 767px) {

		#{{ section.id }} {
			padding-top: {{ ss.padding-top-m }}px;
			padding-bottom: {{ ss.padding-bottom-m }}px;
		}

	}

{%- endstyle -%}

{% javascript %}

	(() => {

		const initialiseMainCollections = (container = document) => {

			container
				.querySelectorAll('[data-main-collection]')
				.forEach((section) => {

					if (section.dataset.mainCollectionInitialised === 'true') {
						return;
					}

					const grid = section.querySelector(
						'[data-collection-grid]'
					);

					if (!grid) {
						section.classList.remove(
							'is-restore-pending'
						);

						return;
					}


					if (section.dataset.paginationType !== 'infinite') {
						section.classList.remove(
							'is-restore-pending'
						);

						section.dataset.mainCollectionInitialised = 'true';
						return;
					}


					const infinite = section.querySelector(
						'[data-infinite-pagination]'
					);

					const sentinel = section.querySelector(
						'[data-infinite-sentinel]'
					);

					const status = section.querySelector(
						'[data-infinite-status]'
					);


					if (!infinite || !sentinel) {
						section.classList.remove(
							'is-restore-pending'
						);

						section.dataset.mainCollectionInitialised = 'true';
						return;
					}


					const getPageFromUrl = (url) => {

						const parsedUrl = new URL(
							url,
							window.location.origin
						);

						return parseInt(
							parsedUrl.searchParams.get('page') || '1',
							10
						);

					};


					const getBaseUrl = () => {

						const url = new URL(window.location.href);

						url.searchParams.delete('page');
						url.hash = '';

						return `${url.pathname}${url.search}`;

					};


					const storageKey =
						`collection-state:${getBaseUrl()}`;


					let initialPage = getPageFromUrl(
						window.location.href
					);

					let highestPageLoaded = initialPage;
					let isLoading = false;
					let observer = null;

					let isInfinitePaused = false;


					const pauseInfiniteScroll = () => {

						isInfinitePaused = true;

						observer?.disconnect();

					};


					const resumeInfiniteScroll = () => {

						if (!isInfinitePaused) {
							return;
						}

						isInfinitePaused = false;

						if (
							observer &&
							sentinel.isConnected &&
							infinite.dataset.nextUrl
						) {
							observer.observe(sentinel);
						}

					};


					section.addEventListener(
						'collection:pause-infinite',
						pauseInfiniteScroll
					);

					section.addEventListener(
						'collection:resume-infinite',
						resumeInfiniteScroll
					);


					const updateUrl = (page) => {

						const url = new URL(window.location.href);

						if (page > 1) {
							url.searchParams.set('page', page);
						} else {
							url.searchParams.delete('page');
						}

						window.history.replaceState(
							{
								...window.history.state,
								page
							},
							'',
							`${url.pathname}${url.search}${url.hash}`
						);

					};


					const saveCollectionState = () => {

						const state = {
							scrollY: window.scrollY,
							initialPage,
							highestPageLoaded,
							nextUrl: infinite.dataset.nextUrl || ''
						};

						sessionStorage.setItem(
							storageKey,
							JSON.stringify(state)
						);

					};


					const getPageUrl = (page) => {

						const url = new URL(
							getBaseUrl(),
							window.location.origin
						);

						if (page > 1) {
							url.searchParams.set('page', page);
						}

						return `${url.pathname}${url.search}`;

					};


					const fetchPage = async (page) => {

						const response = await fetch(
							getPageUrl(page)
						);

						if (!response.ok) {
							throw new Error(
								`Unable to restore collection page ${page}: ${response.status}`
							);
						}

						const html = await response.text();

						const documentParser = new DOMParser();

						const pageDocument = documentParser.parseFromString(
							html,
							'text/html'
						);

						const pageSection = pageDocument.getElementById(
							section.dataset.sectionId
						);

						const pageGrid = pageSection?.querySelector(
							'[data-collection-grid]'
						);

						if (!pageGrid) {
							throw new Error(
								`Unable to find collection grid for page ${page}.`
							);
						}

						return Array.from(pageGrid.children);

					};


					const restoreCollectionState = async () => {

						const storedState = sessionStorage.getItem(
							storageKey
						);

						if (!storedState) {
							return false;
						}

						let state;

						try {

							state = JSON.parse(storedState);

						} catch (error) {

							return false;

						}

						if (
							!state.highestPageLoaded ||
							!state.initialPage
						) {
							return false;
						}

						const currentPage = getPageFromUrl(
							window.location.href
						);

						/*
						 * Only restore when the browser has returned to the
						 * highest page reached by infinite scroll.
						 */
						if (currentPage !== state.highestPageLoaded) {
							return false;
						}

						section.classList.add('is-restoring');

						try {

							const pages = [];

							for (
								let page = state.initialPage;
								page <= state.highestPageLoaded;
								page += 1
							) {
								pages.push(page);
							}

							const pageResults = await Promise.all(
								pages.map((page) => fetchPage(page))
							);

							const fragment =
								document.createDocumentFragment();

							pageResults.forEach((items) => {

								items.forEach((item) => {
									fragment.appendChild(item);
								});

							});

							grid.replaceChildren(fragment);

							/*
							 * Preserve the original first page after a restore.
							 * Without this, returning from a PDP on ?page=3
							 * re-initialises initialPage as 3, and the next
							 * saved state forgets that pages 1–2 were loaded.
							 */
							initialPage =
								state.initialPage;

							highestPageLoaded =
								state.highestPageLoaded;

							infinite.dataset.nextUrl =
								state.nextUrl || '';

							updateUrl(
								state.highestPageLoaded
							);

							if (!infinite.dataset.nextUrl) {
								sentinel.remove();
							}

							requestAnimationFrame(() => {

								requestAnimationFrame(() => {

									window.scrollTo(
										0,
										state.scrollY || 0
									);

									section.classList.remove(
										'is-restoring'
									);

								});

							});

							return true;

						} catch (error) {

							console.error(error);

							section.classList.remove(
								'is-restoring'
							);

							return false;

						}

					};


					const loadNextPage = async () => {

						const nextUrl = infinite.dataset.nextUrl;

						if (!nextUrl || isLoading) {
							return;
						}


						isLoading = true;

						section.classList.add(
							'is-loading'
						);


						if (status) {
							status.textContent =
								'Loading more products';
						}


						try {

							const loadedPage =
								getPageFromUrl(nextUrl);


							const response = await fetch(
								nextUrl
							);


							if (!response.ok) {
								throw new Error(
									`Unable to load collection page: ${response.status}`
								);
							}


							const html = await response.text();

							const nextDocument =
								new DOMParser().parseFromString(
									html,
									'text/html'
								);


							const nextSection =
								nextDocument.getElementById(
									section.dataset.sectionId
								);


							const nextGrid =
								nextSection?.querySelector(
									'[data-collection-grid]'
								);


							const nextInfinite =
								nextSection?.querySelector(
									'[data-infinite-pagination]'
								);


							if (!nextGrid) {
								throw new Error(
									'Unable to find the next collection grid.'
								);
							}


							const newItems = Array.from(
								nextGrid.children
							);


							newItems.forEach((item) => {
								grid.appendChild(item);
							});


							highestPageLoaded = loadedPage;


							infinite.dataset.nextUrl =
								nextInfinite?.dataset.nextUrl || '';


							updateUrl(
								loadedPage
							);


							if (status) {
								status.textContent =
									`${newItems.length} more products loaded`;
							}


							if (!infinite.dataset.nextUrl) {

								observer?.disconnect();
								sentinel.remove();

							}


						} catch (error) {

							console.error(error);


							if (status) {
								status.textContent =
									'Unable to load more products';
							}


						} finally {

							isLoading = false;

							section.classList.remove(
								'is-loading'
							);

						}

					};


					const initialiseObserver = () => {

						if (
							!('IntersectionObserver' in window) ||
							!sentinel.isConnected
						) {
							return;
						}


						observer = new IntersectionObserver(
							(entries) => {

								if (
									!isInfinitePaused &&
									entries.some(
										(entry) =>
											entry.isIntersecting
									)
								) {
									loadNextPage();
								}

							},
							{
								rootMargin: '150px 0px'
							}
						);


						observer.observe(sentinel);

					};


					section.addEventListener(
						'click',
						(event) => {

							const productLink =
								event.target.closest(
									'a[href*="/products/"]'
								);

							if (!productLink) {
								return;
							}

							saveCollectionState();

						}
					);


					window.addEventListener(
						'pagehide',
						saveCollectionState
					);


					restoreCollectionState()
						.finally(() => {

							section.classList.remove(
								'is-restore-pending'
							);

							initialiseObserver();

						});


					section.dataset.mainCollectionInitialised = 'true';

				});

		};


		initialiseMainCollections();


		document.addEventListener(
			'shopify:section:load',
			(event) =>
				initialiseMainCollections(event.target)
		);

	})();

(() => {

	let resumeScrollHandler = null;
	let resumeTimer = null;


	document.addEventListener('click', (event) => {

		const trigger = event.target.closest(
			'.collection-hero__description-read-more'
		);

		if (!trigger) {
			return;
		}


		const target = document.querySelector(
			'.collection-description, .collection--description'
		);

		if (!target) {
			return;
		}


		const collectionSection = document.querySelector(
			'[data-main-collection]'
		);


		collectionSection?.dispatchEvent(
			new CustomEvent(
				'collection:pause-infinite'
			)
		);


		if (resumeScrollHandler) {

			window.removeEventListener(
				'scroll',
				resumeScrollHandler
			);

			resumeScrollHandler = null;

		}


		if (resumeTimer) {
			window.clearTimeout(resumeTimer);
		}


		const isMobile = window.matchMedia(
			'(max-width: 767px)'
		).matches;

		const offset = isMobile
			? 120
			: 180;


		const targetPosition =
			target.getBoundingClientRect().top +
			window.scrollY -
			offset;


		window.scrollTo({
			top: targetPosition,
			behavior: 'smooth'
		});


		resumeTimer = window.setTimeout(() => {

			let lastScrollY = window.scrollY;


			resumeScrollHandler = () => {

				const currentScrollY =
					window.scrollY;

				const isScrollingUp =
					currentScrollY < lastScrollY;

				const descriptionTop =
					target.getBoundingClientRect().top;


				if (
					isScrollingUp &&
					descriptionTop > window.innerHeight
				) {

					collectionSection?.dispatchEvent(
						new CustomEvent(
							'collection:resume-infinite'
						)
					);


					window.removeEventListener(
						'scroll',
						resumeScrollHandler
					);

					resumeScrollHandler = null;

				}


				lastScrollY = currentScrollY;

			};


			window.addEventListener(
				'scroll',
				resumeScrollHandler,
				{
					passive: true
				}
			);

		}, 800);

	});

})();

(() => {

		const initialiseCollectionFilters = (container = document) => {

			container
				.querySelectorAll('[data-collection-filters]')
				.forEach((section) => {

					if (section.dataset.collectionFiltersInitialised === 'true') {
						return;
					}

					const form = section.querySelector('[data-filter-form]');

					if (!form) {
						return;
					}

					const filterTrigger = section.querySelector('[data-filter-trigger]');
					const filterPanel = section.querySelector('[data-filter-panel]');
					const filterDrawer = section.querySelector('[data-filter-drawer]');
					const filterDrawerPanel = section.querySelector('[data-filter-drawer-panel]');
					const filterDrawerCloseButtons = section.querySelectorAll('[data-filter-drawer-close]');
					const sortSelect = section.querySelector('[data-sort-select]');
					const mobileSort = section.querySelector('[data-mobile-sort]');
					const priceMinInput = section.querySelector('[data-price-min-input]');
					const priceMaxInput = section.querySelector('[data-price-max-input]');
					const priceOptions = section.querySelectorAll('[data-price-option]');
					const priceDropdown = section.querySelector('[data-price-dropdown]');
					const gridToggles = section.querySelectorAll('[data-grid-toggle]');

					const normalisePrice = (value) => {

						if (value === null || value === '') {
							return '';
						}

						const number = Number(value);

						return Number.isFinite(number)
							? String(number)
							: String(value);

					};

					const updatePriceInput = (input, value) => {

						if (!input) {
							return;
						}

						input.value = value;
						input.disabled = value === '';

					};

					const getPriceResultCount = async (option) => {

						if (!priceMinInput || !priceMaxInput) {
							return null;
						}

						const url = new URL(window.location.href);

						url.searchParams.delete('page');
						url.searchParams.delete('section_id');
						url.searchParams.delete(priceMinInput.name);
						url.searchParams.delete(priceMaxInput.name);

						url.searchParams.set(
							priceMinInput.name,
							normalisePrice(option.dataset.priceMin)
						);

						url.searchParams.set(
							priceMaxInput.name,
							normalisePrice(option.dataset.priceMax)
						);

						url.searchParams.set('section_id', section.id);

						const response = await fetch(
							`${url.pathname}${url.search}`,
							{
								headers: {
									'X-Requested-With': 'XMLHttpRequest'
								}
							}
						);

						if (!response.ok) {
							return null;
						}

						const html = await response.text();

						const nextDocument = new DOMParser().parseFromString(
							html,
							'text/html'
						);

						const nextSection = nextDocument.querySelector(
							'[data-collection-filters]'
						);

						if (!nextSection) {
							return null;
						}

						const count = Number(
							nextSection.dataset.productCount
						);

						return Number.isFinite(count)
							? count
							: null;

					};


					const loadPriceCounts = async () => {

						if (
							!priceDropdown ||
							priceDropdown.dataset.priceCountsState === 'loading' ||
							priceDropdown.dataset.priceCountsState === 'loaded'
						) {
							return;
						}

						const options = Array.from(priceOptions);

						if (!options.length) {
							return;
						}

						priceDropdown.dataset.priceCountsState = 'loading';

						let optionIndex = 0;

						const loadNextOption = async () => {

							while (optionIndex < options.length) {

								const option = options[optionIndex];
								optionIndex += 1;

								const optionWrapper = option.closest(
									'.collection-filters__option'
								);

								const countElement = optionWrapper?.querySelector(
									'[data-price-count]'
								);

								optionWrapper?.classList.add('is-loading');

								try {

									const count = await getPriceResultCount(
										option
									);

									if (count === null) {
										continue;
									}

									if (countElement) {
										countElement.textContent = `(${count})`;
									}

									const shouldDisable =
										count === 0 &&
										!option.checked;

									option.disabled = shouldDisable;

									optionWrapper?.classList.toggle(
										'is-disabled',
										shouldDisable
									);

								} catch (error) {

									console.error(error);

								} finally {

									optionWrapper?.classList.remove(
										'is-loading'
									);

								}

							}

						};

						const workerCount = Math.min(
							4,
							options.length
						);

						await Promise.all(
							Array.from(
								{ length: workerCount },
								() => loadNextOption()
							)
						);

						priceDropdown.dataset.priceCountsState = 'loaded';

					};


					const submitFilters = () => {
						form.requestSubmit();
					};

					section
						.querySelectorAll('[data-filter-input]')
						.forEach((input) => {
							input.addEventListener('change', submitFilters);
						});

					if (sortSelect) {
						sortSelect.addEventListener('change', submitFilters);
					}

					if (mobileSort && sortSelect) {

						mobileSort.addEventListener('change', () => {
							sortSelect.value = mobileSort.value;
							submitFilters();
						});

					}

					const openFilterDrawer = () => {

						if (!filterDrawer) {
							return;
						}

						section.classList.add('is-filter-drawer-open');
						filterDrawer.setAttribute('aria-hidden', 'false');
						filterDrawer.inert = false;
						filterTrigger?.setAttribute('aria-expanded', 'true');
						document.documentElement.classList.add('collection-filter-drawer-open');

						requestAnimationFrame(() => {
							filterDrawerPanel
								?.querySelector('[data-filter-drawer-close]')
								?.focus();
						});

					};

					const closeFilterDrawer = (restoreFocus = true) => {

						if (!filterDrawer) {
							return;
						}

						section.classList.remove('is-filter-drawer-open');
						filterDrawer.setAttribute('aria-hidden', 'true');
						filterDrawer.inert = true;
						filterTrigger?.setAttribute('aria-expanded', 'false');
						document.documentElement.classList.remove('collection-filter-drawer-open');

						if (restoreFocus) {
							filterTrigger?.focus();
						}

					};

					if (filterTrigger && filterPanel) {

						filterTrigger.addEventListener('click', () => {

							if (filterDrawer) {
								openFilterDrawer();
								return;
							}

							const isOpen = section.classList.toggle('is-filter-open');

							filterTrigger.setAttribute(
								'aria-expanded',
								isOpen ? 'true' : 'false'
							);

						});

					}

					filterDrawerCloseButtons.forEach((button) => {
						button.addEventListener('click', () => closeFilterDrawer());
					});

					if (filterDrawer) {

						filterDrawer.addEventListener('keydown', (event) => {

							if (event.key !== 'Tab') {
								return;
							}

							const focusableElements = Array.from(
								filterDrawer.querySelectorAll(
									'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), details > summary, [tabindex]:not([tabindex="-1"])'
								)
							).filter((element) => element.offsetParent !== null);

							if (!focusableElements.length) {
								return;
							}

							const firstElement = focusableElements[0];
							const lastElement = focusableElements[focusableElements.length - 1];

							if (event.shiftKey && document.activeElement === firstElement) {
								event.preventDefault();
								lastElement.focus();
							} else if (!event.shiftKey && document.activeElement === lastElement) {
								event.preventDefault();
								firstElement.focus();
							}

						});

					}

					gridToggles.forEach((button) => {

						button.addEventListener('click', () => {

							const target = button.dataset.gridTarget;
							const columns = button.dataset.gridColumns;

							if (!target || !columns) {
								return;
							}

							section.style.setProperty(
								`--products-${target}`,
								columns
							);

							section
								.querySelectorAll(
									`[data-grid-toggle][data-grid-target="${target}"]`
								)
								.forEach((toggle) => {

									const isActive =
										toggle === button;

									toggle.classList.toggle(
										'is-active',
										isActive
									);

									toggle.setAttribute(
										'aria-pressed',
										isActive ? 'true' : 'false'
									);

								});

						});

					});


					const currentUrl = new URL(window.location.href);

					const currentPriceMin = priceMinInput
						? normalisePrice(
							currentUrl.searchParams.get(priceMinInput.name)
						)
						: '';

					const currentPriceMax = priceMaxInput
						? normalisePrice(
							currentUrl.searchParams.get(priceMaxInput.name)
						)
						: '';

					updatePriceInput(priceMinInput, currentPriceMin);
					updatePriceInput(priceMaxInput, currentPriceMax);

					priceOptions.forEach((option) => {

						const optionMin = normalisePrice(option.dataset.priceMin);
						const optionMax = normalisePrice(option.dataset.priceMax);

						option.checked =
							optionMin === currentPriceMin &&
							optionMax === currentPriceMax;

						option.addEventListener('change', () => {

							if (option.checked) {

								priceOptions.forEach((otherOption) => {

									if (otherOption !== option) {
										otherOption.checked = false;
									}

								});

								updatePriceInput(priceMinInput, optionMin);
								updatePriceInput(priceMaxInput, optionMax);

							} else {

								updatePriceInput(priceMinInput, '');
								updatePriceInput(priceMaxInput, '');

							}

							submitFilters();

						});

					});


					if (priceDropdown) {

						priceDropdown.addEventListener(
							'toggle',
							() => {

								if (!priceDropdown.open) {
									return;
								}

								loadPriceCounts();

							}
						);

					}

					section.dataset.collectionFiltersInitialised = 'true';

				});

		};

		initialiseCollectionFilters();


		if (!window.collectionFiltersOutsideClickInitialised) {

			document.addEventListener(
				'click',
				(event) => {

					document
						.querySelectorAll(
							'[data-collection-filters] .collection-filters__dropdown[open]'
						)
						.forEach((dropdown) => {

							if (!dropdown.contains(event.target)) {
								dropdown.removeAttribute('open');
							}

						});

				}
			);


			document.addEventListener(
				'keydown',
				(event) => {

					if (event.key !== 'Escape') {
						return;
					}

					const openDrawer = document.querySelector(
						'[data-filter-drawer][aria-hidden="false"]'
					);

					if (openDrawer) {
						openDrawer
							.querySelector('[data-filter-drawer-close]')
							?.click();
					}

					document
						.querySelectorAll(
							'[data-collection-filters] .collection-filters__dropdown[open]'
						)
						.forEach((dropdown) => {
							dropdown.removeAttribute('open');
						});

				}
			);


			window.collectionFiltersOutsideClickInitialised = true;

		}


		document.addEventListener(
			'shopify:section:load',
			(event) => initialiseCollectionFilters(event.target)
		);

	})();

