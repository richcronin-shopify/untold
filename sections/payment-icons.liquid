{{- 'payment-options.css' | asset_url | stylesheet_tag -}}
{%- assign ss = section.settings -%}

<section class="payment-options" id="{{ section.id }}">
	<div class="container">
		<div class="payment-options__inner">

			<div class="payment-options__intro">
				{%- if ss.title != blank -%}
					<p class="payment-options__title h5">{{ ss.title }}</p>
				{%- endif -%}

				{%- if ss.description != blank -%}
					<div class="payment-options__description">
						{{ ss.description }}
					</div>
				{%- endif -%}
			</div>

			{%- if section.blocks.size > 0 -%}
				<div class="payment-options__items">

					{%- for block in section.blocks -%}
						{%- assign bs = block.settings -%}

						<div class="payment-options__item" {{ block.shopify_attributes }}>
							{%- if bs.image != blank -%}
								<div class="payment-options__icon">
									{{
										bs.image
										| image_url: width: 240
										| image_tag:
											loading: 'lazy',
											widths: '100, 150, 200, 240',
											sizes: '120px',
											alt: bs.image.alt
									}}
								</div>
							{%- endif -%}

							<div class="payment-options__content">
								{%- if bs.title != blank -%}
									<p class="payment-options__item-title h6">{{ bs.title }}</p>
								{%- endif -%}

								{%- if bs.description != blank -%}
									<div class="payment-options__item-description">
										{{ bs.description }}
									</div>
								{%- endif -%}
							</div>
						</div>

					{%- endfor -%}

				</div>
			{%- endif -%}

			{%- if ss.button_label != blank and ss.button_url != blank -%}
				<div class="payment-options__cta">
					<a href="{{ ss.button_url }}" class="payment-options__cta-link">
						<span>{{ ss.button_label }}</span>

						<span class="payment-options__cta-arrow" aria-hidden="true">
							{{- 'icon-long-arrow.svg' | inline_asset_content -}}
						</span>
					</a>
				</div>
			{%- endif -%}

		</div>
	</div>
</section>

{%- style -%}

	#{{ section.id }} {
		padding-top: {{ ss.padding-top }}px;
		padding-bottom: {{ ss.padding-bottom }}px;
	}

	@media screen and (max-width: 750px) {

		#{{ section.id }} {
			padding-top: {{ ss.padding-top-m }}px;
			padding-bottom: {{ ss.padding-bottom-m }}px;
		}

	}

{%- endstyle -%}

{% schema %}
{
	"name": "Payment options",
	"tag": "section",
	"class": "payment-options-section",
	"settings": [
		{
			"type": "text",
			"id": "title",
			"label": "Title",
			"default": "Ride now. Pay your way."
		},
		{
			"type": "inline_richtext",
			"id": "description",
			"label": "Description",
			"default": "Interest-free options available at checkout"
		},
		{
			"type": "text",
			"id": "button_label",
			"label": "Button label",
			"default": "Learn more"
		},
		{
			"type": "url",
			"id": "button_url",
			"label": "Button link"
		},
		{
			"type": "header",
			"content": "Padding (desktop)"
		},
		{
			"type": "range",
			"id": "padding-top",
			"min": 0,
			"max": 300,
			"step": 5,
			"label": "Padding top",
			"default": 0
		},
		{
			"type": "range",
			"id": "padding-bottom",
			"min": 0,
			"max": 300,
			"step": 5,
			"label": "Padding bottom",
			"default": 0
		},
		{
			"type": "header",
			"content": "Padding (mobile)"
		},
		{
			"type": "range",
			"id": "padding-top-m",
			"min": 0,
			"max": 300,
			"step": 5,
			"label": "Padding top",
			"default": 0
		},
		{
			"type": "range",
			"id": "padding-bottom-m",
			"min": 0,
			"max": 300,
			"step": 5,
			"label": "Padding bottom",
			"default": 0
		}
	],
	"blocks": [
		{
			"type": "payment",
			"name": "Payment option",
			"settings": [
				{
					"type": "image_picker",
					"id": "image",
					"label": "Image"
				},
				{
					"type": "text",
					"id": "title",
					"label": "Title",
					"default": "Pay in 3"
				},
				{
					"type": "inline_richtext",
					"id": "description",
					"label": "Description",
					"default": "Interest-free"
				}
			]
		}
	],
	"max_blocks": 6,
	"presets": [
		{
			"name": "Payment options",
			"blocks": [
				{ "type": "payment" },
				{ "type": "payment" },
				{ "type": "payment" }
			]
		}
	]
}
{% endschema %}