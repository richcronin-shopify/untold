{{- 'skatepark.css' | asset_url | stylesheet_tag -}}
{{- 'product-slider.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'skatepark-finder.js' | asset_url }}" defer="defer"></script>
{%- assign ss = section.settings -%}
{%- assign regions = ss.regions | newline_to_br | replace: '<br />', ',' | split: ',' -%}
{%- assign park_types = ss.park_types | newline_to_br | replace: '<br />', '|' | split: '|' -%}
{%- assign park_settings = ss.park_settings | newline_to_br | replace: '<br />', '|' | split: '|' -%}
{%- capture placeholder_url -%}{% render 'skatepark-placeholder-url', image: ss.placeholder_image, url: ss.placeholder_url, width: 640 %}{%- endcapture -%}
{%- assign placeholder_url = placeholder_url | strip -%}

{%- liquid
  assign fav_handles = ''
  if customer and customer.metafields.untold.favourite_parks.value != blank
    for item in customer.metafields.untold.favourite_parks.value
      if item.system.handle != blank
        assign fav_handles = fav_handles | append: item.system.handle | append: ','
      endif
    endfor
  endif
  assign fav_csv = ',' | append: fav_handles

  assign view_all_url = ss.popular_view_all_link
  if view_all_url == blank
    if pages['skateparks-finder-uk'] != blank
      assign view_all_url = pages['skateparks-finder-uk'].url
    else
      assign view_all_url = '/pages/skateparks-uk'
    endif
  endif

  assign popular_parks = ss.popular_parks
  assign popular_count = 0
  if popular_parks != blank
    assign popular_count = popular_parks.size
  endif

  assign region_priority = 'South East,South West,East of England,East Midlands,London,Yorkshire and The Humber,North West,West Midlands,Scotland,Wales,North East,Northern Ireland,Channel Islands,Isle of Man' | split: ','
  assign ordered_regions_str = ''
  assign seen = '|'

  for r in region_priority
    assign r_clean = r | strip
    assign in_settings = false
    for s in regions
      assign s_clean = s | strip
      if s_clean == r_clean
        assign in_settings = true
        break
      endif
    endfor
    if in_settings
      assign ordered_regions_str = ordered_regions_str | append: r_clean | append: '|'
      assign seen = seen | append: r_clean | append: '|'
    endif
  endfor

  for s in regions
    assign s_clean = s | strip
    if s_clean != blank
      assign needle = '|' | append: s_clean | append: '|'
      unless seen contains needle
        assign ordered_regions_str = ordered_regions_str | append: s_clean | append: '|'
        assign seen = seen | append: s_clean | append: '|'
      endunless
    endif
  endfor

  assign ordered_regions = ordered_regions_str | split: '|'
-%}

{%- liquid
  assign visible_limit = 3
  assign region_total = 0
  for r in ordered_regions
    if r != blank
      assign region_total = region_total | plus: 1
    endif
  endfor
  assign region_rest_count = region_total | minus: visible_limit
  if region_rest_count < 0
    assign region_rest_count = 0
  endif

  assign visible_regions_str = ''
  assign rest_regions_str = ''
  assign region_idx = 0
  for r in ordered_regions
    if r != blank
      assign region_idx = region_idx | plus: 1
      if region_idx <= visible_limit
        assign visible_regions_str = visible_regions_str | append: r | append: '|'
      else
        assign rest_regions_str = rest_regions_str | append: r | append: '|'
      endif
    endif
  endfor
  assign visible_regions = visible_regions_str | split: '|'
  assign rest_regions = rest_regions_str | split: '|'

  assign hero_url = ''
  if ss.hero_image != blank
    assign hero_url = ss.hero_image | image_url: width: 2000
  endif
-%}

<section
  class="skateparks-index"
  id="{{ section.id }}"
  data-skateparks-index
  data-per-page="{{ ss.per_page }}"
  data-placeholder="{{ placeholder_url | escape }}"
  data-logged-in="{% if customer %}true{% else %}false{% endif %}"
  data-endpoint="/apps/parks"
  data-login-url="{{ routes.account_login_url | escape }}"
  data-register-url="{{ routes.account_register_url | escape }}"
  data-favourites="{{ fav_handles | escape }}"
>
  <div class="skateparks-index__hero"{% if hero_url != blank %} style="--hero-image: url({{ hero_url | escape }});"{% endif %}>
    <div class="container">

      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol class="breadcrumbs__list" role="list">
          <li class="breadcrumbs__item"><a href="{{ routes.root_url }}" class="breadcrumbs__link">Home</a></li>
          <li class="breadcrumbs__item"><span class="breadcrumbs__separator" aria-hidden="true">/</span><span class="breadcrumbs__current" aria-current="page">{{ ss.title | escape }}</span></li>
        </ol>
      </nav>

      <header class="skateparks-index__header">
        <h1 class="skateparks-index__title h2">{{ ss.title | escape }}</h1>
        {%- if ss.intro != blank -%}<div class="skateparks-index__intro rte">{{ ss.intro }}</div>{%- endif -%}
      </header>

      <form class="skateparks-index__filters" role="search" data-sp-form>
        <div class="skateparks-index__field skateparks-index__field--search">
          <label for="{{ section.id }}-q" class="skateparks-index__label">
            <span class="skateparks-index__label-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            </span>
            Search
          </label>
          <input type="search" id="{{ section.id }}-q" name="q" placeholder="Park name, town or postcode" autocomplete="off" data-sp-q>
        </div>
        <div class="skateparks-index__field">
          <label for="{{ section.id }}-region" class="skateparks-index__label">
            <span class="skateparks-index__label-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.2"/></svg>
            </span>
            Region
          </label>
          <select id="{{ section.id }}-region" name="region" data-sp-region>
            <option value="">All regions</option>
            {%- for r in regions -%}
              {%- assign r_clean = r | strip -%}
              {%- if r_clean != blank -%}<option value="{{ r_clean | escape }}">{{ r_clean | escape }}</option>{%- endif -%}
            {%- endfor -%}
          </select>
        </div>
        <div class="skateparks-index__field skateparks-index__field--county">
          <label for="{{ section.id }}-county" class="skateparks-index__label">County / area</label>
          <select id="{{ section.id }}-county" name="county" data-sp-county disabled>
            <option value="">All counties</option>
          </select>
        </div>
        <div class="skateparks-index__field">
          <label for="{{ section.id }}-type" class="skateparks-index__label">
            <span class="skateparks-index__label-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M3 19V5c6 0 10 6 18 14H3z"/></svg>
            </span>
            Park type
          </label>
          <select id="{{ section.id }}-type" name="type" data-sp-type>
            <option value="">All park types</option>
            {%- for t in park_types -%}
              {%- assign t_clean = t | strip -%}
              {%- if t_clean != blank -%}<option value="{{ t_clean | escape }}">{{ t_clean | escape }}</option>{%- endif -%}
            {%- endfor -%}
          </select>
        </div>
        <div class="skateparks-index__field">
          <label for="{{ section.id }}-setting" class="skateparks-index__label">
            <span class="skateparks-index__label-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"/></svg>
            </span>
            Setting
          </label>
          <select id="{{ section.id }}-setting" name="setting" data-sp-setting>
            <option value="">All settings</option>
            {%- for s in park_settings -%}
              {%- assign s_clean = s | strip -%}
              {%- if s_clean != blank -%}<option value="{{ s_clean | escape }}">{{ s_clean | escape }}</option>{%- endif -%}
            {%- endfor -%}
          </select>
        </div>
        <button type="submit" class="skateparks-index__search-btn" data-sp-search>Search parks</button>
      </form>

    </div>
  </div>

  <div class="container">

    <div class="skateparks-index__overview">
    <div class="skateparks-index__stats" role="list">
      <div class="skateparks-index__stat" role="listitem">
        <span class="skateparks-index__stat-icon" aria-hidden="true">
          {% render 'skatepark-stat-icon', icon: ss.stat_total_icon, image: ss.stat_total_icon_image %}
        </span>
        <span class="skateparks-index__stat-text">
          <span class="skateparks-index__stat-value" data-sp-stat="total">—</span>
          <span class="skateparks-index__stat-label">{{ ss.stat_total_label | default: 'Parks listed' | escape }}</span>
        </span>
      </div>
      <div class="skateparks-index__stat" role="listitem">
        <span class="skateparks-index__stat-icon" aria-hidden="true">
          {% render 'skatepark-stat-icon', icon: ss.stat_regions_icon, image: ss.stat_regions_icon_image %}
        </span>
        <span class="skateparks-index__stat-text">
          <span class="skateparks-index__stat-value" data-sp-stat="regions">—</span>
          <span class="skateparks-index__stat-label">{{ ss.stat_regions_label | default: 'UK regions' | escape }}</span>
        </span>
      </div>
      <div class="skateparks-index__stat" role="listitem">
        <span class="skateparks-index__stat-icon" aria-hidden="true">
          {% render 'skatepark-stat-icon', icon: ss.stat_types_icon, image: ss.stat_types_icon_image %}
        </span>
        <span class="skateparks-index__stat-text">
          <span class="skateparks-index__stat-value" data-sp-stat="types">—</span>
          <span class="skateparks-index__stat-label">{{ ss.stat_types_label | default: 'Park types' | escape }}</span>
        </span>
      </div>
      <div class="skateparks-index__stat" role="listitem">
        <span class="skateparks-index__stat-icon" aria-hidden="true">
          {% render 'skatepark-stat-icon', icon: ss.stat_outdoor_icon, image: ss.stat_outdoor_icon_image %}
        </span>
        <span class="skateparks-index__stat-text">
          <span class="skateparks-index__stat-value" data-sp-stat="outdoor">—</span>
          <span class="skateparks-index__stat-label">{{ ss.stat_outdoor_label | default: 'Outdoor spots' | escape }}</span>
        </span>
      </div>
    </div>

    <div class="skateparks-index__browse">
      <h2 class="skateparks-index__browse-label">Browse by region</h2>
      <div class="skateparks-index__pills" role="group" aria-label="Browse by region">
        <button type="button" class="skateparks-index__pill is-active" data-sp-region-pill="" aria-pressed="true">All UK</button>
        {%- for r in visible_regions -%}
          {%- if r != blank -%}
            <button type="button" class="skateparks-index__pill" data-sp-region-pill="{{ r | escape }}" aria-pressed="false">{{ r | escape }}</button>
          {%- endif -%}
        {%- endfor -%}
        {%- if region_rest_count > 0 -%}
          <button type="button" class="skateparks-index__pill skateparks-index__pill--more" data-sp-region-more data-count="{{ region_rest_count }}" aria-expanded="false">+{{ region_rest_count }}</button>
          <span class="skateparks-index__pill-rest" data-sp-region-rest hidden>
            {%- for r in rest_regions -%}
              {%- if r != blank -%}
                <button type="button" class="skateparks-index__pill" data-sp-region-pill="{{ r | escape }}" aria-pressed="false">{{ r | escape }}</button>
              {%- endif -%}
            {%- endfor -%}
          </span>
        {%- endif -%}
      </div>
    </div>
    </div>

    <div class="skateparks-index__types">
      <h2 class="skateparks-index__types-label visually-hidden">Park type</h2>
      <div class="skateparks-index__pills" role="group" aria-label="Park type">
        <button type="button" class="skateparks-index__pill is-active" data-sp-type-pill="" aria-pressed="true">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="4" width="6" height="6"/><rect x="14" y="4" width="6" height="6"/><rect x="4" y="14" width="6" height="6"/><rect x="14" y="14" width="6" height="6"/></svg>
          All
        </button>
        <button type="button" class="skateparks-index__pill" data-sp-type-pill="skatepark" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 19V5c6 0 10 6 18 14H3z"/></svg>
          Skatepark
        </button>
        <button type="button" class="skateparks-index__pill" data-sp-type-pill="plaza" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20V10h6V5h10v15"/><path d="M7 13h2M7 16h2M14 8h2M17 8h2M14 11h2M17 11h2M14 14h2M17 14h2"/><path d="M4 20h16"/></svg>
          Street Plaza
        </button>
        <button type="button" class="skateparks-index__pill" data-sp-type-pill="track" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 18c2-7 5-7 6.5-2C11 8 14 7 16 13c1-5 3-6 5 5"/></svg>
          Track/Dirt jumps
        </button>
        <button type="button" class="skateparks-index__pill" data-sp-type-pill="pump" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 16c2.5-6 4.5-6 7 0s4.5 6 7 0 4.5-6 4 0"/></svg>
          Pump track
        </button>
      </div>
    </div>

    {%- if popular_count > 0 or request.design_mode -%}
      <div class="product-slider park-slider skateparks-index__popular" data-sp-popular>
        <div class="product-slider__header">
          <div class="product-slider__intro">
            {%- if ss.popular_title != blank -%}
              <h2 class="product-slider__title h5">{{ ss.popular_title | escape }}</h2>
            {%- endif -%}
            {%- if ss.popular_subheading != blank -%}
              <p class="product-slider__subheading">{{ ss.popular_subheading | escape }}</p>
            {%- endif -%}
          </div>
          <div class="product-slider__controls">
            {%- if ss.show_popular_view_all and view_all_url != blank -%}
              <a href="{{ view_all_url }}" class="product-slider__view-all">View all parks</a>
            {%- endif -%}
            <div class="product-slider__navigation">
              <button type="button" class="swiper-slider__arrow swiper-slider__arrow--prev button--reset" aria-label="Previous parks">
                {{- 'icon-long-arrow.svg' | inline_asset_content -}}
              </button>
              <button type="button" class="swiper-slider__arrow swiper-slider__arrow--next button--reset" aria-label="Next parks">
                {{- 'icon-long-arrow.svg' | inline_asset_content -}}
              </button>
            </div>
          </div>
        </div>
        {%- if popular_count > 0 -%}
          <div class="swiper product-slider__swiper" data-sp-popular-swiper>
            <div class="swiper-wrapper">
              {%- for park in popular_parks -%}
                {%- assign is_fav = false -%}
                {%- if park.system.handle != blank -%}
                  {%- assign fav_needle = ',' | append: park.system.handle | append: ',' -%}
                  {%- if fav_csv contains fav_needle -%}
                    {%- assign is_fav = true -%}
                  {%- endif -%}
                {%- endif -%}
                <div class="product-slider__item swiper-slide">
                  {% render 'skatepark-card', park: park, index: forloop.index, placeholder: placeholder_url, show_bookmark: true, is_favourite: is_fav %}
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- elsif request.design_mode -%}
          <p class="skateparks-index__intro rte">Choose parks in the theme editor to show them here.</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div data-sp-results-anchor class="skateparks-index__results-head">
      <p class="skateparks-index__count" data-sp-count></p>
      <div class="skateparks-index__chips" data-sp-chips></div>
      <button type="button" class="skateparks-index__reset" data-sp-reset hidden>Clear all</button>
      <div class="skateparks-index__results-tools">
        <label for="{{ section.id }}-sort" class="visually-hidden">Sort parks</label>
        <select id="{{ section.id }}-sort" data-sp-sort class="skateparks-index__sort">
          <option value="az">A–Z</option>
          <option value="za">Z–A</option>
          <option value="near">Near me</option>
        </select>
        <div class="skateparks-index__view-toggle" role="group" aria-label="View">
          <button type="button" class="skateparks-index__view-btn button--reset is-active" data-sp-view="list" aria-pressed="true">Grid</button>
          <button type="button" class="skateparks-index__view-btn button--reset" data-sp-view="map" aria-pressed="false">Map</button>
        </div>
      </div>
      <p class="skateparks-index__status" data-sp-status aria-live="polite"></p>
    </div>

    <div class="skateparks-index__map-wrap" data-sp-map-wrap hidden>
      <div class="skateparks-index__map" data-sp-map role="region" aria-label="Map of skateparks"></div>
    </div>

    <div data-sp-list>
      <div class="skateparks-index__results" data-sp-results hidden>
        <div class="skateparks-index__grid" data-sp-results-grid></div>
        <div class="skateparks-index__more">
          <button type="button" class="button" data-sp-more hidden>Show more parks</button>
        </div>
      </div>

      <div data-sp-server>
        {%- paginate shop.metaobjects.skatepark.values by ss.per_page -%}
          <p class="skateparks-index__count" data-sp-server-count>{{ paginate.items }} parks</p>
          <div class="skateparks-index__grid">
            {%- for park in shop.metaobjects.skatepark.values -%}
              {%- assign is_fav = false -%}
              {%- if park.system.handle != blank -%}
                {%- assign fav_needle = ',' | append: park.system.handle | append: ',' -%}
                {%- if fav_csv contains fav_needle -%}
                  {%- assign is_fav = true -%}
                {%- endif -%}
              {%- endif -%}
              {% render 'skatepark-card', park: park, index: forloop.index, placeholder: placeholder_url, show_bookmark: true, is_favourite: is_fav %}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="skateparks-index__pagination" aria-label="Pagination">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}" class="skateparks-index__page skateparks-index__page--prev" aria-label="Previous page">&larr;</a>
              {%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}" class="skateparks-index__page">{{ part.title }}</a>
                {%- elsif part.title == paginate.current_page -%}
                  <span class="skateparks-index__page is-current" aria-current="page">{{ part.title }}</span>
                {%- else -%}
                  <span class="skateparks-index__page skateparks-index__page--gap">{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}" class="skateparks-index__page skateparks-index__page--next" aria-label="Next page">&rarr;</a>
              {%- endif -%}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    </div>

  </div>

  <span class="skateparks-index__arrow-template" data-sp-arrow-icon hidden aria-hidden="true">
    {{- 'icon-long-arrow.svg' | inline_asset_content -}}
  </span>

  <div class="skateparks-auth-modal" data-sp-auth-modal hidden role="dialog" aria-modal="true" aria-labelledby="{{ section.id }}-auth-title">
    <div class="skateparks-auth-modal__panel">
      <button type="button" class="skateparks-auth-modal__close" data-sp-auth-close aria-label="Close">&times;</button>
      <h2 class="skateparks-auth-modal__title" id="{{ section.id }}-auth-title">Save parks you like</h2>
      <p class="skateparks-auth-modal__text">Create an account to bookmark parks and find them later.</p>
      <div class="skateparks-auth-modal__actions">
        <a class="skateparks-auth-modal__register" data-sp-auth-register href="{{ routes.account_register_url }}">Create account</a>
        <a class="skateparks-auth-modal__login" data-sp-auth-login href="{{ routes.account_login_url }}">Log in</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Skateparks index",
  "tag": "div",
  "class": "main-skateparks-index-section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "UK skateparks" },
    { "type": "richtext", "id": "intro", "label": "Intro text" },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "Shown behind the title and search bar. A wide photo works best."
    },
    { "type": "range", "id": "per_page", "min": 12, "max": 48, "step": 12, "label": "Parks per page", "default": 24 },
    { "type": "header", "content": "Popular parks" },
    {
      "type": "text",
      "id": "popular_title",
      "label": "Popular parks heading",
      "default": "Popular parks"
    },
    {
      "type": "text",
      "id": "popular_subheading",
      "label": "Popular parks subheading"
    },
    {
      "type": "metaobject_list",
      "id": "popular_parks",
      "label": "Popular parks",
      "info": "Choose a short list of parks to show above the results. This row is hidden until you pick some.",
      "metaobject_type": "skatepark",
      "limit": 12
    },
    {
      "type": "checkbox",
      "id": "show_popular_view_all",
      "label": "Show 'View all parks' link",
      "default": true
    },
    {
      "type": "url",
      "id": "popular_view_all_link",
      "label": "View all parks link",
      "info": "Leave blank to use the skateparks finder page."
    },
    { "type": "header", "content": "Stats" },
    { "type": "text", "id": "stat_total_label", "label": "Total parks label", "default": "Parks listed" },
    { "type": "text", "id": "stat_regions_label", "label": "Regions label", "default": "UK regions" },
    { "type": "text", "id": "stat_types_label", "label": "Park types label", "default": "Park types" },
    { "type": "text", "id": "stat_outdoor_label", "label": "Outdoor spots label", "default": "Outdoor spots" },
    { "type": "header", "content": "Stat icons" },
    { "type": "paragraph", "content": "Each statistic uses a built-in outline icon. A custom image overrides the selected icon." },
    {
      "type": "select",
      "id": "stat_total_icon",
      "label": "Total parks icon",
      "options": [
          { "value": "ramp", "label": "Ramp" },
          { "value": "pin", "label": "Map pin" },
          { "value": "layers", "label": "Layers" },
          { "value": "mountain", "label": "Mountain" },
          { "value": "sneaker", "label": "Sneaker" },
