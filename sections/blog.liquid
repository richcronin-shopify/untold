{{- 'main-blog.css' | asset_url | stylesheet_tag -}}
{%- assign ss = section.settings -%}

<section class="main-blog" id="{{ section.id }}">
	<div class="container">

		<header class="main-blog__header">
			<nav class="breadcrumbs main-blog__breadcrumbs" aria-label="Breadcrumb">
				<ol class="breadcrumbs__list" role="list">
					<li class="breadcrumbs__item">
						<a href="{{ routes.root_url }}" class="breadcrumbs__link">Home</a>
					</li>
					<li class="breadcrumbs__item">
						<span class="breadcrumbs__separator" aria-hidden="true">/</span>
						<span class="breadcrumbs__current" aria-current="page">{{ blog.title }}</span>
					</li>
				</ol>
			</nav>

			<h1 class="main-blog__title">{{ blog.title }}</h1>

			{%- if ss.intro != blank -%}
				<div class="main-blog__intro rte">
					{{ ss.intro }}
				</div>
			{%- endif -%}
		</header>

		{%- paginate blog.articles by 100 -%}

			{%- if blog.articles.size > 0 -%}
				<div class="main-blog__grid main-blog__grid--desktop-{{ ss.columns_desktop }}">

					{%- for article in blog.articles -%}
						{%- liquid
							assign card_excerpt = article.excerpt | strip_html | strip
							if card_excerpt == blank
								assign card_excerpt = article.content | strip_html | strip
							endif
							assign card_loading = 'lazy'
							if forloop.index <= 4
								assign card_loading = 'eager'
							endif
						-%}

						<article class="blog-card">
							<a href="{{ article.url }}" class="blog-card__link" aria-label="{{ article.title | escape }}"></a>

							<div class="blog-card__media">
								{%- if article.image -%}
									{{
										article.image
										| image_url: width: 900
										| image_tag:
											class: 'blog-card__image',
											loading: card_loading,
											widths: '375, 550, 750, 900',
											sizes: '(min-width: 990px) 33vw, (min-width: 768px) 50vw, 100vw',
											alt: article.image.alt | default: article.title
									}}
								{%- else -%}
									<div class="blog-card__placeholder" aria-hidden="true"></div>
								{%- endif -%}
							</div>

							<div class="blog-card__content">
								{%- if ss.show_date -%}
									<p class="blog-card__meta">
										{{ article.published_at | time_tag: format: 'date' }}
										{%- if ss.show_author and article.author != blank %} &middot; {{ article.author }}{% endif -%}
									</p>
								{%- endif -%}

								<h2 class="blog-card__title h6">{{ article.title }}</h2>

								{%- if ss.show_excerpt and card_excerpt != blank -%}
									<p class="blog-card__excerpt">{{ card_excerpt | truncatewords: ss.excerpt_words }}</p>
								{%- endif -%}

								{%- if ss.link_label != blank -%}
									<span class="blog-card__more">{{ ss.link_label | escape }}</span>
								{%- endif -%}
							</div>
						</article>
					{%- endfor -%}

				</div>
			{%- else -%}
				<p class="main-blog__empty">No posts yet. Check back soon.</p>
			{%- endif -%}

			{%- if paginate.pages > 1 -%}
				<div class="main-blog__pagination">
					{{- paginate | default_pagination -}}
				</div>
			{%- endif -%}

		{%- endpaginate -%}

	</div>
</section>

{%- style -%}
	#{{ section.id }} {
		padding-bottom: {{ ss.padding-bottom }}px;
	}
	@media screen and (max-width: 750px) {
		#{{ section.id }} {
			padding-bottom: {{ ss.padding-bottom-m }}px;
		}
	}
{%- endstyle -%}

{% schema %}
{
	"name": "Blog",
	"tag": "section",
	"class": "main-blog-section",
	"settings": [
		{
			"type": "richtext",
			"id": "intro",
			"label": "Intro"
		},
		{
			"type": "header",
			"content": "Post grid"
		},
		{
			"type": "select",
			"id": "columns_desktop",
			"label": "Posts per row on desktop",
			"options": [
				{"value": "3", "label": "3"},
				{"value": "4", "label": "4"}
			],
			"default": "3",
			"info": "Tablets show 2 per row and mobile shows 1."
		},
		{
			"type": "checkbox",
			"id": "show_date",
			"label": "Show date",
			"default": true
		},
		{
			"type": "checkbox",
			"id": "show_author",
			"label": "Show author",
			"default": false
		},
		{
			"type": "checkbox",
			"id": "show_excerpt",
			"label": "Show excerpt",
			"default": true
		},
		{
			"type": "range",
			"id": "excerpt_words",
			"min": 10,
			"max": 50,
			"step": 5,
			"label": "Excerpt length (words)",
			"default": 25
		},
		{
			"type": "text",
			"id": "link_label",
			"label": "Link label",
			"default": "Read more"
		},
		{
			"type": "header",
			"content": "Padding"
		},
		{
			"type": "range",
			"id": "padding-bottom",
			"min": 0,
			"max": 200,
			"step": 5,
			"label": "Padding bottom (desktop)",
			"default": 80
		},
		{
			"type": "range",
			"id": "padding-bottom-m",
			"min": 0,
			"max": 200,
			"step": 5,
			"label": "Padding bottom (mobile)",
			"default": 50
		}
	]
}
{% endschema %}
