  <script>
    (() => {
      /*
        Launch time:
        30 October 2026 at 00:00 UK time.
        The +01:00 offset is British Summer Time on this date.
      */
      const launchTime = new Date("2026-10-30T00:00:00+01:00").getTime();

      const elements = {
        days: document.querySelector("[data-days]"),
        hours: document.querySelector("[data-hours]"),
        minutes: document.querySelector("[data-minutes]"),
        seconds: document.querySelector("[data-seconds]"),
        status: document.querySelector("[data-countdown-status]")
      };

      const pad = (value) => String(value).padStart(2, "0");

      const updateCountdown = () => {
        const remaining = Math.max(launchTime - Date.now(), 0);

        const days = Math.floor(remaining / 86400000);
        const hours = Math.floor((remaining % 86400000) / 3600000);
        const minutes = Math.floor((remaining % 3600000) / 60000);
        const seconds = Math.floor((remaining % 60000) / 1000);

        elements.days.textContent = pad(days);
        elements.hours.textContent = pad(hours);
        elements.minutes.textContent = pad(minutes);
        elements.seconds.textContent = pad(seconds);

        elements.status.textContent = remaining === 0
          ? "Untold BMX is now live."
          : `${days} days, ${hours} hours, ${minutes} minutes and ${seconds} seconds until launch.`;

        if (remaining === 0 && timer !== null) {
          window.clearInterval(timer);
          timer = null;
        }
      };

      let timer = null;
      updateCountdown();

      if (Date.now() < launchTime) {
        timer = window.setInterval(updateCountdown, 1000);
      }
    })();
  </script>

