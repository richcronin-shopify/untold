{%- assign ss = section.settings -%}
{{- 'bike-size-table.css' | asset_url | stylesheet_tag -}}

<section class="bmx-size-table" id="{{ section.id }}">
	<div class="container">

		{%- if ss.title != blank or ss.intro != blank -%}
			<div class="bmx-size-table__header">

				{%- if ss.title != blank -%}
					<h2 class="bmx-size-table__title h2">
						{{ ss.title }}
					</h2>
				{%- endif -%}

				{%- if ss.intro != blank -%}
					<div class="bmx-size-table__intro rte">
						{{ ss.intro }}
					</div>
				{%- endif -%}

			</div>
		{%- endif -%}

		<div class="bmx-size-table__table">

			<div class="bmx-size-table__head" aria-hidden="true">
				<div class="bmx-size-table__head-cell">
					Wheel size
				</div>

				<div class="bmx-size-table__head-cell">
					Approx age
				</div>

				<div class="bmx-size-table__head-cell">
					Rider height
				</div>

				<div class="bmx-size-table__head-cell">
					Recommended for
				</div>
			</div>

			<div class="bmx-size-table__body">

				{%- for block in section.blocks -%}
					{%- assign bs = block.settings -%}

					<div class="bmx-size-table__row" {{ block.shopify_attributes }}>

						<div class="bmx-size-table__cell bmx-size-table__cell--size">
							<span class="bmx-size-table__mobile-label">
								Wheel size
							</span>

							<div class="bmx-size-table__size-wrap">

								{%- if bs.wheel_size != blank -%}
									<div class="bmx-size-table__wheel-size h3">
										{{ bs.wheel_size }}
									</div>
								{%- endif -%}

								{%- if bs.image != blank -%}
									<div class="bmx-size-table__image">
										{{
											bs.image
											| image_url: width: 500
											| image_tag:
												loading: 'lazy',
												widths: '160, 240, 320, 400, 500',
												sizes: '(max-width: 767px) 180px, 220px',
												alt: bs.image.alt
										}}
									</div>
								{%- endif -%}

							</div>
						</div>

						<div class="bmx-size-table__cell">
							<span class="bmx-size-table__mobile-label">
								Approx age
							</span>

							{%- if bs.age != blank -%}
								<div class="bmx-size-table__value">
									{{ bs.age }}
								</div>
							{%- endif -%}
						</div>

						<div class="bmx-size-table__cell">
							<span class="bmx-size-table__mobile-label">
								Rider height
							</span>

							{%- if bs.height_metric != blank -%}
								<div class="bmx-size-table__value">
									{{ bs.height_metric }}
								</div>
							{%- endif -%}

							{%- if bs.height_imperial != blank -%}
								<div class="bmx-size-table__subvalue">
									{{ bs.height_imperial }}
								</div>
							{%- endif -%}
						</div>

						<div class="bmx-size-table__cell bmx-size-table__cell--recommendation">
							<span class="bmx-size-table__mobile-label">
								Recommended for
							</span>

							{%- if bs.recommended_for != blank -%}
								<div class="bmx-size-table__recommendation">
									{{ bs.recommended_for }}
								</div>
							{%- endif -%}
						</div>

					</div>

				{%- endfor -%}

			</div>

		</div>

		{%- if ss.button_intro != blank or ss.button_label != blank -%}

			<div class="page__cta"> 

				{%- if ss.button_intro != blank -%}
					<div class="page__cta-intro">
						{{ ss.button_intro }}
					</div>
				{%- endif -%}

				{%- if ss.button_label != blank and ss.button_link != blank -%}
					<a href="{{ ss.button_link }}" class="button button--outline page__cta-button">
						{{ ss.button_label }}
					</a>
				{%- endif -%}

			</div>

		{%- endif -%}

	</div>
</section>

{% schema %}
{
	"name": "BMX size table",
	"settings": [
		{
			"type": "text",
			"id": "title",
			"label": "Title",
			"default": "BMX bike sizes"
		},
		{
			"type": "richtext",
			"id": "intro",
			"label": "Intro text",
			"default": "<p>Use our size guide to find the BMX that best suits the rider.</p>"
		},
		{
			"type": "header",
			"content": "Contact button"
		},
		{
			"type": "richtext",
			"id": "button_intro",
			"label": "Button intro text",
			"default": "<p>Still can’t find what you’re looking for?<br>Please contact us below</p>"
		},
		{
			"type": "text",
			"id": "button_label",
			"label": "Button label",
			"default": "Contact us"
		},
		{
			"type": "url",
			"id": "button_link",
			"label": "Button link"
		}
	],
	"blocks": [
