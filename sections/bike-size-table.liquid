					"default": "11+ years / adult"
				},
				{
					"type": "text",
					"id": "height_metric",
					"label": "Rider height",
					"default": "120 cm+"
				},
				{
					"type": "text",
					"id": "height_imperial",
					"label": "Rider height - imperial",
					"default": "4'0\"+"
				},
				{
					"type": "richtext",
					"id": "recommended_for",
					"label": "Recommended for",
					"default": "<p>Standard size for teens and adults.</p>"
				}
			]
		}
	],
	"presets": [
