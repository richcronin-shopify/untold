{{- 'hero.css' | asset_url | stylesheet_tag -}}
{%- assign ss = section.settings -%}

<section
	id="HeroSlider-{{ section.id }}"
	class="hero-slider"
	data-hero-slider
	data-autoplay="{{ ss.autoplay }}"
	data-autoplay-delay="{{ ss.autoplay_delay | times: 1000 }}"
>

	<div class="swiper hero-slider__swiper">

		<div class="swiper-wrapper">

			{%- for block in section.blocks -%}

				{%- assign bs = block.settings -%}

				{%- liquid
					assign desktop_image = bs.image_desktop
					assign mobile_image = bs.image_mobile

					if desktop_image == blank
						assign desktop_image = mobile_image
					endif

					if mobile_image == blank
						assign mobile_image = desktop_image
					endif

					assign image_alt = desktop_image.alt

					if image_alt == blank
						assign image_alt = bs.heading
					endif

					if forloop.first
						assign image_loading = 'eager'
						assign image_fetchpriority = 'high'
					else
						assign image_loading = 'lazy'
						assign image_fetchpriority = 'auto'
					endif
				-%}

				<div
					class="swiper-slide hero-slider__slide"
					{{ block.shopify_attributes }}
				>

					{%- if desktop_image != blank -%}

						<div class="hero-slider__media">

							<picture>

								{%- if mobile_image != blank -%}

									<source
										media="(max-width: 749px)"
										srcset="
											{{ mobile_image | image_url: width: 375 }} 375w,
											{{ mobile_image | image_url: width: 550 }} 550w,
											{{ mobile_image | image_url: width: 750 }} 750w,
											{{ mobile_image | image_url: width: 1000 }} 1000w
										"
										sizes="100vw"
									>

								{%- endif -%}

								{{
									desktop_image
									| image_url: width: 2400
									| image_tag:
										class: 'hero-slider__image',
										loading: image_loading,
										fetchpriority: image_fetchpriority,
										widths: '750, 1000, 1200, 1600, 2000, 2400',
										sizes: '100vw',
										alt: image_alt
								}}

							</picture>

						</div>

					{%- endif -%}


					<div class="hero-slider__content-wrapper">

						<div class="container">

							<div class="hero-slider__content">

								{%- if bs.eyebrow != blank -%}

									<p class="hero-slider__eyebrow">
										{{ bs.eyebrow }}
									</p>

								{%- endif -%}


								{%- if bs.heading != blank -%}

									<h{{bs.heading_tag}} class="h{{bs.font_size}} hero-slider__heading">
										{{ bs.heading }}
									</h{{bs.heading_tag}}>

								{%- endif -%}


								{%- if bs.text != blank -%}

									<div class="hero-slider__text">

										<span class="hero-slider__status" aria-hidden="true">
											{{- 'icon-circle-check.svg' | inline_asset_content -}}
										</span>

										<div>
											{{ bs.text }}
										</div>

									</div>

								{%- endif -%}


								{%- if bs.button_label != blank and bs.button_url != blank -%}

									<div class="hero-slider__button">
										<a
											href="{{ bs.button_url }}"
											class="{{ bs.button_style }}"
										>
											{{ bs.button_label }}
										</a>
									</div>

								{%- endif -%}

							</div>

						</div>

					</div>

				</div>

			{%- endfor -%}

		</div>


		{%- if section.blocks.size > 1 -%}

			{%- if ss.show_arrows -%}

				<div class="hero-slider__navigation">

					<button
						type="button"
						class="hero-slider__arrow hero-slider__arrow--prev"
						aria-label="Previous slide"
					>
						{{- 'icon-chev.svg' | inline_asset_content -}}
					</button>

					<button
						type="button"
						class="hero-slider__arrow hero-slider__arrow--next"
						aria-label="Next slide"
					>
						{{- 'icon-chev.svg' | inline_asset_content -}}
					</button>

				</div>

			{%- endif -%}


			{%- if ss.show_pagination -%}

				<div
					class="hero-slider__pagination swiper-pagination"
				></div>

			{%- endif -%}

		{%- endif -%}

	</div>

</section>


{% javascript %}

	(() => {

		const initialiseHeroSliders = () => {

			if (typeof Swiper === 'undefined') {
				return;
			}


			document
				.querySelectorAll('[data-hero-slider]')
				.forEach((section) => {

					if (section.dataset.initialised === 'true') {
						return;
					}


					const swiperElement = section.querySelector(
						'.hero-slider__swiper'
					);

					if (!swiperElement) {
						return;
					}


					const autoplayEnabled =
						section.dataset.autoplay === 'true';

					const autoplayDelay =
						parseInt(
							section.dataset.autoplayDelay,
							10
						) || 5000;


					const previousButton = section.querySelector(
						'.hero-slider__arrow--prev'
					);

					const nextButton = section.querySelector(
						'.hero-slider__arrow--next'
					);

					const pagination = section.querySelector(
						'.hero-slider__pagination'
					);


					new Swiper(swiperElement, {

						slidesPerView: 1,

						speed: 600,

						loop: swiperElement.querySelectorAll(
							'.swiper-slide'
						).length > 1,

						watchOverflow: true,

						autoplay: autoplayEnabled
							? {
								delay: autoplayDelay,
								disableOnInteraction: false
							}
							: false,

						navigation: previousButton && nextButton
							? {
								prevEl: previousButton,
								nextEl: nextButton
							}
							: false,

						pagination: pagination
							? {
								el: pagination,
								clickable: true
							}
							: false,

						a11y: {
							enabled: true
						}

					});


					section.dataset.initialised = 'true';

				});

		};


		initialiseHeroSliders();


		window.addEventListener(
			'load',
			initialiseHeroSliders
		);


		document.addEventListener(
			'shopify:section:load',
			initialiseHeroSliders
		);

	})();

{% endjavascript %}


{% schema %}
{
	"name": "Hero slider",
	"tag": "section",
	"class": "hero-slider-section",
	"settings": [
		{
			"type": "checkbox",
			"id": "autoplay",
			"default": false,
			"label": "Autoplay"
		},
		{
			"type": "range",
			"id": "autoplay_delay",
			"min": 3,
			"max": 10,
			"step": 1,
			"unit": "s",
			"default": 5,
			"label": "Autoplay delay"
		},
		{
			"type": "checkbox",
			"id": "show_arrows",
			"default": true,
			"label": "Show arrows"
		},
		{
			"type": "checkbox",
			"id": "show_pagination",
			"default": true,
			"label": "Show pagination"
		}
	],
	"blocks": [
		{
			"type": "slide",
			"name": "Slide",
			"settings": [
				{
					"type": "image_picker",
					"id": "image_desktop",
					"label": "Desktop image"
				},
				{
					"type": "image_picker",
					"id": "image_mobile",
					"label": "Mobile image"
				},
				{
					"type": "text",
					"id": "eyebrow",
					"label": "Eyebrow",
					"default": "New in!"
				},
				{
					"type": "text",
					"id": "heading",
					"label": "Heading",
					"default": "Kink Feral Frame Drop"
				},
				{
		            "type": "range",
		            "id": "heading_tag",
		            "min": 1,
		            "max": 6,
		            "step": 1,
		            "label": "Title heading tag",
		            "info": "Header tags, also known as heading tags, are used to separate headings and subheadings on a webpage. They rank in order of importance, from H1 to H6, with H1s usually being the title. Header tags improve the readability and SEO of a webpage.",
		            "default": 6
		        },
		        {
		            "type": "range",
		            "id": "font_size",
		            "min": 1,
		            "max": 6,
		            "step": 1,
		            "label": "Font size",
		            "info": "1 being the largest. 6 being the smallest.",
		            "default": 4
		        },
				{
					"type": "inline_richtext",
					"id": "text",
					"label": "Text",
					"default": "<strong>From £349.99</strong> · Ready to dispatch"
				},
				{
					"type": "text",
					"id": "button_label",
					"label": "Button label",
					"default": "Shop now"
				},
				{
					"type": "url",
					"id": "button_url",
					"label": "Button link"
				},
				{
		            "type": "select",
		            "id": "button_style",
		            "options": [
		                { "value": "button", "label": "Filled"},
		                { "value": "button button--outline", "label": "Outline"}
		            ],
		            "label": "Button style",
		            "default": "button"
		        }
			]
		}
	],
	"max_blocks": 6,
	"presets": [
		{
			"name": "Hero slider",
			"blocks": [
				{
					"type": "slide"
				}
			]
		}
	]
}
{% endschema %}