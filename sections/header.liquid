{%- assign ss = section.settings -%}

<header
	class="site-header"
	data-header
	data-section-id="{{ section.id }}"
>

	{%- if section.blocks.size > 0 -%}
		<div class="announcement-bar">

			<div class="announcement-bar__inner container">

				{%- for block in section.blocks -%}
					{%- assign bs = block.settings -%}

					{%- case block.type -%}
						{%- when 'announcement' -%}

							{%- if bs.title != blank -%}

								<div
									class="announcement-bar__item"
									{{ block.shopify_attributes }}
								>

									{%- if bs.url != blank -%}
										<a href="{{ bs.url }}">
									{%- endif -%}

										{{- bs.title -}}

									{%- if bs.url != blank -%}
										</a>
									{%- endif -%}

								</div>

							{%- endif -%}

					{%- endcase -%}
				{%- endfor -%}

			</div>

		</div>
	{%- endif -%}


	<div class="site-header__main">

		<div class="container site-header__inner">

			{%- comment -%}
				Mobile menu toggle
			{%- endcomment -%}

			<button
				type="button"
				class="site-header__menu-toggle"
				aria-label="Open menu"
				aria-expanded="false"
				aria-controls="site-navigation-{{ section.id }}"
				data-menu-toggle
			>
				<span></span>
				<span></span>
				<span></span>
			</button>


			{%- comment -%}
				Logo
			{%- endcomment -%}

			<a
				href="{{ routes.root_url }}"
				class="site-header__logo"
				aria-label="{{ shop.name | escape }}"
			>
				{{- 'web-logo.svg' | inline_asset_content -}}
			</a>


			{%- comment -%}
				One navigation tree for desktop + mobile
			{%- endcomment -%}

			{%- if ss.menu != blank -%}

				<nav
					id="site-navigation-{{ section.id }}"
					class="site-navigation"
					aria-label="Main navigation"
					data-navigation
				>

					<div
						class="site-navigation__overlay"
						data-menu-close
					></div>


					<div class="site-navigation__drawer">

						<ul class="site-navigation__root">

							{%- for link in ss.menu.links -%}

								{%- assign level_1_index = forloop.index -%}
								{%- assign link_title_downcase = link.title | downcase -%}

								<li
									class="
										site-navigation__item site-navigation__item--level-1
										{% if link.links != blank %}has-children{% endif %}
										{% if link.active %}is-active{% endif %}
										{% if link_title_downcase == 'sale' %}is-sale{% endif %}
									"
								>

									<a
										href="{{ link.url }}"
										class="site-navigation__link site-navigation__link--level-1"
										{% if link.links != blank %}
											data-nav-target="nav-{{ section.id }}-{{ level_1_index }}"
										{% endif %}
									>

										<span>
											{{ link.title }}
										</span>

										{%- if link.links != blank -%}
											<span
												class="site-navigation__arrow"
												aria-hidden="true"
											>
												→
											</span>
										{%- endif -%}

									</a>


									{%- if link.links != blank -%}

										<div
											id="nav-{{ section.id }}-{{ level_1_index }}"
											class="site-navigation__panel site-navigation__panel--level-2"
											data-nav-panel
										>

											<button
												type="button"
												class="site-navigation__back"
												data-nav-back
											>
												<span
													class="site-navigation__back-arrow"
													aria-hidden="true"
												>
													←
												</span>

												<span>
													Back to {{ link.title }}
												</span>
											</button>


											<div class="site-navigation__mega">

												<ul class="site-navigation__columns">

													{%- for child_link in link.links -%}

														{%- assign level_2_index = forloop.index -%}

														<li
															class="
																site-navigation__column
																{% if child_link.links != blank %}has-children{% endif %}
															"
														>

															<a
																href="{{ child_link.url }}"
																class="site-navigation__heading"
																{% if child_link.links != blank %}
																	data-nav-target="nav-{{ section.id }}-{{ level_1_index }}-{{ level_2_index }}"
																{% endif %}
															>

																<span>
																	{{ child_link.title }}
																</span>

																{%- if child_link.links != blank -%}
																	<span
																		class="site-navigation__arrow"
																		aria-hidden="true"
																	>
																		→
																	</span>
																{%- endif -%}

															</a>


															{%- if child_link.links != blank -%}

																<div
																	id="nav-{{ section.id }}-{{ level_1_index }}-{{ level_2_index }}"
																	class="site-navigation__panel site-navigation__panel--level-3"
																	data-nav-panel
																>

																	<button
																		type="button"
																		class="site-navigation__back"
																		data-nav-back
																	>

																		<span
																			class="site-navigation__back-arrow"
																			aria-hidden="true"
																		>
																			←
																		</span>

																		<span>
																			Back to {{ child_link.title }}
																		</span>

																	</button>


																	<ul class="site-navigation__links">

																		{%- for grandchild_link in child_link.links -%}

																			{%- assign grandchild_title_downcase = grandchild_link.title | downcase -%}
																			{%- assign is_view_all = false -%}

																			{%- if grandchild_title_downcase contains 'view all'
																				or grandchild_title_downcase contains 'all sizes'
																			-%}
																				{%- assign is_view_all = true -%}
																			{%- endif -%}

																			<li
																				class="
																					site-navigation__item
																					site-navigation__item--level-3
																					{% if is_view_all %}is-view-all{% endif %}
																				"
																			>

																				<a
																					href="{{ grandchild_link.url }}"
																					class="site-navigation__link site-navigation__link--level-3"
																				>
																					{{ grandchild_link.title }}
																				</a>

																			</li>

																		{%- endfor -%}

																	</ul>

																</div>

															{%- endif -%}

														</li>

													{%- endfor -%}

												</ul>

											</div>

										</div>

									{%- endif -%}

								</li>

							{%- endfor -%}

						</ul>


						{%- if ss.mobile_footer_menu != blank -%}

							<nav
								class="site-navigation__footer"
								aria-label="Additional navigation"
							>

								<ul>

									{%- for footer_link in ss.mobile_footer_menu.links -%}

										<li>
											<a href="{{ footer_link.url }}">
												{{ footer_link.title }}
											</a>
										</li>

									{%- endfor -%}

								</ul>

							</nav>

						{%- endif -%}

					</div>

				</nav>

			{%- endif -%}


			{%- comment -%}
				Header controls
			{%- endcomment -%}

			<div class="site-header__controls">

				<a
					href="{{ routes.search_url }}"
					class="site-header__control site-header__control--search"
					aria-label="Search"
				>
					{{- 'icon-search.svg' | inline_asset_content -}}
				</a>


				<a
					href="{{ routes.account_url }}"
					class="site-header__control site-header__control--account"
					aria-label="Account"
				>
					{{- 'icon-account.svg' | inline_asset_content -}}
				</a>


				<a
					href="{{ routes.cart_url }}"
					class="site-header__control site-header__control--cart"
					aria-label="Cart"
				>

					{{- 'icon-cart.svg' | inline_asset_content -}}

					<span
						class="site-header__cart-count"
						data-cart-count
						{% if cart.item_count == 0 %}
							hidden
						{% endif %}
					>
						{{ cart.item_count }}
					</span>

				</a>

			</div>

		</div>

	</div>

</header>


{% javascript %}

	class HeaderNavigation {
		constructor(header) {
			this.header = header;

			this.navigation = header.querySelector('[data-navigation]');
			this.toggle = header.querySelector('[data-menu-toggle]');
			this.closeButtons = header.querySelectorAll('[data-menu-close]');

			this.panelLinks = header.querySelectorAll('[data-nav-target]');
			this.backButtons = header.querySelectorAll('[data-nav-back]');
			this.panels = header.querySelectorAll('[data-nav-panel]');

			this.mobileQuery = window.matchMedia('(max-width: 989px)');

			this.activePanels = [];

			this.bindEvents();
		}


		bindEvents() {

			this.toggle?.addEventListener('click', () => {

				if (this.navigation.classList.contains('is-open')) {
					this.close();
				} else {
					this.open();
				}

			});


			this.closeButtons.forEach((button) => {

				button.addEventListener('click', () => {
					this.close();
				});

			});


			this.panelLinks.forEach((link) => {

				link.addEventListener('click', (event) => {

					if (!this.mobileQuery.matches) {
						return;
					}

					const targetId = link.dataset.navTarget;
					const target = this.header.querySelector(`#${targetId}`);

					if (!target) {
						return;
					}

					event.preventDefault();

					this.openPanel(target);

				});

			});


			this.backButtons.forEach((button) => {

				button.addEventListener('click', () => {

					if (!this.mobileQuery.matches) {
						return;
					}

					const panel = button.closest('[data-nav-panel]');

					if (!panel) {
						return;
					}

					this.closePanel(panel);

				});

			});


			document.addEventListener('keydown', (event) => {

				if (
					event.key === 'Escape' &&
					this.navigation?.classList.contains('is-open')
				) {
					this.close();
				}

			});


			this.mobileQuery.addEventListener('change', (event) => {

				if (!event.matches) {
					this.reset();
				}

			});

		}


		open() {

			this.navigation.classList.add('is-open');

			this.toggle?.setAttribute(
				'aria-expanded',
				'true'
			);

			document.documentElement.classList.add(
				'menu-open'
			);

		}


		close() {

			this.navigation.classList.remove('is-open');

			this.toggle?.setAttribute(
				'aria-expanded',
				'false'
			);

			document.documentElement.classList.remove(
				'menu-open'
			);


			window.setTimeout(() => {
				this.resetPanels();
			}, 250);

		}


		openPanel(panel) {

			panel.classList.add('is-active');

			this.activePanels.push(panel);

		}


		closePanel(panel) {

			panel.classList.remove('is-active');

			this.activePanels = this.activePanels.filter(
				(activePanel) => activePanel !== panel
			);

		}


		resetPanels() {

			this.panels.forEach((panel) => {
				panel.classList.remove('is-active');
			});

			this.activePanels = [];

		}


		reset() {

			this.navigation?.classList.remove('is-open');

			this.toggle?.setAttribute(
				'aria-expanded',
				'false'
			);

			document.documentElement.classList.remove(
				'menu-open'
			);

			this.resetPanels();

		}
	}


	const initialiseHeaderNavigation = () => {

		document
			.querySelectorAll('[data-header]')
			.forEach((header) => {

				if (header.dataset.navigationInitialised === 'true') {
					return;
				}

				header.dataset.navigationInitialised = 'true';

				new HeaderNavigation(header);

			});

	};


	initialiseHeaderNavigation();


	document.addEventListener(
		'shopify:section:load',
		initialiseHeaderNavigation
	);

{% endjavascript %}


{% schema %}
{
	"name": "Header",
	"tag": "section",
	"class": "header-section",
	"settings": [
		{
			"type": "link_list",
			"id": "menu",
			"label": "Main menu"
		},
		{
			"type": "link_list",
			"id": "mobile_footer_menu",
			"label": "Mobile footer menu",
			"info": "Used for secondary links such as My Account, Contact, Delivery Information and Returns Policy."
		}
	],
	"blocks": [
		{
			"type": "announcement",
			"name": "Announcement",
			"limit": 3,
			"settings": [
				{
					"type": "text",
					"id": "title",
					"label": "Title"
				},
				{
					"type": "url",
					"id": "url",
					"label": "Link"
				}
			]
		}
	],
	"max_blocks": 3
}
{% endschema %}