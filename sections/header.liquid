{%- assign ss = section.settings -%}

<header>

	<div class="announcement-bar">
		
		{%- for block in section.blocks -%}

			{%- assign bs = block.settings -%}
			{%- case block.type -%}
				{% when 'announcement' %}
				{%- if bs.title != blank -%}
					<div class="announcement-bar--item">
						{%- if bs.url != blank %}<a href="{{ bs.url }}">{% endif -%}
							{{- bs.title -}}
						{%- if bs.url != blank %}</a>{% endif -%}
					</div>
				{%- endif -%}
			{%- endcase -%}

		{%- endfor -%}

	</div>
	
	<div class="container">
		
		{% comment %}logo{% endcomment %}

	</div>

</header>

{% schema %}
	{
		"name": "t:general.header",
		"settings": [
			{
				"type": "link_list",
				"id": "menu",
				"label": "t:labels.menu"
			},
			{
				"type": "link_list",
				"id": "customer_account_menu",
				"label": "t:labels.customer_account_menu",
				"default": "customer-account-main-menu"
			}
		],

		"blocks": [
     
	        {
	            "type": "announcement",
	            "name": "Announcement",
	            "settings": [
	                
	                {
	                    "type": "text",
	                    "id": "title",
	                    "label": "Title"
	                },
	                {
	                    "type": "url",
	                    "id": "url",
	                    "label": "URL"
	                }

	            ]

	        }

	    ]
	}
{% endschema %}