{{- 'brand-slider.css' | asset_url | stylesheet_tag -}}

{%- assign ss = section.settings -%}
{%- assign brands = shop.metaobjects.brands.values -%}

<section
  class="brand-slider{% unless ss.enable_carousel %} brand-slider--grid{% endunless %}"
  id="{{ section.id }}"
  data-brand-slider
  data-carousel="{{ ss.enable_carousel }}"
  data-brands-desktop="{{ ss.brands_desktop }}"
  data-brands-tablet="{{ ss.brands_tablet }}"
  data-brands-mobile="{{ ss.brands_mobile }}"
>
  <div class="container">

    <div class="brand-slider__header">

      {%- if ss.title != blank -%}
        <h2 class="brand-slider__title h5">
          {{ ss.title }}
        </h2>
      {%- endif -%}

      {%- if ss.enable_carousel -%}
        <div class="brand-slider__navigation">

          <button
            type="button"
            class="swiper-slider__arrow swiper-slider__arrow--prev button--reset"
            aria-label="Previous brands"
          >
            {{- 'icon-long-arrow.svg' | inline_asset_content -}}
          </button>

          <button
            type="button"
            class="swiper-slider__arrow swiper-slider__arrow--next button--reset"
            aria-label="Next brands"
          >
            {{- 'icon-long-arrow.svg' | inline_asset_content -}}
          </button>

        </div>
      {%- endif -%}

    </div>

    <div class="{% if ss.enable_carousel %}swiper brand-slider__swiper{% else %}brand-slider__grid{% endif %}">

      <div class="{% if ss.enable_carousel %}swiper-wrapper{% else %}brand-slider__items{% endif %}">

        {%- for brand in brands -%}

          {%- liquid
            assign brand_name = brand.brand_name.value
            assign logo = brand.logo.value
            assign collection = brand.collection.value
          -%}

          {%- if logo != blank -%}

            <div
              class="brand-slider__item{% if ss.enable_carousel %} swiper-slide{% endif %}"
              style="--brand-logo-max-width: {{ ss.max_image_width }}px;"
            >

              {%- if collection != blank -%}
                <a
                  href="{{ collection.url }}"
                  class="brand-slider__link"
                  {% if brand_name != blank %}
                    aria-label="{{ brand_name | escape }}"
                  {% endif %}
                >
              {%- else -%}
                <div class="brand-slider__link">
              {%- endif -%}

                {%- assign logo_alt = logo.alt | default: brand_name -%}

                {{
                  logo
                  | image_url: width: 600
                  | image_tag:
                    class: 'brand-slider__logo',
                    loading: 'lazy',
                    widths: '120, 180, 240, 320, 480, 600',
                    sizes: '(min-width: 990px) 240px, (min-width: 768px) 180px, 120px',
                    alt: logo_alt
                }}

              {%- if collection != blank -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}

            </div>

          {%- endif -%}

        {%- endfor -%}

      </div>

      {%- if ss.enable_carousel -%}
        <div class="brand-slider__pagination swiper-pagination"></div>
      {%- endif -%}

    </div>

  </div>
</section>

{%- style -%}

  #{{ section.id }} {
    padding-top: {{ ss.padding-top }}px;
    padding-bottom: {{ ss.padding-bottom }}px;

    --brands-desktop: {{ ss.brands_desktop }};
    --brands-tablet: {{ ss.brands_tablet }};
    --brands-mobile: {{ ss.brands_mobile }};
  }

  @media screen and (max-width: 767px) {

    #{{ section.id }} {
      padding-top: {{ ss.padding-top-m }}px;
      padding-bottom: {{ ss.padding-bottom-m }}px;
    }

  }

{%- endstyle -%}

{% javascript %}

  (() => {

    const initialiseBrandSliders = () => {

      if (typeof Swiper === 'undefined') {
        return;
      }

      document
        .querySelectorAll('[data-brand-slider]')
        .forEach((section) => {

          if (
            section.dataset.carousel !== 'true' ||
            section.dataset.initialised === 'true'
          ) {
            return;
          }

          const swiperElement = section.querySelector(
            '.brand-slider__swiper'
          );

          if (!swiperElement) {
            return;
          }

          const brandsDesktop =
            parseInt(
              section.dataset.brandsDesktop,
              10
            ) || 6;

          const brandsTablet =
            parseInt(
              section.dataset.brandsTablet,
              10
            ) || 4;

          const brandsMobile =
            parseInt(
              section.dataset.brandsMobile,
              10
            ) || 3;

          const previousButton = section.querySelector(
            '.swiper-slider__arrow--prev'
          );

          const nextButton = section.querySelector(
            '.swiper-slider__arrow--next'
          );

          const pagination = section.querySelector(
            '.brand-slider__pagination'
          );

          new Swiper(swiperElement, {

            slidesPerView: brandsMobile,

            spaceBetween: 60,

            watchOverflow: true,

            navigation: previousButton && nextButton
              ? {
                  prevEl: previousButton,
                  nextEl: nextButton
                }
              : false,

            pagination: pagination
              ? {
                  el: pagination,
                  clickable: true,
                  bulletElement: 'button'
                }
              : false,

            breakpoints: {

              768: {
                slidesPerView: brandsTablet
              },

              990: {
                slidesPerView: brandsDesktop
              }

            },

            a11y: {
              enabled: true,
              prevSlideMessage: 'Previous brands',
              nextSlideMessage: 'Next brands',
              paginationBulletMessage: 'Go to brand group {{index}}',
              slideLabelMessage: '{{index}} of {{slidesLength}}'
            }

          });

          section.dataset.initialised = 'true';

        });

    };

    initialiseBrandSliders();

    window.addEventListener(
      'load',
      initialiseBrandSliders
    );

    document.addEventListener(
      'shopify:section:load',
      initialiseBrandSliders
    );

  })();

{% endjavascript %}

{% schema %}
{
  "name": "Brand slider",
  "tag": "section",
  "class": "brand-slider-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Shop by brand"
    },
    {
      "type": "checkbox",
      "id": "enable_carousel",
      "default": true,
      "label": "Enable carousel"
    },
    {
      "type": "range",
      "id": "max_image_width",
      "min": 100,
      "max": 240,
      "step": 10,
      "unit": "px",
      "label": "Logo max width",
      "default": 180
    },
    {
      "type": "header",
      "content": "Brands per row"
    },
    {
      "type": "range",
      "id": "brands_desktop",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Brands shown on desktop",
      "default": 6
    },
    {
      "type": "range",
      "id": "brands_tablet",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Brands shown on tablet",
      "default": 4
    },
    {
      "type": "range",
      "id": "brands_mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Brands shown on mobile",
      "default": 3
    },
    {
      "type": "header",
      "content": "Padding (desktop)"
    },
    {
      "type": "range",
      "id": "padding-top",
      "min": 0,
      "max": 300,
      "step": 5,
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-bottom",
      "min": 0,
      "max": 300,
      "step": 5,
      "label": "Padding bottom",
      "default": 40
    },
    {
      "type": "header",
      "content": "Padding (mobile)"
    },
    {
      "type": "range",
      "id": "padding-top-m",
      "min": 0,
      "max": 300,
      "step": 5,
      "label": "Padding top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding-bottom-m",
      "min": 0,
      "max": 300,
      "step": 5,
      "label": "Padding bottom",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Brand slider"
    }
  ]
}
{% endschema %}