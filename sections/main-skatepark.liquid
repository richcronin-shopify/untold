{{- 'skatepark.css' | asset_url | stylesheet_tag -}}
{%- liquid
  assign ss = section.settings
  assign park = metaobject

  assign index_url = ss.index_url | default: '/pages/skateparks-finder-uk'
  if pages['skateparks-finder-uk'] != blank
    if index_url == blank or index_url == '/pages/skateparks-uk'
      assign index_url = pages['skateparks-finder-uk'].url
    endif
  endif
  assign park_name = park.name.value
  assign town = park.town_city.value
  assign county = park.county_district.value
  assign region = park.region.value
  assign region_enc = region | url_encode

  comment
    Image fallback: park photos -> satellite thumbnail -> "photo coming soon" placeholder.
  endcomment
  assign images = park.thumbnail_image_url.value
  assign image_mode = 'photos'
  if images == blank or images.size == 0
    if park.satellite_thumbnail_url.value != blank
      assign images = park.satellite_thumbnail_url.value | split: '|||'
      assign image_mode = 'satellite'
    else
      assign images = blank
      assign image_mode = 'placeholder'
    endif
  else
    assign first_image = images | first
    if first_image contains 'google.com/vt/'
      assign image_mode = 'satellite'
    endif
  endif
  assign using_satellite = false
  if image_mode == 'satellite'
    assign using_satellite = true
  endif

  if image_mode == 'placeholder'
    capture placeholder_url
      render 'skatepark-placeholder-url', image: ss.placeholder_image, url: ss.placeholder_url, width: 1280
    endcapture
    assign placeholder_url = placeholder_url | strip
  endif

  assign image_alt = park_name
  if town != blank
    assign image_alt = image_alt | append: ', ' | append: town
  endif

  assign lat = park.latitude.value
  assign lng = park.longitude.value
  assign has_geo = false
  if lat != blank and lng != blank
    assign has_geo = true
  endif

  assign credit = park.photo_credit.value
  assign licence = park.photo_licence.value
  assign licence_name = licence
  assign licence_url = ''
  if licence contains 'Google'
    comment
      Google photos already carry "(Google Maps)" in the credit; the terms text is not shown.
    endcomment
    assign licence_name = ''
  endif
  if licence contains '(http'
    assign licence_name = licence | split: ' (' | first
    assign licence_url = licence | split: '(' | last | remove: ')' | strip
  endif

  assign w3w = park.what3words.value | remove: '///' | strip
  assign status = park.verification_status.value

  comment
    Plain-facts summary, labels and park FAQ, built from the park's fields.
    No entry fee or cost data is used here. Default or empty values are skipped.
  endcomment
  assign sp_closed = false
  if status == 'Closed (Graveyard)' or status contains 'Temporarily Closed'
    assign sp_closed = true
  endif

  assign sp_town = town
  if sp_town contains '('
    assign sp_town = sp_town | split: '(' | first | strip
  endif
  assign sp_place = sp_town
  if region != blank and region != sp_town
    if sp_place != blank
      assign sp_place = sp_place | append: ', ' | append: region
    else
      assign sp_place = region
    endif
  endif

  assign sp_setting_raw = park.setting.value
  assign sp_setting = ''
  assign sp_setting_label = ''
  case sp_setting_raw
    when 'Outdoor'
      assign sp_setting = 'outdoor'
      assign sp_setting_label = 'Outdoor'
    when 'Indoor'
      assign sp_setting = 'indoor'
      assign sp_setting_label = 'Indoor'
    when 'Covered / Undercover'
      assign sp_setting = 'covered'
      assign sp_setting_label = 'Covered'
  endcase

  assign sp_surface = park.surface_material.value | remove: 'Mixed (' | remove: ')' | replace: 'Composite / Skatelite', 'Composite' | replace: 'Asphalt / Tarmac', 'Tarmac' | replace: 'Asphalt Berms', 'Asphalt' | replace: ' / ', ', ' | downcase | strip
  if sp_surface contains ', '
    assign sp_surface = sp_surface | replace_last: ', ', ' and '
  endif
  assign sp_surface_label = sp_surface | capitalize

  assign sp_kind = 'skatepark'
  case park.park_type.value
    when 'BMX Track / Dirt Jumps'
      assign sp_kind = 'BMX track and dirt jump spot'
    when 'Pump Track'
      assign sp_kind = 'pump track'
    when 'Mini Ramp'
      assign sp_kind = 'mini ramp'
    when 'Skatepark & Pump / BMX Track'
      assign sp_kind = 'skatepark and pump track'
    when 'Bowl / Pool'
      assign sp_kind = 'skate bowl'
    when 'Multi-Sport Action Park'
      assign sp_kind = 'action sports park'
    when 'Street Plaza'
      assign sp_kind = 'street plaza'
  endcase

  assign sp_flood = park.floodlit.value
  assign sp_light_adj = ''
  assign sp_light_label = ''
  case sp_flood
    when 'Yes'
      assign sp_light_adj = 'floodlit'
      assign sp_light_label = 'Floodlit'
    when 'Partial / Covered'
      assign sp_light_adj = 'partly lit'
      assign sp_light_label = 'Partly lit'
    when 'Indoor (Lit)'
      assign sp_light_label = 'Lit indoors'
  endcase

  # Descriptor without lights, e.g. "outdoor concrete skatepark"
  assign sp_desc = sp_kind
  if sp_surface != blank
    assign sp_desc = sp_surface | append: ' ' | append: sp_desc
  endif
  assign sp_desc_lit = sp_desc
  if sp_light_adj != blank and sp_setting != 'indoor'
    if sp_setting != blank
      assign sp_desc_lit = sp_setting | append: ', ' | append: sp_light_adj | append: ' ' | append: sp_desc
    else
      assign sp_desc_lit = sp_light_adj | append: ' ' | append: sp_desc
    endif
  elsif sp_setting != blank
    assign sp_desc_lit = sp_setting | append: ' ' | append: sp_desc
  endif
  if sp_setting != blank
    assign sp_desc = sp_setting | append: ' ' | append: sp_desc
  endif
  assign sp_ch = sp_desc_lit | slice: 0 | downcase
  assign sp_art_lit = 'a'
  if 'aeiou' contains sp_ch
    assign sp_art_lit = 'an'
  endif
  assign sp_ch = sp_desc | slice: 0 | downcase
  assign sp_art = 'a'
  if 'aeiou' contains sp_ch
    assign sp_art = 'an'
  endif
  assign sp_ch = sp_kind | slice: 0 | downcase
  assign sp_desc_nosetting = sp_kind
  if sp_surface != blank
    assign sp_desc_nosetting = sp_surface | append: ' ' | append: sp_kind
  endif
  assign sp_ch = sp_desc_nosetting | slice: 0 | downcase
  assign sp_art_ns = 'a'
  if 'aeiou' contains sp_ch
    assign sp_art_ns = 'an'
  endif

  # Features with articles: "a bowl, a street section and rollers"
  assign sp_feat_all = ''
  assign sp_feat_five = ''
  assign sp_feat_count = 0
  assign sp_feat_parts = park.features.value | split: ','
  for f in sp_feat_parts
    assign f_raw = f | strip
    if f_raw == blank
      continue
    endif
    assign f_txt = f_raw | downcase | replace: ' / ', '/' | replace: 'bmx', 'BMX' | replace: 'diy', 'DIY'
    assign f_last = f_txt | slice: -1
    assign f_first = f_txt | slice: 0
    if f_last == 's' or f_txt == 'pool coping'
      assign f_item = f_txt
    elsif 'aeiou' contains f_first
      assign f_item = 'an ' | append: f_txt
    else
      assign f_item = 'a ' | append: f_txt
    endif
    assign sp_feat_count = sp_feat_count | plus: 1
    if sp_feat_all == ''
      assign sp_feat_all = f_item
    else
      assign sp_feat_all = sp_feat_all | append: ', ' | append: f_item
    endif
    if sp_feat_count <= 5
      if sp_feat_five == ''
        assign sp_feat_five = f_item
      else
        assign sp_feat_five = sp_feat_five | append: ', ' | append: f_item
      endif
    endif
  endfor
  if sp_feat_all contains ', '
    assign sp_feat_all = sp_feat_all | replace_last: ', ', ' and '
  endif
  if sp_feat_five contains ', '
    assign sp_feat_five = sp_feat_five | replace_last: ', ', ' and '
  endif

  # Facilities, skipping the "Public Park Access" default
  assign sp_fac = ''
  assign sp_fac_parts = park.facilities.value | split: ','
  for fc in sp_fac_parts
    assign fc_raw = fc | strip
    assign fc_txt = ''
    case fc_raw
      when 'Toilet', 'Toilets'
        assign fc_txt = 'toilets'
      when 'Lighting'
        assign fc_txt = 'lighting'
      when 'On-site Cafe', 'Cafe'
        assign fc_txt = 'a café'
      when 'Relaxing Area'
        assign fc_txt = 'a seating area'
      when 'On-site Skate Shop'
        assign fc_txt = 'an on-site skate shop'
      when 'Viewing Area'
        assign fc_txt = 'a viewing area'
      when 'Lockers'
        assign fc_txt = 'lockers'
      when 'Coaching'
        assign fc_txt = 'coaching'
      when 'Bike Hire'
        assign fc_txt = 'bike hire'
      when 'Parking'
        assign fc_txt = 'parking'
    endcase
    if fc_txt != blank
      unless sp_fac contains fc_txt
        if sp_fac == ''
          assign sp_fac = fc_txt
        else
          assign sp_fac = sp_fac | append: ', ' | append: fc_txt
        endif
      endunless
    endif
  endfor
  if sp_fac contains ', '
    assign sp_fac = sp_fac | replace_last: ', ', ' and '
  endif

  # Two-sentence summary
  assign sp_sum1 = ''
  assign sp_sum2 = ''
  assign sp_in = ''
  if sp_place != blank
    assign sp_in = ' in ' | append: sp_place
  endif
  assign sp_in_town = ''
  if sp_town != blank
    assign sp_in_town = ' in ' | append: sp_town
  endif
  if status == 'Closed (Graveyard)'
    assign sp_sum1 = park_name | append: sp_in_town | append: ' has permanently closed.'
    assign sp_sum2 = 'It was ' | append: sp_art | append: ' ' | append: sp_desc | append: ", and we've kept this page for reference only."
  elsif status contains 'Temporarily Closed'
    if status contains 'Construction'
      assign sp_sum1 = park_name | append: sp_in_town | append: ' is temporarily closed for building work.'
    else
      assign sp_sum1 = park_name | append: sp_in_town | append: ' is temporarily closed.'
    endif
    assign sp_sum2 = "It's " | append: sp_art | append: ' ' | append: sp_desc | append: ', so check locally before you travel.'
  else
    assign sp_sum1 = park_name | append: ' is ' | append: sp_art_lit | append: ' ' | append: sp_desc_lit | append: sp_in | append: '.'
    if sp_feat_five != blank
      if sp_feat_count > 5
        assign sp_sum2 = 'Its features include ' | append: sp_feat_five | append: '.'
      else
        assign sp_sum2 = 'It has ' | append: sp_feat_five | append: '.'
      endif
    endif
  endif

  # Opening hours: only real timetables count (not the defaults)
  assign sp_oh = park.opening_hours.value | strip
  assign sp_oh_kind = ''
  assign sp_oh_first = sp_oh | slice: 0, 2
  assign sp_day_codes = 'Mo,Tu,We,Th,Fr,Sa,Su' | split: ','
  if sp_oh == 'Dawn to Dusk / 24h Public Access'
    assign sp_oh_kind = 'default'
  elsif sp_oh == 'Session Times / Pre-Booking Advised'
    assign sp_oh_kind = 'session'
  elsif sp_oh == '24/7'
    assign sp_oh_kind = 'always'
  elsif sp_oh contains ':'
    if sp_day_codes contains sp_oh_first
      assign sp_oh_kind = 'timetable'
      assign sp_oh_parts = sp_oh | split: ';'
      for ohp in sp_oh_parts
        assign ohp_tokens = ohp | strip | split: ' '
        if ohp_tokens.size != 2
          assign sp_oh_kind = 'seasonal'
        endif
      endfor
    else
      assign sp_oh_kind = 'seasonal'
    endif
  endif
  assign sp_oh_text = sp_oh | replace: 'Mo-Su ', 'every day, ' | replace: 'Mo-Fr ', 'Monday to Friday, ' | replace: 'Sa-Su ', 'Saturday and Sunday, ' | replace: 'Apr-Sep ', 'April to September, ' | replace: 'Oct-May ', 'October to May, ' | replace: 'Oct-Mar ', 'October to March, ' | replace: ';', ';'

  # FAQ question/answer pairs, joined with a delimiter
  assign sp_faq_q = ''
  assign sp_faq_a = ''
  assign sp_d = '~~'
  unless sp_closed
    assign sp_bmx = park.bmx_allowed.value
    if sp_bmx != blank
      assign sp_q = 'Can you ride BMX at ' | append: park_name | append: '?'
      if sp_bmx contains 'Session'
        assign sp_a = 'Yes, BMX is allowed at ' | append: park_name | append: ', but check the session times before you go.'
      else
        assign sp_a = 'Yes. BMX is allowed at ' | append: park_name | append: '.'
      endif
      assign sp_others = ''
      assign sp_disc = park.disciplines_supported.value | split: ','
      for dsc in sp_disc
        assign dsc_raw = dsc | strip
        assign dsc_txt = ''
        case dsc_raw
          when 'Skateboard'
            assign dsc_txt = 'skateboarding'
          when 'Scooter'
            assign dsc_txt = 'scooters'
          when 'Inline'
            assign dsc_txt = 'inline skating'
          when 'Quad Skate'
            assign dsc_txt = 'quad skating'
          when 'MTB'
            assign dsc_txt = 'mountain bikes'
          when 'Jump Bike'
            assign dsc_txt = 'jump bikes'
          when 'Balance Bike'
            assign dsc_txt = 'balance bikes'
        endcase
        if dsc_txt != blank
          if sp_others == ''
            assign sp_others = dsc_txt
          else
            assign sp_others = sp_others | append: ', ' | append: dsc_txt
          endif
        endif
      endfor
      if sp_others != blank
        if sp_others contains ', '
          assign sp_others = sp_others | replace_last: ', ', ' and '
        endif
        assign sp_a = sp_a | append: " It's also used for " | append: sp_others | append: '.'
      endif
      case park.skill_levels.value
        when 'All Levels (Beginner to Pro / Training)'
          assign sp_a = sp_a | append: ' It suits riders of all levels, from beginners to pros.'
        when 'All Levels (Beginner, Intermediate, Advanced)'
          assign sp_a = sp_a | append: ' It suits riders of all levels, from beginners to advanced.'
        when 'Beginner, Intermediate'
          assign sp_a = sp_a | append: " It's best suited to beginner and intermediate riders."
      endcase
      assign sp_faq_q = sp_faq_q | append: sp_q | append: sp_d
      assign sp_faq_a = sp_faq_a | append: sp_a | append: sp_d
    endif

    if sp_setting != blank
      assign sp_q = 'Is ' | append: park_name | append: ' indoor or floodlit?'
      if sp_setting == 'indoor'
        assign sp_a = "It's an indoor park, so you can ride whatever the weather."
      else
        if sp_setting == 'covered'
          assign sp_a = "It's covered, so it's sheltered from the rain."
        else
          assign sp_a = "It's an outdoor park."
        endif
        case sp_flood
          when 'Yes'
            assign sp_a = sp_a | append: " It's floodlit, so you can ride after dark, but check locally for when the lights are on."
          when 'Partial / Covered'
            assign sp_a = sp_a | append: ' Part of it is lit or covered.'
          when 'No'
            assign sp_a = sp_a | append: " It isn't listed as floodlit, so plan to ride in daylight."
        endcase
        if park.rain_friendly.value == true and sp_setting != 'covered'
          assign sp_a = sp_a | append: " It's listed as rain-friendly."
        endif
      endif
      assign sp_faq_q = sp_faq_q | append: sp_q | append: sp_d
      assign sp_faq_a = sp_faq_a | append: sp_a | append: sp_d
    endif

    if sp_feat_all != blank
      assign sp_q = "What's at " | append: park_name | append: '?'
      assign sp_a = park_name | append: ' is ' | append: sp_art_ns | append: ' ' | append: sp_desc_nosetting | append: ' with ' | append: sp_feat_all | append: '.'
      if sp_fac != blank
        assign sp_a = sp_a | append: ' Facilities include ' | append: sp_fac | append: '.'
      endif
      if park.builder_designer.value != blank
        assign sp_a = sp_a | append: ' It was built by ' | append: park.builder_designer.value | append: '.'
      endif
      assign sp_faq_q = sp_faq_q | append: sp_q | append: sp_d
      assign sp_faq_a = sp_faq_a | append: sp_a | append: sp_d
    endif

    assign sp_a = ''
    case sp_oh_kind
      when 'timetable', 'seasonal'
        assign sp_a = 'The listed opening hours are ' | append: sp_oh_text | append: '. Times can change, so check with the park before you travel.'
      when 'always'
        assign sp_a = "It's listed as open 24 hours a day, 7 days a week."
      when 'default'
        assign sp_a = "It's in a public space with open access, so you can usually ride there from dawn to dusk. There are no set opening times listed."
      when 'session'
        assign sp_a = "Riding is in set sessions, and booking ahead is advised. Check the park's own website or social pages for current session times."
    endcase
    if sp_a != blank
      assign sp_q = 'When is ' | append: park_name | append: ' open?'
      assign sp_faq_q = sp_faq_q | append: sp_q | append: sp_d
      assign sp_faq_a = sp_faq_a | append: sp_a | append: sp_d
    endif

    assign sp_a = ''
    case park.helmet_required.value
      when 'Yes (Mandatory)'
        assign sp_a = 'Yes. A helmet is required at ' | append: park_name | append: '.'
      when 'Yes (Full Face Recommended)'
        assign sp_a = 'Yes. A helmet is required, and a full-face helmet is recommended.'
      when 'Recommended'
        assign sp_a = "A helmet isn't listed as compulsory, but wearing one is recommended."
    endcase
    if sp_a != blank
      assign sp_q = 'Do you need a helmet at ' | append: park_name | append: '?'
      assign sp_faq_q = sp_faq_q | append: sp_q | append: sp_d
      assign sp_faq_a = sp_faq_a | append: sp_a | append: sp_d
    endif

    assign sp_addr = park.address_line.value | strip
    if sp_addr != blank or sp_town != blank
      assign sp_q = 'Where is ' | append: park_name | append: '?'
      assign sp_a = park_name | append: ' is'
      if sp_addr != blank and sp_addr != town and sp_addr != sp_town
        assign sp_a = sp_a | append: ' at ' | append: sp_addr
        unless sp_addr contains sp_town
          assign sp_a = sp_a | append: ','
        endunless
      endif
      if sp_town != blank
        unless sp_addr contains sp_town
          assign sp_a = sp_a | append: ' in ' | append: sp_town
        endunless
      endif
      if park.postcode.value != blank
        assign sp_a = sp_a | append: ' ' | append: park.postcode.value
      endif
      assign sp_a = sp_a | append: '.'
      if w3w != blank
        assign sp_a = sp_a | append: ' Its what3words address is ///' | append: w3w | append: '.'
      endif
      assign sp_faq_q = sp_faq_q | append: sp_q | append: sp_d
      assign sp_faq_a = sp_faq_a | append: sp_a | append: sp_d
    endif
  endunless
  assign sp_faq_qs = sp_faq_q | split: sp_d
  assign sp_faq_as = sp_faq_a | split: sp_d
  assign sp_maps_url = park.google_maps_url.value
  if sp_maps_url == blank and has_geo
    assign sp_maps_url = 'https://www.google.com/maps/search/?api=1&query=' | append: lat | append: ',' | append: lng
  endif
-%}

<section class="skatepark" id="{{ section.id }}">
  <div class="container">

    <nav class="breadcrumbs skatepark__breadcrumbs" aria-label="Breadcrumb">
      <ol class="breadcrumbs__list" role="list">
        <li class="breadcrumbs__item"><a href="{{ routes.root_url }}" class="breadcrumbs__link">Home</a></li>
        <li class="breadcrumbs__item"><span class="breadcrumbs__separator" aria-hidden="true">/</span><a href="{{ index_url }}" class="breadcrumbs__link">{{ ss.index_label | default: 'Skateparks' | escape }}</a></li>
        {%- if region != blank -%}
          <li class="breadcrumbs__item"><span class="breadcrumbs__separator" aria-hidden="true">/</span><a href="{{ index_url }}?region={{ region_enc }}" class="breadcrumbs__link">{{ region | escape }}</a></li>
        {%- endif -%}
        <li class="breadcrumbs__item"><span class="breadcrumbs__separator" aria-hidden="true">/</span><span class="breadcrumbs__current" aria-current="page">{{ park_name | escape }}</span></li>
      </ol>
    </nav>

    <header class="skatepark__header">
      <h1 class="skatepark__title h2">{{ park_name | escape }}</h1>
      {%- if town != blank or county != blank -%}
        <p class="skatepark__subtitle">
          {{- town | escape -}}
          {%- if county != blank and county != town -%}{% if town != blank %}, {% endif %}{{ county | escape }}{%- endif -%}
        </p>
      {%- endif -%}
      {%- if status != blank and status != 'Verified Active' -%}
        {%- liquid
          assign status_label = status
          if status == 'Closed (Graveyard)'
            assign status_label = 'Permanently closed'
          elsif status contains 'Temporarily Closed'
            assign status_label = 'Temporarily closed'
            if status contains 'Construction'
              assign status_label = 'Temporarily closed for building work'
            endif
          endif
        -%}
        <p class="skatepark__status" role="status">{{ status_label | escape }}</p>
      {%- endif -%}
      {%- if ss.show_summary and sp_sum1 != blank -%}
        <div class="skatepark-summary">
          <p class="skatepark-summary__text">{{ sp_sum1 | escape }}{% if sp_sum2 != blank %} {{ sp_sum2 | escape }}{% endif %}</p>
          {%- if sp_setting_label != blank or sp_surface_label != blank or sp_light_label != blank -%}
            <ul class="skatepark-chips skatepark-summary__labels" role="list" aria-label="Park at a glance">
              {%- if sp_setting_label != blank -%}<li class="skatepark-chip">{{ sp_setting_label | escape }}</li>{%- endif -%}
              {%- if sp_surface_label != blank -%}<li class="skatepark-chip">{{ sp_surface_label | escape }}</li>{%- endif -%}
              {%- if sp_light_label != blank -%}<li class="skatepark-chip">{{ sp_light_label | escape }}</li>{%- endif -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if ss.show_park_actions and customer -%}
        <div
          class="untold-parks untold-parks--actions"
          data-untold-parks
          data-endpoint="/apps/parks"
          data-logged-in="{% if customer %}true{% else %}false{% endif %}"
          data-login-url="{{ routes.account_login_url }}"
          data-park-handle="{{ park.system.handle | escape }}"
        >
          {% render 'untold-park-actions', park: park %}
        </div>
      {%- endif -%}
      {%- unless customer -%}
      		<p class="untold-parks--login">
      			<a href="/account">Login or create a free account to save spots.</a>
      		</p>
      {%- endunless -%}
    </header>

    <div class="skatepark__layout">

      <div class="skatepark__main">

        <div class="skatepark-gallery{% if using_satellite %} skatepark-gallery--satellite{% endif %}" data-skatepark-gallery>
          {%- if images != blank and images.size > 0 -%}
            {%- assign gallery_count = images.size | at_most: ss.max_images -%}
            <div class="skatepark-gallery__stage">
              <div class="swiper skatepark-gallery__swiper" data-gallery-swiper>
                <div class="swiper-wrapper">
                  {%- for img in images limit: ss.max_images -%}
                    <div class="swiper-slide skatepark-gallery__slide">
                      <img
                        src="{{ img | escape }}"
                        alt="{{ image_alt | escape }}{% if gallery_count > 1 %} – photo {{ forloop.index }}{% endif %}"
                        class="skatepark-gallery__image"
                        {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
                        decoding="async"
                        referrerpolicy="no-referrer"
                        width="1280"
                        height="960"
                      >
                    </div>
                  {%- endfor -%}
                </div>
              </div>

              {%- if gallery_count > 1 -%}
                <div class="skatepark-gallery__navigation">
                  <button
                    type="button"
                    class="swiper-slider__arrow swiper-slider__arrow--prev button--reset"
                    aria-label="Previous photo"
                  >
                    {{- 'icon-long-arrow.svg' | inline_asset_content -}}
                  </button>
                  <button
                    type="button"
                    class="swiper-slider__arrow swiper-slider__arrow--next button--reset"
                    aria-label="Next photo"
                  >
                    {{- 'icon-long-arrow.svg' | inline_asset_content -}}
                  </button>
                </div>
              {%- endif -%}

              {%- if using_satellite -%}
                <span class="skatepark-gallery__tag">Satellite view</span>
              {%- endif -%}
            </div>

            {%- if gallery_count > 1 -%}
              <div class="skatepark-gallery__pagination swiper-pagination"></div>

              <div class="skatepark-gallery__thumbs">
                {%- for img in images limit: ss.max_images -%}
                  <button type="button" class="skatepark-gallery__thumb button--reset{% if forloop.first %} is-active{% endif %}" data-gallery-thumb="{{ forloop.index0 }}" aria-label="Show photo {{ forloop.index }} of {{ gallery_count }}">
                    <img src="{{ img | escape }}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" width="160" height="120">
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if credit != blank or licence_name != blank -%}
              <p class="skatepark-gallery__credit">
                {%- if credit != blank -%}{{ credit | escape }}{%- endif -%}
                {%- if licence_name != blank -%}
                  {%- if credit != blank %} · {% endif -%}
                  {%- if licence_url != blank -%}
                    <a href="{% render 'skatepark-ref-url', url: licence_url %}" target="_blank" rel="noopener nofollow">{{ licence_name | escape }}</a>
                  {%- else -%}
                    {{ licence_name | escape }}
                  {%- endif -%}
                {%- endif -%}
              </p>
            {%- endif -%}
          {%- else -%}
            <div class="skatepark-gallery__stage skatepark-gallery__stage--placeholder">
              <img
                src="{{ placeholder_url | escape }}"
                alt="{{ park_name | escape }} – photo coming soon"
                class="skatepark-gallery__image skatepark-gallery__image--placeholder"
                fetchpriority="high"
                decoding="async"
                width="1600"
                height="1200"
              >
            </div>
          {%- endif -%}
        </div>

        {%- if ss.show_photo_form and section.blocks.size > 0 -%}
          <div class="skatepark-photo-share" data-skatepark-photo-share>
            <button
              type="button"
              class="skatepark-photo-share__toggle button--reset"
              aria-expanded="false"
              aria-controls="{{ section.id }}-photo-form"
              data-photo-share-toggle
            >
              <span>{{ ss.photo_link_text | default: 'Got an updated park photo? Share it with us.' | escape }}</span>
              <span class="skatepark-photo-share__icon" aria-hidden="true"></span>
            </button>
            <div
              class="skatepark-photo-share__panel"
              id="{{ section.id }}-photo-form"
              role="region"
              aria-label="{{ ss.photo_link_text | default: 'Share a park photo' | escape }}"
              data-photo-share-panel
              hidden
            >
              {%- for block in section.blocks -%}
                {%- case block.type -%}
                  {%- when '@app' -%}
                    {% render block %}
                {%- endcase -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

      </div>

      <div class="skatepark__content">

        <div class="skatepark__overview">
        {%- if park.description.value != blank -%}
          <div class="skatepark__description rte">
            <h2 class="skatepark__heading h5">About the park</h2>
            {%- assign paras = park.description.value | newline_to_br | split: '<br />' -%}
            {%- for para in paras -%}
              {%- assign para_text = para | strip -%}
              {%- if para_text != blank -%}<p>{{ para_text | escape }}</p>{%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- liquid
          assign chip_groups = 'features:Features|disciplines_supported:Disciplines|skill_levels:Skill levels|facilities:Facilities' | split: '|'
        -%}
        {%- for group in chip_groups -%}
          {%- assign g_key = group | split: ':' | first -%}
          {%- assign g_label = group | split: ':' | last -%}
          {%- assign g_value = park[g_key].value -%}
          {%- if g_value != blank -%}
            <div class="skatepark__chip-group">
              <h3 class="skatepark__chip-title">{{ g_label }}</h3>
              {% render 'skatepark-chips', value: g_value %}
            </div>
          {%- endif -%}
        {%- endfor -%}
        </div>

        <div class="skatepark-facts">
          <h2 class="skatepark__heading h5">Key facts</h2>
          <dl class="skatepark-facts__list">
            {%- liquid
              assign fact_keys = 'park_type:Park type|setting:Setting|entry_type:Entry|surface_material:Surface|bmx_allowed:BMX allowed|floodlit:Floodlit|rain_friendly:Rain-friendly|opening_hours:Opening hours|helmet_required:Helmet|events_suitable:Events|builder_designer:Builder / designer' | split: '|'
            -%}
            {%- for fact in fact_keys -%}
              {%- assign f_key = fact | split: ':' | first -%}
              {%- assign f_label = fact | split: ':' | last -%}
              {%- assign f_field = park[f_key] -%}
              {%- if f_key == 'rain_friendly' -%}
                {%- assign rf = f_field.value -%}
                {%- if rf == true or rf == false -%}
                  <div class="skatepark-facts__row">
                    <dt>{{ f_label }}</dt>
                    <dd>{% if rf == true %}Yes{% else %}No{% endif %}</dd>
                  </div>
                {%- endif -%}
              {%- elsif f_field.value != blank -%}
                <div class="skatepark-facts__row">
                  <dt>{{ f_label }}</dt>
                  <dd>{{ f_field.value | escape }}</dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>
        </div>

        {%- if park.website_url.value != blank or park.phone.value != blank -%}
          <div class="skatepark-contact">
            <h2 class="skatepark__heading h6">Contact</h2>
            {%- if park.website_url.value != blank -%}
              <p><a href="{% render 'skatepark-ref-url', url: park.website_url.value %}" target="_blank" rel="noopener nofollow" class="skatepark-contact__link">Park website</a></p>
            {%- endif -%}
            {%- if park.phone.value != blank -%}
              <p><a href="tel:{{ park.phone.value | remove: ' ' | escape }}" class="skatepark-contact__link">{{ park.phone.value | escape }}</a></p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if ss.show_events -%}
          {%- liquid
            capture event_keys
              render 'park-event-upcoming-keys', events: park.events.value
            endcapture
            assign event_keys = event_keys | strip | split: ',' | sort
            assign park_events = park.events.value
          -%}
          {%- if event_keys.size > 0 -%}
            <div class="skatepark-events" id="{{ section.id }}-events">
              <h2 class="skatepark__heading h5">{{ ss.events_heading | default: 'Upcoming events' | escape }}</h2>
              <ul class="park-events" role="list">
                {%- for event_key in event_keys limit: ss.events_limit -%}
                  {%- assign event_index = event_key | split: ':' | last | plus: 0 -%}
                  {%- for park_event in park_events -%}
                    {%- if forloop.index0 == event_index -%}
                      {% render 'park-event-item', event: park_event, park: park %}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- elsif ss.show_no_events -%}
            <p class="skatepark-events__empty">
              {%- if ss.no_events_link != blank -%}
                <a href="{{ ss.no_events_link }}">{{ ss.no_events_text | escape }}</a>
              {%- else -%}
                {{ ss.no_events_text | escape }}
              {%- endif -%}
            </p>
          {%- endif -%}
        {%- endif -%}

        {%- if ss.show_event_form -%}
          <div
            class="untold-parks untold-parks--event"
            data-untold-parks
            data-endpoint="/apps/parks"
            data-logged-in="{% if customer %}true{% else %}false{% endif %}"
            data-login-url="{{ routes.account_login_url }}"
            data-park-handle="{{ park.system.handle | escape }}"
          >
            {% render 'untold-park-event-form', park: park, event_types: ss.event_types %}
          </div>
        {%- endif -%}

      </div>

    </div>

    <div class="skatepark-location" id="{{ section.id }}-location">
      <h2 class="skatepark__heading h5">Location</h2>
      <div class="skatepark-location__grid">

        <div class="skatepark-location__details">
          <address class="skatepark-location__address">
            {%- if park.address_line.value != blank -%}{{ park.address_line.value | escape }}<br>{%- endif -%}
            {%- if town != blank -%}{{ town | escape }}<br>{%- endif -%}
            {%- if county != blank and county != town -%}{{ county | escape }}<br>{%- endif -%}
            {%- if park.postcode.value != blank -%}{{ park.postcode.value | escape }}<br>{%- endif -%}
            {%- if park.country.value != blank -%}{{ park.country.value | escape }}{%- endif -%}
          </address>

          <div class="skatepark-location__buttons">
            {%- liquid
              assign maps_url = park.google_maps_url.value
              if maps_url == blank and has_geo
                assign maps_url = 'https://www.google.com/maps/search/?api=1&query=' | append: lat | append: ',' | append: lng
              endif
            -%}
            {%- if maps_url != blank -%}
              <a href="{% render 'skatepark-ref-url', url: maps_url %}" class="button" target="_blank" rel="noopener nofollow">Open in Google Maps</a>
            {%- endif -%}
            {%- if w3w != blank -%}
              {%- assign w3w_url = 'https://what3words.com/' | append: w3w -%}<a href="{% render 'skatepark-ref-url', url: w3w_url %}" class="button button--outline" target="_blank" rel="noopener nofollow">///{{ w3w | escape }}</a>
            {%- endif -%}
          </div>

          {%- if park.directions_notes.value != blank -%}
            <div class="skatepark-location__directions">
              <h3 class="skatepark__chip-title">Getting there</h3>
              <p>{{ park.directions_notes.value | escape | newline_to_br }}</p>
            </div>
          {%- endif -%}
        </div>

        {%- if has_geo and ss.show_map -%}
          {%- liquid
            assign bb_w = lng | minus: 0.006
            assign bb_e = lng | plus: 0.006
            assign bb_s = lat | minus: 0.0035
            assign bb_n = lat | plus: 0.0035
          -%}
          <div class="skatepark-location__map">
            <iframe
              title="Map showing {{ park_name | escape }}"
              src="https://www.openstreetmap.org/export/embed.html?bbox={{ bb_w }}%2C{{ bb_s }}%2C{{ bb_e }}%2C{{ bb_n }}&amp;layer=mapnik&amp;marker={{ lat }}%2C{{ lng }}"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
            <p class="skatepark-location__map-credit">Map data © <a href="https://www.openstreetmap.org/copyright?source=untoldbmx" target="_blank" rel="noopener">OpenStreetMap contributors</a></p>
          </div>
        {%- endif -%}

      </div>
    </div>

    {%- if ss.show_faq and sp_faq_qs.size > 0 -%}
      <div class="skatepark-faq" id="{{ section.id }}-faq">
        <h2 class="skatepark__heading h5">{{ ss.faq_heading | default: 'FAQs' | escape }}</h2>
        <div class="page__faqs">
          {%- for sp_fq in sp_faq_qs -%}
            {%- assign sp_fa = sp_faq_as[forloop.index0] -%}
            {%- if sp_fq != blank and sp_fa != blank -%}
              <details class="page__faq">
                <summary class="page__faq-trigger">
                  <span class="page__faq-question">{{ sp_fq | escape }}</span>
                  <span class="page__faq-icon" aria-hidden="true"></span>
                </summary>
                <div class="page__faq-content rte">
                  <p>{{ sp_fa | escape }}</p>
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

{%- comment -%} Structured data {%- endcomment -%}
{%- capture sp_address -%}
  {"@type":"PostalAddress"
  {%- if park.address_line.value != blank -%},"streetAddress":{{ park.address_line.value | json }}{%- endif -%}
  {%- if town != blank -%},"addressLocality":{{ town | json }}{%- endif -%}
  {%- if county != blank -%},"addressRegion":{{ county | json }}{%- endif -%}
  {%- if park.postcode.value != blank -%},"postalCode":{{ park.postcode.value | json }}{%- endif -%}
  ,"addressCountry":"GB"}
{%- endcapture -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SportsActivityLocation",
  "name": {{ park_name | json }},
  "url": {{ canonical_url | json }}
  {%- if park.description.value != blank -%},
  "description": {{ park.description.value | strip_newlines | json }}
  {%- endif -%},
  "address": {{ sp_address }}
  {%- if has_geo -%},
  "geo": {"@type": "GeoCoordinates", "latitude": {{ lat | json }}, "longitude": {{ lng | json }}}
  {%- endif -%}
  {%- if images != blank and images.size > 0 and using_satellite == false -%},
  "image": [{%- for img in images limit: 5 -%}{{ img | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
  {%- endif -%}
  {%- if park.entry_type.value == 'Free' -%},
  "isAccessibleForFree": true
  {%- endif -%}
  {%- if park.website_url.value != blank -%},
  "sameAs": {{ park.website_url.value | json }}
  {%- endif -%}
  {%- if park.phone.value != blank -%},
  "telephone": {{ park.phone.value | json }}
  {%- endif -%}
  {%- comment -%} Amenities, access, map, area and real opening hours. No fee data. {%- endcomment -%}
  {%- capture sp_amen -%}
    {%- for f in sp_feat_parts -%}
      {%- assign f_raw = f | strip -%}
      {%- if f_raw != blank -%}{"@type":"LocationFeatureSpecification","name":{{ f_raw | json }},"value":true},{%- endif -%}
    {%- endfor -%}
    {%- for fc in sp_fac_parts -%}
      {%- assign fc_raw = fc | strip -%}
      {%- if fc_raw != blank and fc_raw != 'Public Park Access' -%}{"@type":"LocationFeatureSpecification","name":{{ fc_raw | json }},"value":true},{%- endif -%}
    {%- endfor -%}
    {%- case sp_flood -%}
      {%- when 'Yes', 'Indoor (Lit)' -%}{"@type":"LocationFeatureSpecification","name":"Floodlit","value":true},
      {%- when 'Partial / Covered' -%}{"@type":"LocationFeatureSpecification","name":"Partly floodlit","value":true},
      {%- when 'No' -%}{"@type":"LocationFeatureSpecification","name":"Floodlit","value":false},
    {%- endcase -%}
    {%- case sp_setting -%}
      {%- when 'indoor' -%}{"@type":"LocationFeatureSpecification","name":"Indoor","value":true},
      {%- when 'covered' -%}{"@type":"LocationFeatureSpecification","name":"Covered","value":true},
      {%- when 'outdoor' -%}{"@type":"LocationFeatureSpecification","name":"Indoor","value":false},
    {%- endcase -%}
    {%- if park.rain_friendly.value == true -%}{"@type":"LocationFeatureSpecification","name":"Rain-friendly","value":true},
    {%- elsif park.rain_friendly.value == false -%}{"@type":"LocationFeatureSpecification","name":"Rain-friendly","value":false},
    {%- endif -%}
  {%- endcapture -%}
  {%- assign sp_amen = sp_amen | strip | remove_last: ',' -%}
  {%- if sp_amen != blank -%},
  "amenityFeature": [{{ sp_amen }}]
  {%- endif -%}
  {%- if park.entry_type.value != blank -%},
  "publicAccess": {% if park.entry_type.value == 'Club / Members' %}false{% else %}true{% endif %}
  {%- endif -%}
  {%- if sp_maps_url != blank -%},
  "hasMap": {{ sp_maps_url | json }}
  {%- endif -%}
  {%- if region != blank -%},
  "containedInPlace": {"@type":"AdministrativeArea"
    {%- if county != blank and county != region -%},"name":{{ county | json }},"containedInPlace":{"@type":"AdministrativeArea","name":{{ region | json }}
    {%- else -%},"name":{{ region | json }}
    {%- endif -%}
    {%- if park.country.value != blank and park.country.value != region -%},"containedInPlace":{"@type":"Country","name":{{ park.country.value | json }}}{%- endif -%}
    {%- if county != blank and county != region -%}}{%- endif -%}}
  {%- endif -%}
  {%- if sp_closed == false and sp_oh_kind == 'always' -%},
  "openingHoursSpecification": [{"@type":"OpeningHoursSpecification","dayOfWeek":["https://schema.org/Monday","https://schema.org/Tuesday","https://schema.org/Wednesday","https://schema.org/Thursday","https://schema.org/Friday","https://schema.org/Saturday","https://schema.org/Sunday"],"opens":"00:00","closes":"23:59"}]
  {%- elsif sp_closed == false and sp_oh_kind == 'timetable' -%},
  "openingHoursSpecification": [
    {%- assign sp_day_names = 'Monday,Tuesday,Wednesday,Thursday,Friday,Saturday,Sunday' | split: ',' -%}
    {%- for ohp in sp_oh_parts -%}
      {%- assign ohp_tokens = ohp | strip | split: ' ' -%}
      {%- assign ohp_range = ohp_tokens[0] -%}
      {%- assign ohp_times = ohp_tokens[1] | split: '-' -%}
      {%- assign ohp_from = ohp_range | split: '-' | first -%}
      {%- assign ohp_to = ohp_range | split: '-' | last -%}
      {%- assign ohp_in = false -%}
      {%- assign ohp_days = '' -%}
      {%- for dc in sp_day_codes -%}
        {%- if dc == ohp_from -%}{%- assign ohp_in = true -%}{%- endif -%}
        {%- if ohp_in -%}
          {%- assign ohp_day = sp_day_names[forloop.index0] -%}
          {%- capture ohp_days -%}{{ ohp_days }}{% if ohp_days != '' %},{% endif %}"https://schema.org/{{ ohp_day }}"{%- endcapture -%}
        {%- endif -%}
        {%- if dc == ohp_to -%}{%- assign ohp_in = false -%}{%- endif -%}
      {%- endfor -%}
      {"@type":"OpeningHoursSpecification","dayOfWeek":[{{ ohp_days }}],"opens":{{ ohp_times | first | json }},"closes":{{ ohp_times | last | json }}}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
  {%- endif -%}
}
</script>
{%- if ss.show_faq and ss.faq_schema and sp_faq_qs.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- assign sp_faq_n = 0 -%}
    {%- for sp_fq in sp_faq_qs -%}
      {%- assign sp_fa = sp_faq_as[forloop.index0] -%}
      {%- if sp_fq != blank and sp_fa != blank -%}
        {%- if sp_faq_n > 0 -%},{%- endif -%}
        {"@type": "Question", "name": {{ sp_fq | json }}, "acceptedAnswer": {"@type": "Answer", "text": {{ sp_fa | json }}}}
        {%- assign sp_faq_n = sp_faq_n | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{%- if ss.show_events and event_keys.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {%- for event_key in event_keys limit: ss.events_limit -%}
      {%- assign event_index = event_key | split: ':' | last | plus: 0 -%}
      {%- for ld_event in park_events -%}
        {%- if forloop.index0 == event_index -%}
          {%- assign ld_url = request.origin | append: ld_event.system.url -%}
          {% render 'park-event-schema', event: ld_event, park: park, url: ld_url %}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | append: routes.root_url | json }}},
    {"@type": "ListItem", "position": 2, "name": {{ ss.index_label | default: 'Skateparks' | json }}, "item": {{ request.origin | append: index_url | json }}}
    {%- if region != blank -%},
    {"@type": "ListItem", "position": 3, "name": {{ region | json }}, "item": {{ request.origin | append: index_url | append: '?region=' | append: region_enc | json }}}
    {%- endif -%},
    {"@type": "ListItem", "position": {% if region != blank %}4{% else %}3{% endif %}, "name": {{ park_name | json }}, "item": {{ canonical_url | json }}}
  ]
}
</script>

<script>
  (() => {
    const initialiseGalleries = () => {
      if (typeof Swiper === 'undefined') {
        return;
      }

      document.querySelectorAll('[data-skatepark-gallery]').forEach((gallery) => {
        if (gallery.dataset.initialised === 'true') {
          return;
        }

        const swiperElement = gallery.querySelector('[data-gallery-swiper]');
        if (!swiperElement) {
          return;
        }

        const previousButton = gallery.querySelector('.swiper-slider__arrow--prev');
        const nextButton = gallery.querySelector('.swiper-slider__arrow--next');
        const pagination = gallery.querySelector('.skatepark-gallery__pagination');
        const thumbs = gallery.querySelectorAll('[data-gallery-thumb]');

        const syncThumbs = (swiper) => {
          thumbs.forEach((thumb, i) => thumb.classList.toggle('is-active', i === swiper.activeIndex));
          const active = thumbs[swiper.activeIndex];
          if (active && active.scrollIntoView && gallery.dataset.initialised === 'true') {
            active.parentElement.scrollTo({ left: active.offsetLeft - active.parentElement.clientWidth / 2 + active.clientWidth / 2, behavior: 'smooth' });
          }
        };

        const swiper = new Swiper(swiperElement, {
          slidesPerView: 1,
          spaceBetween: 0,
          watchOverflow: true,
          allowTouchMove: true,
          simulateTouch: true,
          grabCursor: true,
          threshold: 5,
          keyboard: { enabled: true, onlyInViewport: true },

          navigation: previousButton && nextButton
            ? {
                prevEl: previousButton,
                nextEl: nextButton
              }
            : false,

          pagination: pagination
            ? {
                el: pagination,
                clickable: true,
                bulletElement: 'button'
              }
            : false,

          a11y: {
            enabled: true,
            prevSlideMessage: 'Previous photo',
            nextSlideMessage: 'Next photo',
            paginationBulletMessage: 'Go to photo {% raw %}{{index}}{% endraw %}'
          },

          on: {
            slideChange: syncThumbs
          }
        });

        thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => swiper.slideTo(i)));

        /* Drop photos whose external URL fails to load. */
        swiperElement.querySelectorAll('.skatepark-gallery__image').forEach((img) => {
          const drop = () => {
            const slide = img.closest('.swiper-slide');
            const index = [...swiper.slides].indexOf(slide);
            if (index < 0) return;
            swiper.removeSlide(index);
            const thumb = gallery.querySelectorAll('[data-gallery-thumb]')[index];
            if (thumb) thumb.remove();
            if (swiper.slides.length === 0) gallery.classList.add('skatepark-gallery--broken');
          };
          if (img.complete && img.naturalWidth === 0) drop();
          else img.addEventListener('error', drop, { once: true });
        });

        gallery.dataset.initialised = 'true';
      });
    };

    initialiseGalleries();

    window.addEventListener('load', initialiseGalleries);
    document.addEventListener('DOMContentLoaded', initialiseGalleries);
    document.addEventListener('shopify:section:load', initialiseGalleries);
  })();
</script>

<script>
  (() => {
    document.querySelectorAll('[data-skatepark-photo-share]').forEach((wrap) => {
      if (wrap.dataset.ready === 'true') return;
      wrap.dataset.ready = 'true';
      const toggle = wrap.querySelector('[data-photo-share-toggle]');
      const panel = wrap.querySelector('[data-photo-share-panel]');
      if (!toggle || !panel) return;
      toggle.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        panel.hidden = !open;
        wrap.classList.toggle('is-open', open);
        if (open) {
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          panel.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'nearest' });
        }
      });
    });
  })();
</script>

