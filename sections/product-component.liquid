{{- 'product-slider.css' | asset_url | stylesheet_tag -}}
{%- assign ss = section.settings -%}

{%- liquid
	assign has_product_overrides = false

	for block in section.blocks
		if block.type == 'product' and block.settings.product != blank
			assign has_product_overrides = true
			break
		endif
	endfor
-%}

<section
	class="product-slider{% unless ss.enable_carousel %} product-slider--grid{% endunless %}"
	id="{{ section.id }}"
	data-product-slider
	data-carousel="{{ ss.enable_carousel }}"
	data-products-desktop="{{ ss.products_desktop }}"
	data-products-mobile="{{ ss.products_mobile }}"
>
	<div class="container">

		<div class="product-slider__header">

			{%- if ss.title != blank -%}
				<h2 class="product-slider__title h5">
					{{ ss.title }}
				</h2>
			{%- endif -%}

			<div class="product-slider__controls">

				{%- if ss.show_view_all and ss.collection != blank -%}
					<a
						href="{{ ss.collection.url }}"
						class="product-slider__view-all"
					>
						View all
					</a>
				{%- endif -%}

				{%- if ss.enable_carousel -%}
					<div class="product-slider__navigation">

						<button
							type="button"
							class="product-slider__arrow product-slider__arrow--prev button--reset"
							aria-label="Previous products"
						>
							{{- 'icon-long-arrow.svg' | inline_asset_content -}}
						</button>

						<button
							type="button"
							class="product-slider__arrow product-slider__arrow--next button--reset"
							aria-label="Next products"
						>
							{{- 'icon-long-arrow.svg' | inline_asset_content -}}
						</button>

					</div>
				{%- endif -%}

			</div>

		</div>


		<div class="{% if ss.enable_carousel %}swiper product-slider__swiper{% else %}product-slider__grid{% endif %}">

			<div class="{% if ss.enable_carousel %}swiper-wrapper{% else %}product-slider__items{% endif %}">

				{%- if has_product_overrides -%}

					{%- for block in section.blocks -%}
						{%- assign bs = block.settings -%}

						{%- if block.type == 'product' and bs.product != blank -%}

							<div
								class="product-slider__item{% if ss.enable_carousel %} swiper-slide{% endif %}"
								{{ block.shopify_attributes }}
							>
								{% render 'product-card', product: bs.product %}
							</div>

						{%- endif -%}

					{%- endfor -%}


				{%- elsif ss.collection != blank -%}

					{%- for product in ss.collection.products limit: ss.product_limit -%}

						<div class="product-slider__item{% if ss.enable_carousel %} swiper-slide{% endif %}">
							{% render 'product-card', product: product %}
						</div>

					{%- endfor -%}

				{%- endif -%}

			</div>


			{%- if ss.enable_carousel -%}

				<div
					class="product-slider__pagination swiper-pagination"
				></div>

			{%- endif -%}

		</div>

	</div>
</section>


{%- style -%}

	#{{ section.id }} {
		padding-top: {{ ss.padding-top }}px;
		padding-bottom: {{ ss.padding-bottom }}px;

		--products-desktop: {{ ss.products_desktop }};
		--products-mobile: {{ ss.products_mobile }};
	}

	@media screen and (max-width: 750px) {

		#{{ section.id }} {
			padding-top: {{ ss.padding-top-m }}px;
			padding-bottom: {{ ss.padding-bottom-m }}px;
		}

	}

{%- endstyle -%}


{% javascript %}

	(() => {

		const initialiseProductSliders = () => {

			if (typeof Swiper === 'undefined') {
				return;
			}


			document
				.querySelectorAll('[data-product-slider]')
				.forEach((section) => {

					if (
						section.dataset.carousel !== 'true' ||
						section.dataset.initialised === 'true'
					) {
						return;
					}


					const swiperElement = section.querySelector(
						'.product-slider__swiper'
					);

					if (!swiperElement) {
						return;
					}


					const productsDesktop =
						parseInt(
							section.dataset.productsDesktop,
							10
						) || 5;

					const productsMobile =
						parseInt(
							section.dataset.productsMobile,
							10
						) || 2;


					const previousButton = section.querySelector(
						'.product-slider__arrow--prev'
					);

					const nextButton = section.querySelector(
						'.product-slider__arrow--next'
					);

					const pagination = section.querySelector(
						'.product-slider__pagination'
					);


					new Swiper(swiperElement, {

						slidesPerView: productsMobile,

						spaceBetween: 10,

						watchOverflow: true,

						navigation: previousButton && nextButton
							? {
								prevEl: previousButton,
								nextEl: nextButton
							}
							: false,

						pagination: pagination
							? {
								el: pagination,
								clickable: true,
								bulletElement: 'button'
							}
							: false,

						breakpoints: {

							751: {
								slidesPerView: productsDesktop
							}

						},

						a11y: {
							enabled: true,
							prevSlideMessage: 'Previous products',
							nextSlideMessage: 'Next products',
							paginationBulletMessage: 'Go to product group {{index}}'
						}

					});


					section.dataset.initialised = 'true';

				});

		};


		initialiseProductSliders();


		window.addEventListener(
			'load',
			initialiseProductSliders
		);


		document.addEventListener(
			'shopify:section:load',
			initialiseProductSliders
		);

	})();

{% endjavascript %}


{% schema %}
{
	"name": "Product slider",
	"tag": "section",
	"class": "product-slider-section",
	"settings": [
		{
			"type": "text",
			"id": "title",
			"label": "Title",
			"default": "Best sellers"
		},
		{
			"type": "collection",
			"id": "collection",
			"label": "Collection",
			"info": "Products added as blocks will override products from this collection."
		},
		{
			"type": "range",
			"id": "product_limit",
			"min": 1,
			"max": 50,
			"step": 1,
			"label": "Maximum collection products",
			"default": 20,
			"info": "Only applies when using the collection above."
		},
		{
			"type": "checkbox",
			"id": "show_view_all",
			"default": true,
			"label": "Show view all"
		},
		{
			"type": "checkbox",
			"id": "enable_carousel",
			"default": true,
			"label": "Enable carousel"
		},
		{
			"type": "range",
			"id": "products_desktop",
			"min": 2,
			"max": 6,
			"step": 1,
			"label": "Products shown on desktop",
			"default": 5
		},
		{
			"type": "range",
			"id": "products_mobile",
			"min": 1,
			"max": 3,
			"step": 1,
			"label": "Products shown on mobile",
			"default": 2
		},
		{
			"type": "header",
			"content": "Padding (desktop)"
		},
		{
			"type": "range",
			"id": "padding-top",
			"min": 0,
			"max": 300,
			"step": 5,
			"label": "Padding top",
			"default": 40
		},
		{
			"type": "range",
			"id": "padding-bottom",
			"min": 0,
			"max": 300,
			"step": 5,
			"label": "Padding bottom",
			"default": 40
		},
		{
			"type": "header",
			"content": "Padding (mobile)"
		},
		{
			"type": "range",
			"id": "padding-top-m",
			"min": 0,
			"max": 300,
			"step": 5,
			"label": "Padding top",
			"default": 30
		},
		{
			"type": "range",
			"id": "padding-bottom-m",
			"min": 0,
			"max": 300,
			"step": 5,
			"label": "Padding bottom",
			"default": 30
		}
	],
	"blocks": [
		{
			"type": "product",
			"name": "Product",
			"settings": [
				{
					"type": "product",
					"id": "product",
					"label": "Product"
				}
			]
		}
	],
	"max_blocks": 12,
	"presets": [
		{
			"name": "Product slider"
		}
	]
}
{% endschema %}