<div class="cart-page-redirect">
	<noscript>
		<p>Your cart is available from the cart drawer.</p>
		<a href="{{ routes.root_url }}">Return to the homepage</a>
	</noscript>
</div>

<script>
	(() => {
		try {
			sessionStorage.setItem('open-cart-drawer', 'true');
		} catch (error) {
			console.error(error);
		}

		window.location.replace({{ routes.root_url | json }});
	})();
</script>

{% schema %}
{
	"name": "Cart redirect",
	"settings": []
}
{% endschema %}
