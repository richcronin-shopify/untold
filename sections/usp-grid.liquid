{{- 'usp-grid.css' | asset_url | stylesheet_tag -}}

<section class="usp-bar" id="{{ section.id }}">
	<div class="container">
		<div class="usp-bar__items">

			{%- for block in section.blocks -%}
				{%- assign bs = block.settings -%}

				<div class="usp-bar__item" {{ block.shopify_attributes }}>
					
					<{% if bs.url != blank %}a href="{{ bs.url }}"{% else %}div{% endif %} class="usp-bar__link">
					

						{%- if bs.image != blank -%}
							<div class="usp-bar__icon">
								{{
									bs.image
									| image_url: width: 120
									| image_tag:
										loading: 'lazy',
										widths: '40, 60, 80, 120',
										sizes: '60px',
										alt: bs.image.alt
								}}
							</div>
						{%- endif -%}

						<div class="usp-bar__content">
							{%- if bs.title != blank -%}
								<p class="usp-bar__title h6">{{ bs.title }}</p>
							{%- endif -%}

							{%- if bs.description != blank -%}
								<div class="usp-bar__description">
									{{ bs.description }}
								</div>
							{%- endif -%}
						</div>

					</{% if bs.url != blank %}a{% else %}div{% endif %}>
				</div>

				{%- unless forloop.last -%}
					<span class="usp-bar__divider"></span>
				{%- endunless -%}

			{%- endfor -%}

		</div>
	</div>
</section>

{%- style -%}

	#{{section.id}} {
		padding-top: {{ss.padding-top}}px;
		padding-bottom: {{ss.padding-bottom}}px;
	}

	#{{section.id}} .blocks {
		gap: {{ss.block-gap}}px;
	}

	@media screen and (max-width: 750px) {

		#{{section.id}} {
			padding-top: {{ss.padding-top-m}}px;
			padding-bottom: {{ss.padding-bottom-m}}px;
		}

	}

{%- endstyle -%}

{% schema %}
{
	"name": "USP bar",
	"tag": "section",
	"class": "usp-bar-section",
	"settings": [
		{
            "type": "header",
            "content": "Padding (desktop)"
        },
		{
            "type": "range",
            "id": "padding-top",
            "min": 0,
            "max": 300,
            "step": 5,
            "label": "Padding top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding-bottom",
            "min": 0,
            "max": 300,
            "step": 5,
            "label": "Padding bottom",
            "default": 0
        },
        {
            "type": "header",
            "content": "Padding (mobile)"
        },
		{
            "type": "range",
            "id": "padding-top-m",
            "min": 0,
            "max": 300,
            "step": 5,
            "label": "Padding top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding-bottom-m",
            "min": 0,
            "max": 300,
            "step": 5,
            "label": "Padding bottom-m",
            "default": 0
        }
	],
	"blocks": [
		{
			"type": "usp",
			"name": "USP",
			"settings": [
				{
					"type": "image_picker",
					"id": "image",
					"label": "Image"
				},
				{
					"type": "text",
					"id": "title",
					"label": "Title",
					"default": "Rider owned"
				},
				{
					"type": "inline_richtext",
					"id": "description",
					"label": "Description",
					"default": "Real riders. Real service."
				},
				{
					"type": "url",
					"id": "url",
					"label": "Link"
				}
			]
		}
	],
	"max_blocks": 6,
	"presets": [
		{
			"name": "USP bar",
			"blocks": [
				{ "type": "usp" },
				{ "type": "usp" },
				{ "type": "usp" },
				{ "type": "usp" }
			]
		}
	]
}
{% endschema %}